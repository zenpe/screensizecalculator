---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import { siteConfig } from '../site.config';

interface Props {
  title: string;
  description: string;
  pubDate: string;
  updatedDate?: string;
  author?: string;
  category?: string;
  readingTime?: number;
  keywords?: string;
}

const { title, description, pubDate, updatedDate, author = "Screen Size Calculator Team", category = "Guide", readingTime, keywords: customKeywords } = Astro.props;
const formattedDate = new Date(pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
const formattedUpdatedDate = updatedDate ? new Date(updatedDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}) : null;

const estimatedReadingTime = readingTime || 5;

const keywords = customKeywords || (() => {
  const categoryKeywords: Record<string, string> = {
    'TV': 'tv guide, television buying guide, tv size guide, best tv size',
    'Monitor': 'monitor guide, display guide, monitor buying tips, best monitor size',
    'Phone': 'phone guide, smartphone guide, phone buying tips, best phone size',
    'Projector': 'projector guide, projector buying guide, home theater guide',
    'Guide': 'screen size guide, display guide, buying guide'
  };
  const baseKeywords = categoryKeywords[category || 'Guide'] || categoryKeywords['Guide'];
  return `${title.toLowerCase()}, ${baseKeywords}, screen size calculator, display comparison`;
})();

const slug = Astro.params.slug || '';

const articleData = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "datePublished": pubDate,
  ...(updatedDate && { "dateModified": updatedDate }),
  "author": {
    "@type": "Organization",
    "name": author
  },
  "publisher": {
    "@type": "Organization",
    "name": "Screen Size Calculator",
    "logo": {
      "@type": "ImageObject",
      "url": `${siteConfig.siteUrl}/logo.png`
    }
  }
};

// Breadcrumb Schema for SEO
const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteConfig.siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": `${siteConfig.siteUrl}/blog`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": title,
      "item": `${siteConfig.siteUrl}/blog/${slug}`
    }
  ]
};
---

<Layout title={title} description={description} keywords={keywords}>
  <Header />

  <!-- Reading Progress Bar -->
  <div id="reading-progress" class="fixed top-14 left-0 h-0.5 bg-primary-500 z-40 transition-all duration-100 pointer-events-none" style="width: 0%"></div>

  <main class="flex-1">
    <article class="relative">
      <!-- Hero Section -->
      <header class="pt-6 pb-8 sm:pt-8 sm:pb-12 lg:pt-12 lg:pb-16">
        <div class="max-w-3xl mx-auto px-4 sm:px-6">
          <!-- Breadcrumb -->
          <nav class="mb-4 sm:mb-6 text-sm overflow-x-auto" aria-label="Breadcrumb">
            <ol class="flex items-center gap-2 text-gray-500 dark:text-gray-400 whitespace-nowrap">
              <li>
                <a href="/" class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors">Home</a>
              </li>
              <li class="text-gray-400" aria-hidden="true">/</li>
              <li>
                <a href="/blog" class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors">Blog</a>
              </li>
              <li class="text-gray-400" aria-hidden="true">/</li>
              <li class="text-gray-700 dark:text-gray-300 truncate max-w-[150px] sm:max-w-none">{category}</li>
            </ol>
          </nav>

          <!-- Category Tag -->
          <div class="mb-4 text-center">
            <span class="inline-block px-3 py-1 bg-primary-100 text-primary-700 dark:bg-primary-900/40 dark:text-primary-300 rounded-full text-sm font-medium">
              {category}
            </span>
          </div>

          <!-- Title -->
          <h1 class="text-2xl sm:text-3xl lg:text-4xl xl:text-5xl font-bold text-gray-900 dark:text-white leading-tight mb-4 sm:mb-6 text-center">
            {title}
          </h1>

          <!-- Meta -->
          <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-sm text-gray-500 dark:text-gray-400">
            <time datetime={pubDate}>{formattedDate}</time>
            {formattedUpdatedDate && (
              <>
                <span class="text-gray-300 dark:text-gray-600 hidden sm:inline">·</span>
                <span title="Last updated" class="hidden sm:inline">Updated {formattedUpdatedDate}</span>
              </>
            )}
            <span class="text-gray-300 dark:text-gray-600">·</span>
            <span>{estimatedReadingTime} min read</span>
          </div>
        </div>
      </header>

      <!-- Article Content -->
      <div class="pb-8 sm:pb-12 lg:pb-16">
        <div class="max-w-3xl mx-auto px-4 sm:px-6">
          <div class="prose prose-lg max-w-none" id="article-content">
            <slot />
          </div>
        </div>
      </div>

      <!-- Share Section -->
      <div class="border-t border-gray-200 dark:border-gray-800">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
          <div class="flex items-center justify-between">
            <span class="text-sm text-gray-500 dark:text-gray-400">Share this article</span>
            <div class="flex gap-2">
              <a
                href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(`${siteConfig.siteUrl}/blog/${slug}`)}&text=${encodeURIComponent(title)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center w-10 h-10 bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 rounded-full hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
                aria-label="Share on Twitter"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
              <a
                href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(`${siteConfig.siteUrl}/blog/${slug}`)}&title=${encodeURIComponent(title)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center w-10 h-10 bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 rounded-full hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
                aria-label="Share on LinkedIn"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
              <button
                type="button"
                id="copy-link"
                class="flex items-center justify-center w-10 h-10 bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 rounded-full hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
                aria-label="Copy link to clipboard"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Article Footer -->
      <div class="border-t border-gray-200 dark:border-gray-800">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 py-8 lg:py-12">
          <slot name="footer" />
        </div>
      </div>
    </article>
  </main>

  <!-- Floating TOC Button -->
  <div id="toc-container" class="fixed left-3 sm:left-4 bottom-20 z-40">
    <button
      type="button"
      id="toc-toggle"
      class="w-11 h-11 sm:w-12 sm:h-12 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 rounded-full shadow-lg border border-gray-200 dark:border-gray-700 flex items-center justify-center hover:bg-gray-50 dark:hover:bg-gray-700 transition-all opacity-0 invisible"
      aria-label="Toggle table of contents"
      aria-expanded="false"
      aria-controls="toc-panel"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
      </svg>
    </button>

    <!-- TOC Panel -->
    <div
      id="toc-panel"
      role="dialog"
      aria-label="Table of contents"
      class="absolute left-0 bottom-14 sm:bottom-16 w-[calc(100vw-24px)] sm:w-72 max-w-[280px] sm:max-w-none max-h-[60vh] bg-white dark:bg-gray-800 rounded-xl shadow-xl border border-gray-200 dark:border-gray-700 overflow-hidden opacity-0 invisible translate-y-2 transition-all duration-200"
    >
      <div class="p-3 sm:p-4 border-b border-gray-100 dark:border-gray-700 flex items-center justify-between">
        <h2 class="text-sm font-semibold text-gray-900 dark:text-white">On This Page</h2>
        <button
          type="button"
          id="toc-close"
          class="p-1 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition-colors"
          aria-label="Close table of contents"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <nav class="p-3 sm:p-4 overflow-y-auto max-h-[calc(60vh-56px)]" aria-label="Table of contents navigation">
        <ul id="toc-list" class="space-y-1 text-sm"></ul>
      </nav>
    </div>
  </div>

  <!-- Back to Top Button -->
  <button
    type="button"
    id="back-to-top"
    class="fixed bottom-6 right-3 sm:right-6 w-11 h-11 sm:w-12 sm:h-12 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 rounded-full shadow-lg border border-gray-200 dark:border-gray-700 opacity-0 invisible transition-all duration-200 flex items-center justify-center z-40 hover:bg-gray-50 dark:hover:bg-gray-700"
    aria-label="Back to top"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
    </svg>
  </button>

  <script type="application/ld+json" set:html={JSON.stringify(articleData)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
</Layout>

<script>
  function initBlogPost() {
    const progressBar = document.getElementById('reading-progress');
    const backToTop = document.getElementById('back-to-top');
    const article = document.querySelector('article');
    const tocList = document.getElementById('toc-list');
    const articleContent = document.getElementById('article-content');
    const copyLinkBtn = document.getElementById('copy-link');
    const tocToggle = document.getElementById('toc-toggle');
    const tocPanel = document.getElementById('toc-panel');
    const tocClose = document.getElementById('toc-close');
    const tocContainer = document.getElementById('toc-container');

    if (!progressBar || !article) return;

    // Generate TOC
    if (tocList && articleContent) {
      const headings = articleContent.querySelectorAll('h2, h3');

      if (headings.length === 0) {
        // Hide TOC button if no headings
        if (tocContainer) {
          tocContainer.style.display = 'none';
        }
      } else {
        headings.forEach((heading, index) => {
          if (!heading.id) {
            heading.id = `heading-${index}`;
          }

          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = `#${heading.id}`;
          a.textContent = heading.textContent || '';

          const isH3 = heading.tagName === 'H3';
          a.className = `block py-1.5 rounded-md px-2 transition-colors truncate ${isH3 ? 'pl-4 text-gray-500 dark:text-gray-400 text-xs' : 'text-gray-700 dark:text-gray-300'}`;
          a.className += ' hover:bg-gray-100 dark:hover:bg-gray-700';
          a.dataset.tocId = heading.id;

          a.addEventListener('click', (e) => {
            e.preventDefault();
            const target = document.getElementById(heading.id);
            if (target) {
              target.scrollIntoView({ behavior: 'smooth' });
              closeToc();
            }
          });

          li.appendChild(a);
          tocList.appendChild(li);
        });

        // Highlight current section
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const id = entry.target.id;
              tocList.querySelectorAll('a').forEach(a => {
                a.classList.remove('bg-primary-50', 'text-primary-700', 'font-medium');
              });
              const activeLink = tocList.querySelector(`a[data-toc-id="${id}"]`);
              if (activeLink) {
                activeLink.classList.add('bg-primary-50', 'text-primary-700', 'font-medium');
              }
            }
          });
        }, { rootMargin: '-80px 0px -70% 0px', threshold: 0 });

        headings.forEach(heading => observer.observe(heading));
      }
    }

    // TOC Toggle functions
    function openToc() {
      if (!tocPanel || !tocToggle) return;
      tocPanel.classList.remove('opacity-0', 'invisible', 'translate-y-2');
      tocPanel.classList.add('opacity-100', 'visible', 'translate-y-0');
      tocToggle.setAttribute('aria-expanded', 'true');
    }

    function closeToc() {
      if (!tocPanel || !tocToggle) return;
      tocPanel.classList.add('opacity-0', 'invisible', 'translate-y-2');
      tocPanel.classList.remove('opacity-100', 'visible', 'translate-y-0');
      tocToggle.setAttribute('aria-expanded', 'false');
    }

    function toggleToc() {
      if (!tocPanel) return;
      const isOpen = tocPanel.classList.contains('opacity-100');
      if (isOpen) {
        closeToc();
      } else {
        openToc();
      }
    }

    tocToggle?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleToc();
    });

    tocClose?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeToc();
    });

    // Close TOC when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (tocContainer && !tocContainer.contains(target)) {
        closeToc();
      }
    });

    // Close TOC on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeToc();
      }
    });

    // Copy link functionality
    if (copyLinkBtn) {
      copyLinkBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          const originalHTML = copyLinkBtn.innerHTML;
          copyLinkBtn.innerHTML = '<svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>';
          setTimeout(() => {
            copyLinkBtn.innerHTML = originalHTML;
          }, 2000);
        } catch (err) {
          // Fallback for older browsers
          const textArea = document.createElement('textarea');
          textArea.value = window.location.href;
          textArea.style.position = 'fixed';
          textArea.style.left = '-9999px';
          document.body.appendChild(textArea);
          textArea.select();
          try {
            document.execCommand('copy');
            const originalHTML = copyLinkBtn.innerHTML;
            copyLinkBtn.innerHTML = '<svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>';
            setTimeout(() => {
              copyLinkBtn.innerHTML = originalHTML;
            }, 2000);
          } catch (e) {
            console.error('Failed to copy:', e);
          }
          document.body.removeChild(textArea);
        }
      });
    }

    // Progress bar and scroll-based UI
    let ticking = false;

    function updateProgress() {
      const articleRect = article.getBoundingClientRect();
      const articleTop = articleRect.top + window.scrollY;
      const articleHeight = articleRect.height;
      const windowHeight = window.innerHeight;
      const scrollY = window.scrollY;

      const start = articleTop;
      const end = articleTop + articleHeight - windowHeight;
      let progress = 0;

      if (end > start) {
        if (scrollY >= start && scrollY <= end) {
          progress = ((scrollY - start) / (end - start)) * 100;
        } else if (scrollY > end) {
          progress = 100;
        }
      }

      progressBar.style.width = `${Math.min(100, Math.max(0, progress))}%`;

      // Show/hide floating buttons
      const showButtons = scrollY > 300;

      if (showButtons) {
        backToTop?.classList.remove('opacity-0', 'invisible');
        backToTop?.classList.add('opacity-100', 'visible');
        tocToggle?.classList.remove('opacity-0', 'invisible');
        tocToggle?.classList.add('opacity-100', 'visible');
      } else {
        backToTop?.classList.add('opacity-0', 'invisible');
        backToTop?.classList.remove('opacity-100', 'visible');
        tocToggle?.classList.add('opacity-0', 'invisible');
        tocToggle?.classList.remove('opacity-100', 'visible');
        closeToc();
      }

      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(updateProgress);
        ticking = true;
      }
    }

    backToTop?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    window.addEventListener('scroll', onScroll, { passive: true });
    updateProgress();

    // Keyboard shortcut for TOC (only when not in input)
    document.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement;
      const isInputField = target.tagName === 'INPUT' ||
                          target.tagName === 'TEXTAREA' ||
                          target.isContentEditable;

      if (e.key === 't' && !e.ctrlKey && !e.metaKey && !e.altKey && !isInputField) {
        e.preventDefault();
        toggleToc();
      }
    });
  }

  // Initialize on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBlogPost);
  } else {
    initBlogPost();
  }

  // Re-initialize on Astro page transitions (View Transitions API)
  document.addEventListener('astro:page-load', initBlogPost);
</script>
