---
import '../styles/global.css';
import { siteConfig } from '../site.config';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  keywords?: string;
  noindex?: boolean;
  modifiedTime?: string; // ISO 8601 date for SEO freshness signal
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-image.png',
  keywords = 'screen size calculator, tv size calculator, monitor dimensions, ppi calculator, aspect ratio calculator, viewing distance calculator, projector throw distance, 4k tv size, phone screen size, iphone screen size, android screen size',
  noindex = false,
  modifiedTime
} = Astro.props;

// Generate the canonical URL without .html extension
let canonicalUrl = canonical || Astro.url.href;
const siteUrl = siteConfig.siteUrl;

// Handle .html extension removal
if (canonicalUrl.endsWith('.html')) {
  canonicalUrl = canonicalUrl.replace(/\.html$/, '');
}

// Handle index.html removal for homepage
if (canonicalUrl.endsWith('/index')) {
  canonicalUrl = canonicalUrl.replace(/\/index$/, '/');
} else if (canonicalUrl.endsWith('/index.html')) {
  canonicalUrl = canonicalUrl.replace(/\/index\.html$/, '/');
}

// Ensure it's a full URL
if (!canonicalUrl.startsWith('http')) {
  canonicalUrl = siteUrl + canonicalUrl;
}

// Remove trailing slash from all URLs, including homepage
if (canonicalUrl.endsWith('/')) {
  canonicalUrl = canonicalUrl.slice(0, -1);
}

import Footer from '../components/Footer.astro';

const gaId = import.meta.env.PUBLIC_GA_ID;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={siteUrl + ogImage} />
    <meta property="og:site_name" content="Screen Size Calculator" />
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={siteUrl + ogImage} />

    <!-- Preconnect and Preload for Performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" as="style" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col bg-gray-50 text-gray-900 dark:bg-gray-900 dark:text-gray-100 pt-16">
    <Header />
    <slot />
    <Footer />

    <!-- AdSense - 延迟加载以优化性能 -->
    <script is:inline>
      (function() {
        function loadAdsense() {
          if (window.adsbygoogleLoaded) return;
          window.adsbygoogleLoaded = true;

          var s = document.createElement('script');
          s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4484512625974431';
          s.crossOrigin = 'anonymous';
          s.async = true;
          document.head.appendChild(s);
        }

        ['scroll', 'mousemove', 'touchstart', 'keydown'].forEach(function(e) {
          window.addEventListener(e, loadAdsense, { once: true, passive: true });
        });

        setTimeout(loadAdsense, 3000);
      })();
    </script>
  </body>
</html>
