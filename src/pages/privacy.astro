---
import Layout from '../layouts/Layout.astro';

const title = 'Privacy Policy - calc.screensize.net';
const description = 'Privacy policy for calc.screensize.net. Learn how we collect, use, and protect your information when using our free screen calculators.';
const keywords = 'privacy policy, data protection, cookies policy, google analytics, screen calculator privacy';
---

<Layout title={title} description={description} keywords={keywords} noindex={true}>

  <main class="flex-1">
    <!-- Hero Section -->
    <section class="bg-gradient-to-b from-gray-50 to-white dark:from-gray-800/20 dark:to-gray-900 py-12 lg:py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-gray-100 mb-4 text-center">
          Privacy Policy
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-300 max-w-3xl mx-auto mb-6 text-center">
          Last updated: December 8, 2025
        </p>
      </div>
    </section>

    <!-- Privacy Policy Content -->
    <section class="py-12 lg:py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm p-8 border border-gray-100 dark:border-gray-700">

          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6">Introduction</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            calc.screensize.net ("we", "us", or "our") provides free online screen size calculators and comparison tools.
            This Privacy Policy explains how we collect, use, and protect information when you use our website.
          </p>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            <strong>The short version:</strong> We don't require registration, we don't collect personal information,
            and all calculations happen in your browser. We only use Google Analytics to understand how our tools are used.
          </p>

          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 mt-8">Information We Collect</h2>

          <h3 class="text-xl font-bold text-gray-800 dark:text-gray-200 mb-4">What We Don't Collect</h3>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            Our calculators are designed with privacy in mind:
          </p>
          <ul class="list-disc pl-6 text-gray-600 dark:text-gray-400 mb-6 space-y-2">
            <li>No account registration required</li>
            <li>No personal information collected (name, email, phone, etc.)</li>
            <li>No calculation data stored on our servers</li>
            <li>All calculations performed locally in your browser</li>
          </ul>

          <h3 class="text-xl font-bold text-gray-800 dark:text-gray-200 mb-4">What We Do Collect (via Google Analytics)</h3>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            We use Google Analytics to understand how visitors use our website. This service collects:
          </p>
          <ul class="list-disc pl-6 text-gray-600 dark:text-gray-400 mb-6 space-y-2">
            <li>Pages visited and time spent on each page</li>
            <li>Device type (desktop, mobile, tablet)</li>
            <li>Browser type and version</li>
            <li>Geographic region (country/city level, not precise location)</li>
            <li>Referral source (how you found our site)</li>
            <li>Anonymous usage patterns</li>
          </ul>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            This information is aggregated and anonymized. We cannot identify individual users from this data.
          </p>

          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 mt-8">How We Use Information</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            We use Google Analytics data solely to:
          </p>
          <ul class="list-disc pl-6 text-gray-600 dark:text-gray-400 mb-6 space-y-2">
            <li>Understand which calculators and features are most useful</li>
            <li>Identify and fix technical issues</li>
            <li>Improve user experience and site performance</li>
            <li>Make informed decisions about new features</li>
          </ul>

          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 mt-8">Cookies</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            Our website uses cookies for the following purposes:
          </p>
          <ul class="list-disc pl-6 text-gray-600 dark:text-gray-400 mb-6 space-y-2">
            <li><strong>Google Analytics cookies:</strong> Track anonymous usage statistics (_ga, _gid, _gat)</li>
            <li><strong>Preference cookies:</strong> Remember your settings like dark/light mode</li>
          </ul>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            You can disable cookies in your browser settings. The calculators will still work, but we won't be able to improve the site based on usage patterns.
          </p>

          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 mt-8">Google Analytics</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            We use Google Analytics 4, a web analytics service provided by Google LLC. Google Analytics uses cookies to analyze website usage.
          </p>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            Key points about our Google Analytics implementation:
          </p>
          <ul class="list-disc pl-6 text-gray-600 dark:text-gray-400 mb-6 space-y-2">
            <li>IP addresses are anonymized</li>
            <li>No personally identifiable information is collected</li>
            <li>Data is used only for aggregate analysis</li>
            <li>We do not share Google Analytics data with third parties</li>
          </ul>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            You can opt out of Google Analytics by installing the
            <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer" class="text-primary-600 dark:text-primary-400 hover:underline">Google Analytics Opt-out Browser Add-on</a>.
          </p>

          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 mt-8">Third-Party Services</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            Our website may include:
          </p>
          <ul class="list-disc pl-6 text-gray-600 dark:text-gray-400 mb-6 space-y-2">
            <li><strong>Google Analytics:</strong> For usage analytics (as described above)</li>
            <li><strong>External links:</strong> Links to manufacturer websites or other resources</li>
          </ul>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            We are not responsible for the privacy practices of external websites. Please review their privacy policies before providing any personal information.
          </p>

          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 mt-8">Data Security</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            Since we don't collect personal information, there's minimal data security risk. Our website is served over HTTPS
            to ensure secure communication between your browser and our servers.
          </p>

          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 mt-8">Children's Privacy</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            Our calculators are general-purpose tools suitable for all ages. We do not knowingly collect any personal
            information from children or adults. Since no registration or personal information is required to use our
            services, this concern is minimal.
          </p>

          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 mt-8">Your Rights</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            Since we don't collect personal information, most data protection rights (access, correction, deletion)
            don't apply. However, you have the right to:
          </p>
          <ul class="list-disc pl-6 text-gray-600 dark:text-gray-400 mb-6 space-y-2">
            <li>Disable cookies in your browser</li>
            <li>Opt out of Google Analytics tracking</li>
            <li>Contact us with any privacy concerns</li>
          </ul>

          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 mt-8">Changes to This Policy</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            We may update this Privacy Policy from time to time. Changes will be posted on this page with an updated
            "Last updated" date. We encourage you to review this page periodically.
          </p>

          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 mt-8">Contact Us</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            If you have any questions about this Privacy Policy or our practices, please contact us at:
          </p>
          <div class="bg-gray-50 dark:bg-gray-700 p-6 rounded-lg border border-gray-200 dark:border-gray-600">
            <p class="text-gray-600 dark:text-gray-300">
              <strong>Email:</strong> privacy@screensizecalculators.com
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
