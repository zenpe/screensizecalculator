            </thead>
            <tbody class="divide-y divide-gray-200">
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 font-medium text-gray-900">Ultra Short Throw</td>
                <td class="px-6 py-4 text-gray-700">0.25 - 0.5</td>
                <td class="px-6 py-4 text-gray-600">8" - 20"</td>
                <td class="px-6 py-4 text-sm text-gray-600">Small rooms, living rooms</td>
              </tr>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 font-medium text-gray-900">Short Throw</td>
                <td class="px-6 py-4 text-gray-700">0.5 - 1.2</td>
                <td class="px-6 py-4 text-gray-600">3' - 8'</td>
                <td class="px-6 py-4 text-sm text-gray-600">Apartments, medium rooms</td>
              </tr>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 font-medium text-gray-900">Standard Throw</td>
                <td class="px-6 py-4 text-gray-700">1.2 - 2.0</td>
                <td class="px-6 py-4 text-gray-600">8' - 16'</td>
                <td class="px-6 py-4 text-sm text-gray-600">Home theaters, large rooms</td>
              </tr>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 font-medium text-gray-900">Long Throw</td>
                <td class="px-6 py-4 text-gray-700">2.0 - 5.0+</td>
                <td class="px-6 py-4 text-gray-600">16' - 40'+</td>
                <td class="px-6 py-4 text-sm text-gray-600">Auditoriums, large venues</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Quick Reference Table -->
    <section class="py-12 lg:py-16 bg-gray-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-8 text-center">
          Throw Distance Quick Reference
        </h2>
        <div class="overflow-x-auto">
          <table class="w-full bg-white rounded-xl shadow-sm overflow-hidden">
            <thead class="bg-gray-100">
              <tr>
                <th class="px-6 py-4 text-left font-semibold text-gray-900">Screen Size</th>
                <th class="px-6 py-4 text-left font-semibold text-gray-900">Ultra Short (0.4)</th>
                <th class="px-6 py-4 text-left font-semibold text-gray-900">Short (0.8)</th>
                <th class="px-6 py-4 text-left font-semibold text-gray-900">Standard (1.5)</th>
                <th class="px-6 py-4 text-left font-semibold text-gray-900">Long (2.0)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 font-medium text-gray-900">80" (70" wide)</td>
                <td class="px-6 py-4 text-gray-700">2.3 ft</td>
                <td class="px-6 py-4 text-gray-700">4.7 ft</td>
                <td class="px-6 py-4 text-gray-700">8.8 ft</td>
                <td class="px-6 py-4 text-gray-700">11.7 ft</td>
              </tr>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 font-medium text-gray-900">100" (87" wide)</td>
                <td class="px-6 py-4 text-gray-700">2.9 ft</td>
                <td class="px-6 py-4 text-gray-700">5.8 ft</td>
                <td class="px-6 py-4 text-gray-700">10.9 ft</td>
                <td class="px-6 py-4 text-gray-700">14.5 ft</td>
              </tr>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 font-medium text-gray-900">120" (105" wide)</td>
                <td class="px-6 py-4 text-gray-700">3.5 ft</td>
                <td class="px-6 py-4 text-gray-700">7.0 ft</td>
                <td class="px-6 py-4 text-gray-700">13.1 ft</td>
                <td class="px-6 py-4 text-gray-700">17.5 ft</td>
              </tr>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 font-medium text-gray-900">150" (131" wide)</td>
                <td class="px-6 py-4 text-gray-700">4.4 ft</td>
                <td class="px-6 py-4 text-gray-700">8.7 ft</td>
                <td class="px-6 py-4 text-gray-700">16.4 ft</td>
                <td class="px-6 py-4 text-gray-700">21.8 ft</td>
              </tr>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 font-medium text-gray-900">200" (174" wide)</td>
                <td class="px-6 py-4 text-gray-700">5.8 ft</td>
                <td class="px-6 py-4 text-gray-700">11.6 ft</td>
                <td class="px-6 py-4 text-gray-700">21.8 ft</td>
                <td class="px-6 py-4 text-gray-700">29.0 ft</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-12 lg:py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-8 text-center">
          Frequently Asked Questions
        </h2>
        <div class="space-y-4">
          <details class="bg-white rounded-lg shadow-sm overflow-hidden group">
            <summary class="px-6 py-4 cursor-pointer font-semibold text-gray-900 flex justify-between items-center hover:bg-gray-50">
              How do I calculate projector throw distance?
              <svg class="w-5 h-5 text-gray-400 transform group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="px-6 pb-4 text-gray-700">
              <p class="mb-3">Use the formula: <strong>Throw Distance = Screen Width × Throw Ratio</strong></p>
              <p class="mb-3">For example, a 100-inch diagonal 16:9 screen (87 inches wide) with a 1.5 throw ratio projector needs:</p>
              <p class="font-mono bg-gray-100 p-2 rounded">87 × 1.5 = 130.5 inches (10.9 feet)</p>
            </div>
          </details>

          <details class="bg-white rounded-lg shadow-sm overflow-hidden group">
            <summary class="px-6 py-4 cursor-pointer font-semibold text-gray-900 flex justify-between items-center hover:bg-gray-50">
              What is a good throw ratio for a projector?
              <svg class="w-5 h-5 text-gray-400 transform group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="px-6 pb-4 text-gray-700">
              <p class="mb-2"><strong>Standard throw ratio (1.5-1.8)</strong> is most versatile for home theaters:</p>
              <ul class="list-disc ml-6 space-y-1 mb-3">
                <li>Best image quality per dollar</li>
                <li>Widest selection of models</li>
                <li>Good for 12-20 ft rooms</li>
              </ul>
              <p><strong>Ultra short throw (0.25-0.5)</strong> is best for small rooms. <strong>Short throw (0.8-1.2)</strong> balances flexibility and price. <strong>Long throw (2.0+)</strong> is for large venues.</p>
            </div>
          </details>

          <details class="bg-white rounded-lg shadow-sm overflow-hidden group">
            <summary class="px-6 py-4 cursor-pointer font-semibold text-gray-900 flex justify-between items-center hover:bg-gray-50">
              How far should a projector be from a 120 inch screen?
              <svg class="w-5 h-5 text-gray-400 transform group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="px-6 pb-4 text-gray-700">
              <p class="mb-3">For a <strong>120 inch screen</strong> (105 inches wide), placement distance depends on throw ratio:</p>
              <ul class="space-y-2">
                <li>• <strong>Ultra short throw (0.4):</strong> 3.5 feet</li>
                <li>• <strong>Short throw (0.8):</strong> 7.0 feet</li>
                <li>• <strong>Standard (1.5):</strong> 13.1 feet</li>
                <li>• <strong>Long throw (2.0):</strong> 17.5 feet</li>
              </ul>
            </div>
          </details>

          <details class="bg-white rounded-lg shadow-sm overflow-hidden group">
            <summary class="px-6 py-4 cursor-pointer font-semibold text-gray-900 flex justify-between items-center hover:bg-gray-50">
              What's the difference between short throw and ultra short throw projectors?
              <svg class="w-5 h-5 text-gray-400 transform group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="px-6 pb-4 text-gray-700">
              <p class="mb-3"><strong>Ultra short throw (UST)</strong> projectors have 0.25-0.5 throw ratio and sit <strong>8-20 inches</strong> from screen, ideal for tight spaces. Can sit on TV stand below screen.</p>
              <p><strong>Short throw</strong> projectors have 0.8-1.2 ratio and need <strong>3-8 feet</strong> distance, offering better value than UST with good flexibility. Better for medium-sized rooms.</p>
            </div>
          </details>
        </div>
      </div>
    </section>

    <!-- Related Guides -->
    <section class="py-12 lg:py-16 bg-gray-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-8 text-center">
          Related Guides
        </h2>
        <div class="grid md:grid-cols-3 gap-6">
          <a href="/blog/understanding-projector-throw-ratios/" class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-shadow group">
            <div class="p-6">
              <span class="inline-block px-3 py-1 bg-indigo-100 text-indigo-700 rounded-full text-xs font-medium mb-3">
                Projector Guide
              </span>
              <h3 class="text-lg font-bold text-gray-900 mb-2 group-hover:text-indigo-600">
                Understanding Projector Throw Ratios
              </h3>
              <p class="text-gray-600 text-sm mb-3">
                Complete guide to throw ratios with formulas, projector categories, and room planning tips.
              </p>
              <span class="text-indigo-600 text-sm font-medium">Read Guide →</span>
            </div>
          </a>

          <a href="/tv-size-calculator/" class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-shadow group">
            <div class="p-6">
              <span class="inline-block px-3 py-1 bg-emerald-100 text-emerald-700 rounded-full text-xs font-medium mb-3">
                Calculator Tool
              </span>
              <h3 class="text-lg font-bold text-gray-900 mb-2 group-hover:text-indigo-600">
                TV Size Calculator
              </h3>
              <p class="text-gray-600 text-sm mb-3">
                Calculate optimal TV size and viewing distance based on THX and SMPTE standards.
              </p>
              <span class="text-indigo-600 text-sm font-medium">Try Calculator →</span>
            </div>
          </a>

          <a href="/monitor-size-calculator/" class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-shadow group">
            <div class="p-6">
              <span class="inline-block px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-xs font-medium mb-3">
                Calculator Tool
              </span>
              <h3 class="text-lg font-bold text-gray-900 mb-2 group-hover:text-indigo-600">
                Monitor Size Calculator
              </h3>
              <p class="text-gray-600 text-sm mb-3">
                Find the perfect monitor size and resolution for your desk setup and viewing distance.
              </p>
              <span class="text-indigo-600 text-sm font-medium">Try Calculator →</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="bg-gradient-to-r from-indigo-600 to-purple-600 py-12 lg:py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">
          Ready to Set Up Your Projector?
        </h2>
        <p class="text-indigo-100 mb-8 max-w-2xl mx-auto">
          Use our calculator above to get instant throw distance and wall width requirements for any screen size and projector type.
        </p>
        <a
          href="#calculator"
          class="inline-flex items-center gap-2 bg-white text-indigo-600 font-semibold px-6 py-3 rounded-lg hover:bg-indigo-50 transition-colors"
        >
          Use Calculator Now
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
          </svg>
        </a>
      </div>
    </section>
  </main>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(faqData)} />
</Layout>

<script>
  // Auto-switch to Projector mode when page loads
  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(() => {
      const projectorButton = document.querySelector('[aria-label="Projector mode"]') as HTMLButtonElement;
      if (projectorButton && projectorButton.getAttribute('aria-selected') !== 'true') {
        projectorButton.click();
      }
    }, 100);
  });
</script>
