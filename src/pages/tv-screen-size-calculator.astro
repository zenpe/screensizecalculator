---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import ScreenSizeCalculator from "../components/ScreenSizeCalculator";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import UseCaseScenarios from "../components/UseCaseScenarios.astro";
import type { UseCase } from "../components/UseCaseScenarios.astro";
import { siteConfig } from "../site.config";

// Use case scenarios for TV users
const tvUseCases: UseCase[] = [
  {
    icon: 'movie',
    title: 'Movie Enthusiasts',
    audience: 'Home cinema lovers & film buffs',
    recommendations: [
      '65-85 inch for immersive cinematic experience',
      'OLED or Mini-LED for superior contrast',
      'Sit at THX distance (1.2x screen diagonal)',
      'Consider 21:9 content compatibility'
    ],
    proTip: 'Enable filmmaker mode to see movies as directors intended with accurate colors and 24fps playback.'
  },
  {
    icon: 'game',
    title: 'Console Gamers',
    audience: 'PlayStation, Xbox & Nintendo players',
    recommendations: [
      '55-65 inch for optimal gaming immersion',
      'HDMI 2.1 for 4K@120Hz gaming',
      'Low input lag (<15ms) is crucial',
      'VRR support for tear-free gameplay'
    ],
    proTip: 'Enable Game Mode for lowest input lag. Consider sitting 4-6 feet from a 55" TV to see game details clearly.'
  },
  {
    icon: 'sports',
    title: 'Sports Fans',
    audience: 'Live sports & action viewers',
    recommendations: [
      '65-75 inch for group viewing parties',
      '120Hz native panel for smooth motion',
      'Wide viewing angles for side seating',
      'High peak brightness for daytime viewing'
    ],
    proTip: 'Enable Sports or Motion mode during live events for smoother ball tracking and clearer fast action.'
  }
];

const title = "TV Size Calculator - Viewing Distance & Dimensions";
const description =
  "Free TV size to distance calculator. Find the perfect TV size for your room. Get exact screen width & height dimensions and THX recommendations for 4K TVs.";
const keywords =
  "tv size calculator, tv viewing distance calculator, tv size to distance calculator, optimal tv size, how far to sit from tv, best tv size for room, 4k tv viewing distance";

// FAQ Schema
const faqData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "How far should I sit from a 55 inch TV?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "For a 55 inch 4K TV, the optimal viewing distance is 7.3 feet (2.2m) based on SMPTE standards. The comfortable range is 5.5-11.5 feet. For a more immersive THX experience, sit 5.5 feet away.",
      },
    },
    {
      "@type": "Question",
      name: "What size TV for 10 feet viewing distance?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "For a 10 feet (3m) viewing distance, the recommended TV size is 60-75 inches for 4K TVs. A 65 inch TV is the sweet spot, providing optimal viewing based on THX and SMPTE standards.",
      },
    },
    {
      "@type": "Question",
      name: "Is bigger TV always better?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Not always. Too large a TV for close viewing can cause eye strain and neck fatigue. Follow the THX formula: minimum distance = screen diagonal × 1.2 for 4K TVs. The maximum comfortable distance is screen diagonal × 2.5.",
      },
    },
    {
      "@type": "Question",
      name: "What's the difference between 4K and 1080p viewing distance?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "4K TVs can be viewed 25-30% closer than 1080p TVs without seeing pixels. For a 65 inch TV: 4K minimum distance is 3.9 feet, while 1080p minimum is 7.8 feet. This allows larger TVs in the same space with 4K.",
      },
    },
    {
      "@type": "Question",
      name: "What is the best TV size for a bedroom?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "For bedrooms with 6-8 feet viewing distance, a 40-50 inch TV is ideal. If your bedroom is smaller (5-6 feet distance), choose 32-43 inches. For master bedrooms with 8-10 feet distance, 50-55 inches works well. Consider mounting height and bed position for optimal comfort.",
      },
    },
    {
      "@type": "Question",
      name: "How do I measure TV size correctly?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "TV size is measured diagonally from one corner of the screen to the opposite corner, excluding the bezel/frame. A 65 inch TV means 65 inches diagonally. The actual width is approximately 56.7 inches and height is 31.9 inches for a 16:9 aspect ratio TV.",
      },
    },
    {
      "@type": "Question",
      name: "What size TV is best for gaming?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "For gaming, 55-65 inches is optimal for most living rooms (7-10 feet distance). Sit closer than for movies - about 4-6 feet for a 55 inch 4K TV to see game details. For competitive gaming, some prefer 27-32 inch monitors at desk distance for faster response times.",
      },
    },
    {
      "@type": "Question",
      name: "Is 65 inch TV too big for my living room?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "A 65 inch TV is ideal for living rooms with 8-10 feet viewing distance. If you sit closer than 6.5 feet, it may feel too large and cause neck strain. For smaller rooms (6-8 feet), consider 55 inches instead. Measure your actual seating distance before purchasing.",
      },
    },
    {
      "@type": "Question",
      name: "What is the ideal TV mounting height?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "The ideal TV mounting height places the center of the screen at eye level when seated, typically 42-48 inches from the floor to the TV center. For a 65 inch TV, the bottom edge should be about 26-32 inches from the floor. Mounting too high causes neck strain during extended viewing.",
      },
    },
    {
      "@type": "Question",
      name: "How do I calculate TV size for my room?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Use this formula: Viewing Distance (inches) ÷ 1.6 = Recommended TV Size. For example, 10 feet (120 inches) ÷ 1.6 = 75 inches. For a more immersive experience, divide by 1.2 instead. This calculator above provides instant recommendations based on industry THX and SMPTE standards.",
      },
    },
  ],
};

// SoftwareApplication Schema for the calculator tool
const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "TV Size Calculator",
  description: description,
  applicationCategory: "UtilityApplication",
  operatingSystem: "All",
  url: `${siteConfig.siteUrl}/tv-screen-size-calculator`,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
};

// Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: siteConfig.siteUrl,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Calculators",
      item: `${siteConfig.siteUrl}/calculators`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "TV Screen Size Calculator",
      item: `${siteConfig.siteUrl}/tv-screen-size-calculator`,
    },
  ],
};

// HowTo Schema for step-by-step guide
const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: "How to Find Your Perfect TV Size",
  description:
    "Learn how to calculate the optimal TV size for your room based on viewing distance using THX and SMPTE standards.",
  totalTime: "PT5M",
  step: [
    {
      "@type": "HowToStep",
      position: 1,
      name: "Measure Your Viewing Distance",
      text: "Measure from where you'll sit to where the TV will be mounted. This is the most critical measurement for determining optimal TV size.",
    },
    {
      "@type": "HowToStep",
      position: 2,
      name: "Enter TV Size",
      text: "Input your desired TV diagonal size in inches or cm. The calculator shows if it fits your viewing distance based on industry standards.",
    },
    {
      "@type": "HowToStep",
      position: 3,
      name: "Check Viewing Distance Recommendations",
      text: "See the optimal, minimum, and maximum viewing distances based on THX (immersive) and SMPTE (balanced) standards.",
    },
    {
      "@type": "HowToStep",
      position: 4,
      name: "Review Specifications",
      text: "Get exact width, height, area, PPI, and pixel density. Perfect for comparing different TV sizes before purchase.",
    },
  ],
};
---

<Layout title={title} description={description} keywords={keywords}>
  <Header />

  <main class="flex-1">
    <!-- Hero Section -->
    <section
      class="bg-gradient-to-b from-emerald-50 to-white dark:from-emerald-900/20 dark:to-gray-900 py-12 lg:py-16"
    >
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Breadcrumb Navigation -->
        <nav class="mb-6 overflow-x-auto" aria-label="Breadcrumb">
          <ol
            class="flex items-center gap-1 sm:gap-2 text-xs sm:text-sm text-gray-600 dark:text-gray-400 whitespace-nowrap"
          >
            <li>
              <a
                href="/"
                class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                >Home</a
              >
            </li>
            <li>
              <svg
                class="w-3 h-3 sm:w-4 sm:h-4 flex-shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path></svg
              >
            </li>
            <li>
              <a
                href="/calculators"
                class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                >Calculators</a
              >
            </li>
            <li>
              <svg
                class="w-3 h-3 sm:w-4 sm:h-4 flex-shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path></svg
              >
            </li>
            <li>
              <span class="text-gray-900 dark:text-gray-100 font-medium"
                >TV Screen Size Calculator</span
              >
            </li>
          </ol>
        </nav>

        <div class="text-center">
          <h1
            class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-gray-100 mb-4"
          >
            TV Screen Size Calculator & Viewing Distance Tool
          </h1>
          <p
            class="text-lg text-gray-600 dark:text-gray-300 max-w-3xl mx-auto mb-6"
          >
            Find the perfect TV size for your room with expert viewing distance
            recommendations based on THX and SMPTE standards. Calculate screen
            dimensions, optimal seating distance, and PPI for any TV size.
          </p>
          <div
            class="flex flex-wrap justify-center gap-3 text-sm text-gray-600 dark:text-gray-400"
          >
          <span class="flex items-center gap-1">
            <svg
              class="w-5 h-5 text-emerald-600 dark:text-emerald-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"></path>
            </svg>
            THX & SMPTE Standards
          </span>
          <span class="flex items-center gap-1">
            <svg
              class="w-5 h-5 text-emerald-600 dark:text-emerald-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"></path>
            </svg>
            4K vs 1080p Comparison
          </span>
          <span class="flex items-center gap-1">
            <svg
              class="w-5 h-5 text-emerald-600 dark:text-emerald-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"></path>
            </svg>
            Instant Calculations
          </span>
        </div>
      </div>
    </section>

    <!-- Calculator Section -->
    <section class="py-12 lg:py-16" id="calculator">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <ScreenSizeCalculator client:load initialDeviceMode="tv" />
      </div>
    </section>

    <!-- How to Use Guide -->
    <section class="py-12 lg:py-16 bg-gray-50 dark:bg-gray-800/50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2
          class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100 mb-8 text-center"
        >
          How to Find Your Perfect TV Size
        </h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div
            class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm border border-gray-100 dark:border-gray-700"
          >
            <div class="flex items-start gap-4">
              <div
                class="bg-emerald-100 dark:bg-emerald-900/50 rounded-lg p-3 text-emerald-600 dark:text-emerald-400 font-bold text-xl"
              >
                1
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">
                  Measure Your Viewing Distance
                </h3>
                <p class="text-gray-600 dark:text-gray-400 text-sm">
                  Measure from where you'll sit to where the TV will be mounted.
                  This is the most critical measurement.
                </p>
              </div>
            </div>
          </div>
          <div
            class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm border border-gray-100 dark:border-gray-700"
          >
            <div class="flex items-start gap-4">
              <div
                class="bg-emerald-100 dark:bg-emerald-900/50 rounded-lg p-3 text-emerald-600 dark:text-emerald-400 font-bold text-xl"
              >
                2
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">
                  Enter TV Size
                </h3>
                <p class="text-gray-600 dark:text-gray-400 text-sm">
                  Input your desired TV diagonal size in inches or cm. The
                  calculator shows if it fits your viewing distance.
                </p>
              </div>
            </div>
          </div>
          <div
            class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm border border-gray-100 dark:border-gray-700"
          >
            <div class="flex items-start gap-4">
              <div
                class="bg-emerald-100 dark:bg-emerald-900/50 rounded-lg p-3 text-emerald-600 dark:text-emerald-400 font-bold text-xl"
              >
                3
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">
                  Check Viewing Distance
                </h3>
                <p class="text-gray-600 dark:text-gray-400 text-sm">
                  See the optimal, minimum, and maximum viewing distances based
                  on THX (immersive) and SMPTE (balanced) standards.
                </p>
              </div>
            </div>
          </div>
          <div
            class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm border border-gray-100 dark:border-gray-700"
          >
            <div class="flex items-start gap-4">
              <div
                class="bg-emerald-100 dark:bg-emerald-900/50 rounded-lg p-3 text-emerald-600 dark:text-emerald-400 font-bold text-xl"
              >
                4
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">
                  Review Specifications
                </h3>
                <p class="text-gray-600 dark:text-gray-400 text-sm">
                  Get exact width, height, area, PPI, and pixel density. Perfect
                  for comparing different TV sizes.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Use Case Scenarios -->
    <UseCaseScenarios
      title="TV Recommendations by Use Case"
      subtitle="Find the perfect TV setup based on how you plan to use it most. Different viewing habits require different screen considerations."
      useCases={tvUseCases}
      themeColor="emerald"
    />

    <!-- Quick Reference Guide -->
    <section class="py-12 lg:py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2
          class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100 mb-8 text-center"
        >
          TV Size Quick Reference Guide
        </h2>
        <div class="overflow-x-auto">
          <table
            class="w-full bg-white dark:bg-gray-800 rounded-xl shadow-sm overflow-hidden border border-gray-100 dark:border-gray-700"
          >
            <thead
              class="bg-gradient-to-r from-emerald-600 to-emerald-700 text-white"
            >
              <tr>
                <th class="px-6 py-4 text-left font-semibold"
                  >Viewing Distance</th
                >
                <th class="px-6 py-4 text-left font-semibold"
                  >Recommended TV Size (4K)</th
                >
                <th class="px-6 py-4 text-left font-semibold"
                  >Screen Width × Height</th
                >
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                <td
                  class="px-6 py-4 font-medium text-gray-900 dark:text-gray-200"
                  >5-6 feet (1.5-1.8m)</td
                >
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300"
                  >40-50 inches</td
                >
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400 text-sm"
                  >35" × 20" - 44" × 25"</td
                >
              </tr>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                <td
                  class="px-6 py-4 font-medium text-gray-900 dark:text-gray-200"
                  >6-8 feet (1.8-2.4m)</td
                >
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300"
                  >50-60 inches</td
                >
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400 text-sm"
                  >44" × 25" - 52" × 29"</td
                >
              </tr>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                <td
                  class="px-6 py-4 font-medium text-gray-900 dark:text-gray-200"
                  >8-10 feet (2.4-3m)</td
                >
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300"
                  >60-75 inches</td
                >
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400 text-sm"
                  >52" × 29" - 65" × 37"</td
                >
              </tr>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                <td
                  class="px-6 py-4 font-medium text-gray-900 dark:text-gray-200"
                  >10-12 feet (3-3.6m)</td
                >
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300"
                  >75-85 inches</td
                >
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400 text-sm"
                  >65" × 37" - 74" × 42"</td
                >
              </tr>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                <td
                  class="px-6 py-4 font-medium text-gray-900 dark:text-gray-200"
                  >12+ feet (3.6m+)</td
                >
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300"
                  >85+ inches</td
                >
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400 text-sm"
                  >74" × 42" or larger</td
                >
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-12 lg:py-16 bg-gray-50 dark:bg-gray-800/50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2
          class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100 mb-8 text-center"
        >
          Frequently Asked Questions
        </h2>
        <div class="space-y-4">
          <details
            class="bg-white dark:bg-gray-800 rounded-lg shadow-sm overflow-hidden group border border-gray-100 dark:border-gray-700"
          >
            <summary
              class="px-6 py-4 cursor-pointer font-semibold text-gray-900 dark:text-gray-200 flex justify-between items-center hover:bg-gray-50 dark:hover:bg-gray-700/50"
            >
              How far should I sit from a 55 inch TV?
              <svg
                class="w-5 h-5 text-gray-400 transform group-open:rotate-180 transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="px-6 pb-4 text-gray-700 dark:text-gray-300">
              <p class="mb-3">
                For a <strong>55 inch 4K TV</strong>, the optimal viewing
                distance is <strong>7.3 feet (2.2m)</strong> based on SMPTE standards.
                The comfortable range is 5.5-11.5 feet.
              </p>
              <p>
                For a more immersive THX experience, sit <strong
                  >5.5 feet</strong
                > away. This closer distance fills more of your field of view, similar
                to a cinema experience.
              </p>
            </div>
          </details>

          <details
            class="bg-white dark:bg-gray-800 rounded-lg shadow-sm overflow-hidden group border border-gray-100 dark:border-gray-700"
          >
            <summary
              class="px-6 py-4 cursor-pointer font-semibold text-gray-900 dark:text-gray-200 flex justify-between items-center hover:bg-gray-50 dark:hover:bg-gray-700/50"
            >
              What size TV for 10 feet viewing distance?
              <svg
                class="w-5 h-5 text-gray-400 transform group-open:rotate-180 transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="px-6 pb-4 text-gray-700 dark:text-gray-300">
              <p class="mb-3">
                For a <strong>10 feet (3m)</strong> viewing distance, the recommended
                TV size is <strong>60-75 inches</strong> for 4K TVs.
              </p>
              <p>
                A <strong>65 inch TV</strong> is the sweet spot, providing optimal
                viewing based on THX and SMPTE standards. This gives you an immersive
                experience without requiring head movement.
              </p>
            </div>
          </details>

          <details
            class="bg-white dark:bg-gray-800 rounded-lg shadow-sm overflow-hidden group border border-gray-100 dark:border-gray-700"
          >
            <summary
              class="px-6 py-4 cursor-pointer font-semibold text-gray-900 dark:text-gray-200 flex justify-between items-center hover:bg-gray-50 dark:hover:bg-gray-700/50"
            >
              Is bigger TV always better?
              <svg
                class="w-5 h-5 text-gray-400 transform group-open:rotate-180 transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="px-6 pb-4 text-gray-700 dark:text-gray-300">
              <p class="mb-3">
                Not always. Too large a TV for close viewing can cause <strong
                  >eye strain and neck fatigue</strong
                >. Follow the THX formula: minimum distance = screen diagonal ×
                1.2 for 4K TVs.
              </p>
              <p>
                The maximum comfortable distance is screen diagonal × 2.5.
                Beyond this, you'll miss details and the viewing experience
                suffers.
              </p>
            </div>
          </details>

          <details
            class="bg-white dark:bg-gray-800 rounded-lg shadow-sm overflow-hidden group border border-gray-100 dark:border-gray-700"
          >
            <summary
              class="px-6 py-4 cursor-pointer font-semibold text-gray-900 dark:text-gray-200 flex justify-between items-center hover:bg-gray-50 dark:hover:bg-gray-700/50"
            >
              What's the difference between 4K and 1080p viewing distance?
