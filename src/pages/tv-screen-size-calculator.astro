---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ScreenSizeCalculator from '../components/ScreenSizeCalculator';
const title = 'TV Screen Size Calculator - Perfect Viewing Distance & Size';
const description = 'Calculate the perfect TV size for your room based on viewing distance. Get THX & SMPTE recommendations, screen dimensions, and PPI for 4K TVs.';
const keywords = 'tv size calculator, tv viewing distance calculator, optimal tv size, how far to sit from tv, best tv size for room, 4k tv viewing distance, tv screen size calculator';

// FAQ Schema
const faqData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How far should I sit from a 55 inch TV?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For a 55 inch 4K TV, the optimal viewing distance is 7.3 feet (2.2m) based on SMPTE standards. The comfortable range is 5.5-11.5 feet. For a more immersive THX experience, sit 5.5 feet away."
      }
    },
    {
      "@type": "Question",
      "name": "What size TV for 10 feet viewing distance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For a 10 feet (3m) viewing distance, the recommended TV size is 60-75 inches for 4K TVs. A 65 inch TV is the sweet spot, providing optimal viewing based on THX and SMPTE standards."
      }
    },
    {
      "@type": "Question",
      "name": "Is bigger TV always better?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Not always. Too large a TV for close viewing can cause eye strain and neck fatigue. Follow the THX formula: minimum distance = screen diagonal × 1.2 for 4K TVs. The maximum comfortable distance is screen diagonal × 2.5."
      }
    },
    {
      "@type": "Question",
      "name": "What's the difference between 4K and 1080p viewing distance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "4K TVs can be viewed 25-30% closer than 1080p TVs without seeing pixels. For a 65 inch TV: 4K minimum distance is 3.9 feet, while 1080p minimum is 7.8 feet. This allows larger TVs in the same space with 4K."
      }
    }
  ]
};
---

<Layout title={title} description={description} keywords={keywords}>
  <Header />

  <main class="flex-1">
    <!-- Hero Section -->
    <section class="bg-gradient-to-b from-emerald-50 to-white dark:from-emerald-900/20 dark:to-gray-900 py-12 lg:py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-gray-100 mb-4">
          TV Screen Size Calculator & Viewing Distance Tool
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-300 max-w-3xl mx-auto mb-6">
          Find the perfect TV size for your room with expert viewing distance recommendations based on THX and SMPTE standards. Calculate screen dimensions, optimal seating distance, and PPI for any TV size.
        </p>
        <div class="flex flex-wrap justify-center gap-3 text-sm text-gray-600 dark:text-gray-400">
          <span class="flex items-center gap-1">
            <svg class="w-5 h-5 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            THX & SMPTE Standards
          </span>
          <span class="flex items-center gap-1">
            <svg class="w-5 h-5 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            4K vs 1080p Comparison
          </span>
          <span class="flex items-center gap-1">
            <svg class="w-5 h-5 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            Instant Calculations
          </span>
        </div>
      </div>
    </section>

    <!-- Calculator Section -->
    <section class="py-12 lg:py-16" id="calculator">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <ScreenSizeCalculator client:load initialDeviceMode="tv" />
      </div>
    </section>

    <!-- How to Use Guide -->
    <section class="py-12 lg:py-16 bg-gray-50 dark:bg-gray-800/50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100 mb-8 text-center">
          How to Find Your Perfect TV Size
        </h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm border border-gray-100 dark:border-gray-700">
            <div class="flex items-start gap-4">
              <div class="bg-emerald-100 dark:bg-emerald-900/50 rounded-lg p-3 text-emerald-600 dark:text-emerald-400 font-bold text-xl">1</div>
              <div>
                <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">Measure Your Viewing Distance</h3>
                <p class="text-gray-600 dark:text-gray-400 text-sm">Measure from where you'll sit to where the TV will be mounted. This is the most critical measurement.</p>
              </div>
            </div>
          </div>
          <div class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm border border-gray-100 dark:border-gray-700">
            <div class="flex items-start gap-4">
              <div class="bg-emerald-100 dark:bg-emerald-900/50 rounded-lg p-3 text-emerald-600 dark:text-emerald-400 font-bold text-xl">2</div>
              <div>
                <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">Enter TV Size</h3>
                <p class="text-gray-600 dark:text-gray-400 text-sm">Input your desired TV diagonal size in inches or cm. The calculator shows if it fits your viewing distance.</p>
              </div>
            </div>
          </div>
          <div class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm border border-gray-100 dark:border-gray-700">
            <div class="flex items-start gap-4">
              <div class="bg-emerald-100 dark:bg-emerald-900/50 rounded-lg p-3 text-emerald-600 dark:text-emerald-400 font-bold text-xl">3</div>
              <div>
                <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">Check Viewing Distance</h3>
                <p class="text-gray-600 dark:text-gray-400 text-sm">See the optimal, minimum, and maximum viewing distances based on THX (immersive) and SMPTE (balanced) standards.</p>
              </div>
            </div>
          </div>
          <div class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm border border-gray-100 dark:border-gray-700">
            <div class="flex items-start gap-4">
              <div class="bg-emerald-100 dark:bg-emerald-900/50 rounded-lg p-3 text-emerald-600 dark:text-emerald-400 font-bold text-xl">4</div>
              <div>
                <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">Review Specifications</h3>
                <p class="text-gray-600 dark:text-gray-400 text-sm">Get exact width, height, area, PPI, and pixel density. Perfect for comparing different TV sizes.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Quick Reference Guide -->
    <section class="py-12 lg:py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100 mb-8 text-center">
          TV Size Quick Reference Guide
        </h2>
        <div class="overflow-x-auto">
          <table class="w-full bg-white dark:bg-gray-800 rounded-xl shadow-sm overflow-hidden border border-gray-100 dark:border-gray-700">
            <thead class="bg-gradient-to-r from-emerald-600 to-emerald-700 text-white">
              <tr>
                <th class="px-6 py-4 text-left font-semibold">Viewing Distance</th>
                <th class="px-6 py-4 text-left font-semibold">Recommended TV Size (4K)</th>
                <th class="px-6 py-4 text-left font-semibold">Screen Width × Height</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                <td class="px-6 py-4 font-medium text-gray-900 dark:text-gray-200">5-6 feet (1.5-1.8m)</td>
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300">40-50 inches</td>
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400 text-sm">35" × 20" - 44" × 25"</td>
              </tr>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                <td class="px-6 py-4 font-medium text-gray-900 dark:text-gray-200">6-8 feet (1.8-2.4m)</td>
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300">50-60 inches</td>
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400 text-sm">44" × 25" - 52" × 29"</td>
              </tr>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                <td class="px-6 py-4 font-medium text-gray-900 dark:text-gray-200">8-10 feet (2.4-3m)</td>
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300">60-75 inches</td>
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400 text-sm">52" × 29" - 65" × 37"</td>
              </tr>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                <td class="px-6 py-4 font-medium text-gray-900 dark:text-gray-200">10-12 feet (3-3.6m)</td>
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300">75-85 inches</td>
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400 text-sm">65" × 37" - 74" × 42"</td>
              </tr>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                <td class="px-6 py-4 font-medium text-gray-900 dark:text-gray-200">12+ feet (3.6m+)</td>
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300">85+ inches</td>
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400 text-sm">74" × 42" or larger</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-12 lg:py-16 bg-gray-50 dark:bg-gray-800/50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100 mb-8 text-center">
          Frequently Asked Questions
        </h2>
        <div class="space-y-4">
          <details class="bg-white dark:bg-gray-800 rounded-lg shadow-sm overflow-hidden group border border-gray-100 dark:border-gray-700">
            <summary class="px-6 py-4 cursor-pointer font-semibold text-gray-900 dark:text-gray-200 flex justify-between items-center hover:bg-gray-50 dark:hover:bg-gray-700/50">
              How far should I sit from a 55 inch TV?
              <svg class="w-5 h-5 text-gray-400 transform group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="px-6 pb-4 text-gray-700 dark:text-gray-300">
              <p class="mb-3">For a <strong>55 inch 4K TV</strong>, the optimal viewing distance is <strong>7.3 feet (2.2m)</strong> based on SMPTE standards. The comfortable range is 5.5-11.5 feet.</p>
              <p>For a more immersive THX experience, sit <strong>5.5 feet</strong> away. This closer distance fills more of your field of view, similar to a cinema experience.</p>
            </div>
          </details>

          <details class="bg-white dark:bg-gray-800 rounded-lg shadow-sm overflow-hidden group border border-gray-100 dark:border-gray-700">
            <summary class="px-6 py-4 cursor-pointer font-semibold text-gray-900 dark:text-gray-200 flex justify-between items-center hover:bg-gray-50 dark:hover:bg-gray-700/50">
              What size TV for 10 feet viewing distance?
              <svg class="w-5 h-5 text-gray-400 transform group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="px-6 pb-4 text-gray-700 dark:text-gray-300">
              <p class="mb-3">For a <strong>10 feet (3m)</strong> viewing distance, the recommended TV size is <strong>60-75 inches</strong> for 4K TVs.</p>
              <p>A <strong>65 inch TV</strong> is the sweet spot, providing optimal viewing based on THX and SMPTE standards. This gives you an immersive experience without requiring head movement.</p>
            </div>
          </details>

          <details class="bg-white dark:bg-gray-800 rounded-lg shadow-sm overflow-hidden group border border-gray-100 dark:border-gray-700">
            <summary class="px-6 py-4 cursor-pointer font-semibold text-gray-900 dark:text-gray-200 flex justify-between items-center hover:bg-gray-50 dark:hover:bg-gray-700/50">
              Is bigger TV always better?
              <svg class="w-5 h-5 text-gray-400 transform group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="px-6 pb-4 text-gray-700 dark:text-gray-300">
              <p class="mb-3">Not always. Too large a TV for close viewing can cause <strong>eye strain and neck fatigue</strong>. Follow the THX formula: minimum distance = screen diagonal × 1.2 for 4K TVs.</p>
              <p>The maximum comfortable distance is screen diagonal × 2.5. Beyond this, you'll miss details and the viewing experience suffers.</p>
            </div>
          </details>

          <details class="bg-white dark:bg-gray-800 rounded-lg shadow-sm overflow-hidden group border border-gray-100 dark:border-gray-700">
            <summary class="px-6 py-4 cursor-pointer font-semibold text-gray-900 dark:text-gray-200 flex justify-between items-center hover:bg-gray-50 dark:hover:bg-gray-700/50">
              What's the difference between 4K and 1080p viewing distance?
              <svg class="w-5 h-5 text-gray-400 transform group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="px-6 pb-4 text-gray-700 dark:text-gray-300">
              <p class="mb-3">4K TVs can be viewed <strong>25-30% closer</strong> than 1080p TVs without seeing pixels.</p>
              <p>For a 65 inch TV: 4K minimum distance is <strong>3.9 feet</strong>, while 1080p minimum is <strong>7.8 feet</strong>. This allows larger TVs in the same space with 4K resolution.</p>
            </div>
          </details>
        </div>
      </div>
    </section>

    <!-- Related Guides -->
    <section class="py-12 lg:py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100 mb-8 text-center">
          Related Guides
        </h2>
        <div class="grid md:grid-cols-3 gap-6">
          <a href="/blog/how-to-choose-tv-size-for-room" class="bg-white dark:bg-gray-800 rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-shadow group border border-gray-100 dark:border-gray-700">
            <div class="p-6">
              <span class="inline-block px-3 py-1 bg-emerald-100 dark:bg-emerald-900/50 text-emerald-700 dark:text-emerald-300 rounded-full text-xs font-medium mb-3">
                TV Buying Guide
              </span>
              <h3 class="text-lg font-bold text-gray-900 dark:text-gray-200 mb-2 group-hover:text-emerald-600 dark:group-hover:text-emerald-400">
                How to Choose the Right TV Size for Your Room
              </h3>
              <p class="text-gray-600 dark:text-gray-400 text-sm mb-3">
                Complete guide to selecting the perfect TV size based on room dimensions and seating arrangement.
              </p>
              <span class="text-emerald-600 dark:text-emerald-400 text-sm font-medium">Read Guide →</span>
            </div>
          </a>

          <a href="/blog/4k-vs-8k-viewing-distance" class="bg-white dark:bg-gray-800 rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-shadow group border border-gray-100 dark:border-gray-700">
            <div class="p-6">
              <span class="inline-block px-3 py-1 bg-purple-100 dark:bg-purple-900/50 text-purple-700 dark:text-purple-300 rounded-full text-xs font-medium mb-3">
                Display Technology
              </span>
              <h3 class="text-lg font-bold text-gray-900 dark:text-gray-200 mb-2 group-hover:text-emerald-600 dark:group-hover:text-emerald-400">
                4K vs 8K: Viewing Distance Comparison
              </h3>
              <p class="text-gray-600 dark:text-gray-400 text-sm mb-3">
                Detailed comparison of 4K and 8K TVs with optimal viewing distances and whether 8K is worth it.
              </p>
              <span class="text-emerald-600 dark:text-emerald-400 text-sm font-medium">Read Comparison →</span>
            </div>
          </a>

          <a href="/monitor-screen-size-calculator" class="bg-white dark:bg-gray-800 rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-shadow group border border-gray-100 dark:border-gray-700">
            <div class="p-6">
              <span class="inline-block px-3 py-1 bg-blue-100 dark:bg-blue-900/50 text-blue-700 dark:text-blue-300 rounded-full text-xs font-medium mb-3">
                Calculator Tool
              </span>
              <h3 class="text-lg font-bold text-gray-900 dark:text-gray-200 mb-2 group-hover:text-emerald-600 dark:group-hover:text-emerald-400">
                Monitor Size Calculator
              </h3>
              <p class="text-gray-600 dark:text-gray-400 text-sm mb-3">
                Calculate optimal monitor size and viewing distance for your desktop workspace.
              </p>
              <span class="text-emerald-600 dark:text-emerald-400 text-sm font-medium">Try Calculator →</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="bg-gradient-to-r from-emerald-600 to-emerald-700 py-12 lg:py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">
          Ready to Find Your Perfect TV?
        </h2>
        <p class="text-emerald-100 dark:text-emerald-200 mb-8 max-w-2xl mx-auto">
          Use our calculator above to get instant viewing distance recommendations based on THX and SMPTE industry standards.
        </p>
        <a
          href="#calculator"
          class="inline-flex items-center gap-2 bg-white text-emerald-600 font-semibold px-6 py-3 rounded-lg hover:bg-emerald-50 dark:hover:bg-emerald-100 transition-colors"
        >
          Use Calculator Now
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
          </svg>
        </a>
      </div>
    </section>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(faqData)} />
</Layout>
