---
import Layout from "../layouts/Layout.astro";
import AspectRatioCalculatorComponent from "../components/calculators/AspectRatioCalculator";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import FAQSection from "../components/FAQSection.astro";
import { siteConfig } from "../site.config";

const title = "Aspect Ratio Calculator & Converter - Free Screen Ratio Tool";
const description =
  "Free aspect ratio calculator and converter. Calculate image ratio from width and height using our formula tool. Convert 16:9, 21:9, 4:3 ratios instantly.";
const keywords =
  "aspect ratio calculator, aspect ratio converter, screen ratio, image ratio, aspect ratio, aspect ratios, aspect ratio formula, resolution calculator, 16:9 calculator, 21:9 ultrawide, 4:3 ratio, what is aspect ratio, video aspect ratio, width height ratio";

// Common aspect ratios data
const commonRatios = [
  {
    ratio: "16:9",
    decimal: "1.778",
    formula: "Width = Height × 1.778",
    use: "Standard widescreen TVs, monitors, YouTube videos",
    examples: "1920×1080, 2560×1440, 3840×2160",
  },
  {
    ratio: "21:9",
    decimal: "2.333",
    formula: "Width = Height × 2.333",
    use: "Ultrawide monitors, cinematic films",
    examples: "2560×1080, 3440×1440, 5120×2160",
  },
  {
    ratio: "4:3",
    decimal: "1.333",
    formula: "Width = Height × 1.333",
    use: "Classic TVs, iPad, presentations",
    examples: "1024×768, 1600×1200, 2048×1536",
  },
  {
    ratio: "1:1",
    decimal: "1.000",
    formula: "Width = Height",
    use: "Instagram posts, profile pictures",
    examples: "1080×1080, 2048×2048",
  },
  {
    ratio: "9:16",
    decimal: "0.563",
    formula: "Width = Height × 0.563",
    use: "TikTok, Instagram Reels, mobile video",
    examples: "1080×1920, 1440×2560",
  },
  {
    ratio: "3:2",
    decimal: "1.500",
    formula: "Width = Height × 1.5",
    use: "DSLR photos, MacBook displays",
    examples: "1440×960, 2160×1440, 3000×2000",
  },
  {
    ratio: "16:10",
    decimal: "1.600",
    formula: "Width = Height × 1.6",
    use: "MacBooks, some monitors, tablets",
    examples: "1920×1200, 2560×1600, 3840×2400",
  },
  {
    ratio: "2.39:1",
    decimal: "2.390",
    formula: "Width = Height × 2.39",
    use: "Anamorphic widescreen cinema",
    examples: "2048×858, 4096×1716",
  },
];

const faqs = [
  {
    question: "What is aspect ratio?",
    answer: "Aspect ratio is the proportional relationship between width and height of a screen or image. It's expressed as two numbers separated by a colon (e.g., 16:9). Common ratios include 16:9 (widescreen), 21:9 (ultrawide), 4:3 (standard), and 1:1 (square).",
  },
  {
    question: "How do I calculate aspect ratio from width and height?",
    answer: "Divide the width by the height, then find the greatest common divisor (GCD) to simplify. For example, 1920÷1080 = 1.777... The GCD of 1920 and 1080 is 120, so 1920/120 : 1080/120 = 16:9.",
  },
  {
    question: "What is the most common aspect ratio for videos?",
    answer: "16:9 is the most common aspect ratio for modern video content, used by YouTube, Netflix, and most streaming platforms. For vertical mobile video (TikTok, Reels), 9:16 is standard.",
  },
  {
    question: "What aspect ratio is 1920x1080?",
    answer: "1920×1080 pixels (Full HD or 1080p) has an aspect ratio of 16:9. This is the most widely used resolution for monitors, TVs, and video content.",
  },
  {
    question: "How do I convert aspect ratio to pixels?",
    answer: "Multiply the aspect ratio values by a common factor. For 16:9 at 1080p height: width = (16/9) × 1080 = 1920. For any target dimension, use our calculator's 'New Dimension' mode.",
  },
  {
    question: "What is the difference between 16:9 and 16:10?",
    answer: "16:9 (1.778:1) is wider and more common for video content. 16:10 (1.6:1) is slightly taller, preferred for productivity as it shows more vertical content. MacBooks use 16:10.",
  },
  {
    question: "What is the aspect ratio formula?",
    answer: "The aspect ratio formula is: Aspect Ratio = Width ÷ Height. To calculate dimensions: Width = Height × Ratio, or Height = Width ÷ Ratio. For example, for 16:9 with height 1080: Width = 1080 × (16÷9) = 1080 × 1.778 = 1920 pixels.",
  },
  {
    question: "What aspect ratio is best for Instagram and TikTok?",
    answer: "Instagram feed posts use 1:1 (square) or 4:5 (portrait). Instagram Stories and Reels use 9:16 (1080×1920). TikTok videos use 9:16 vertical format. For Instagram carousels, 1:1 at 1080×1080 pixels works best.",
  },
];

// SoftwareApplication Schema for the calculator tool
const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Aspect Ratio Calculator & Converter",
  description: description,
  applicationCategory: "UtilityApplication",
  operatingSystem: "All",
  url: `${siteConfig.siteUrl}/aspect-ratio-calculator`,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  author: {
    "@type": "Organization",
    name: "Screen Size Calculator",
  },
};

// HowTo Schema for step-by-step instructions
const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: "How to Calculate Aspect Ratio",
  description:
    "Learn how to calculate aspect ratio from pixel dimensions or find missing dimensions using a known aspect ratio.",
  step: [
    {
      "@type": "HowToStep",
      name: "Choose Your Mode",
      text: "Select 'Find Ratio' to discover the aspect ratio from pixel dimensions, or 'New Dimension' to calculate missing width/height from a known ratio.",
    },
    {
      "@type": "HowToStep",
      name: "Enter Dimensions",
      text: "Input your width and height in pixels, or use quick presets like 16:9, 21:9, or 9:16 for common screen ratios.",
    },
    {
      "@type": "HowToStep",
      name: "Get Instant Results",
      text: "View your aspect ratio, decimal value, and visual preview. Optionally add screen diagonal for physical size calculations.",
    },
  ],
};

// Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: siteConfig.siteUrl,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Calculators",
      item: `${siteConfig.siteUrl}/calculators`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Aspect Ratio Calculator",
      item: `${siteConfig.siteUrl}/aspect-ratio-calculator`,
    },
  ],
};
---

<Layout title={title} description={description} keywords={keywords}>

  <main class="flex-1">
    <!-- Hero Section -->
    <section
      class="bg-gradient-to-b from-primary-50 to-white dark:from-gray-800 dark:to-gray-900 py-12 lg:py-16"
    >
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Breadcrumb Navigation -->
        <nav class="mb-6 overflow-x-auto" aria-label="Breadcrumb">
          <ol
            class="flex items-center gap-1 sm:gap-2 text-xs sm:text-sm text-gray-600 dark:text-gray-400 whitespace-nowrap"
          >
            <li>
              <a
                href="/"
                class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                >Home</a
              >
            </li>
            <li>
              <svg
                class="w-3 h-3 sm:w-4 sm:h-4 flex-shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path></svg
              >
            </li>
            <li>
              <a
                href="/calculators"
                class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                >Calculators</a
              >
            </li>
            <li>
              <svg
                class="w-3 h-3 sm:w-4 sm:h-4 flex-shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path></svg
              >
            </li>
            <li>
              <span class="text-gray-900 dark:text-gray-100 font-medium"
                >Aspect Ratio Calculator</span
              >
            </li>
          </ol>
        </nav>

        <div class="text-center">
          <h1
            class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-gray-100 mb-4"
          >
            Aspect Ratio Calculator
          </h1>
          <p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
            Free online aspect ratio converter. Calculate image ratio from pixels,
            convert screen ratios, and find dimensions using our aspect ratio formula.
          </p>
        </div>
      </div>
    </section>

    <!-- Calculator Section -->
    <section class="py-12 lg:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <AspectRatioCalculatorComponent client:load />
      </div>
    </section>

    <!-- How to Use -->
    <section class="py-12 lg:py-16 bg-white dark:bg-gray-800">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2
          class="text-2xl font-bold text-gray-900 dark:text-gray-100 text-center mb-8"
        >
          How to Calculate Aspect Ratio
        </h2>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="text-center">
            <div
              class="w-12 h-12 bg-primary-100 dark:bg-primary-900/30 rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <span class="text-xl font-bold text-primary-600 dark:text-primary-400"
                >1</span
              >
            </div>
            <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">
              Choose Your Mode
            </h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">
              Select <strong>Find Ratio</strong> to discover the aspect ratio from
              pixel dimensions, or <strong>New Dimension</strong> to calculate missing
              width/height.
            </p>
          </div>
          <div class="text-center">
            <div
              class="w-12 h-12 bg-primary-100 dark:bg-primary-900/30 rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <span class="text-xl font-bold text-primary-600 dark:text-primary-400"
                >2</span
              >
            </div>
            <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">
              Enter Dimensions
            </h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">
              Input your width and height in pixels, or use quick presets like 16:9,
              21:9, or 9:16 for common screen ratios.
            </p>
          </div>
          <div class="text-center">
            <div
              class="w-12 h-12 bg-primary-100 dark:bg-primary-900/30 rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <span class="text-xl font-bold text-primary-600 dark:text-primary-400"
                >3</span
              >
            </div>
            <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">
              Get Instant Results
            </h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">
              View your aspect ratio, decimal value, and visual preview. Add screen
              diagonal for physical size calculations.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Common Aspect Ratios Reference -->
    <section class="py-12 lg:py-16 bg-gray-50 dark:bg-gray-900">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2
          class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100 text-center mb-4"
        >
          Common Screen Ratios & Image Ratios Chart
        </h2>
        <p
          class="text-gray-600 dark:text-gray-400 text-center mb-8 max-w-2xl mx-auto"
        >
          Complete aspect ratios reference table with formulas. Find the right screen ratio
          for your display, video project, or image dimensions.
        </p>

        <div class="overflow-x-auto">
          <table
            class="w-full bg-white dark:bg-gray-800 rounded-xl shadow-sm overflow-hidden"
          >
            <thead
              class="bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-gray-100"
            >
              <tr>
                <th class="px-4 py-3 text-left text-sm font-semibold">Ratio</th>
                <th class="px-4 py-3 text-left text-sm font-semibold"
                  >Decimal</th
                >
                <th class="px-4 py-3 text-left text-sm font-semibold"
                  >Formula</th
                >
                <th class="px-4 py-3 text-left text-sm font-semibold"
                  >Common Use</th
                >
                <th class="px-4 py-3 text-left text-sm font-semibold hidden sm:table-cell"
                  >Example Resolutions</th
                >
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
              {
                commonRatios.map((item) => (
                  <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
                    <td class="px-4 py-3 text-sm font-semibold text-primary-600 dark:text-primary-400">
                      {item.ratio}
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-400">
                      {item.decimal}
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-400 font-mono text-xs">
                      {item.formula}
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-600 dark:text-gray-400">
                      {item.use}
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-500 dark:text-gray-500 font-mono text-xs hidden sm:table-cell">
                      {item.examples}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <!-- Related Tools -->
        <div class="mt-8">
          <RelatedCalculators
            exclude={["aspect-ratio-calculator"]}
            highlight="resolution-calculator"
            subtitle="Need to calculate pixel density or convert resolutions? Try our other free tools:"
          />
        </div>
      </div>
    </section>

    <!-- Use Cases -->
    <section class="py-12 lg:py-16 bg-white dark:bg-gray-800">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2
          class="text-2xl font-bold text-gray-900 dark:text-gray-100 text-center mb-8"
        >
          When to Use This Aspect Ratio Converter
        </h2>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="bg-gray-50 dark:bg-gray-700 rounded-xl p-6">
            <div
              class="w-10 h-10 bg-blue-100 dark:bg-blue-900/30 rounded-lg flex items-center justify-center mb-4"
            >
              <svg
                class="w-5 h-5 text-blue-600 dark:text-blue-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">
              Video Aspect Ratio
            </h3>
            <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">
              Use our aspect ratio formula to calculate dimensions for YouTube (16:9), TikTok
              (9:16), or cinema (2.39:1) video formats.
            </p>
            <a
              href="/blog/what-is-aspect-ratio-guide"
              class="text-sm text-primary-600 dark:text-primary-400 hover:underline inline-flex items-center"
            >
              Learn more about video ratios
              <svg class="w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
          <div class="bg-gray-50 dark:bg-gray-700 rounded-xl p-6">
            <div
              class="w-10 h-10 bg-green-100 dark:bg-green-900/30 rounded-lg flex items-center justify-center mb-4"
            >
              <svg
                class="w-5 h-5 text-green-600 dark:text-green-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">
              Image Ratio Calculator
            </h3>
            <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">
              Calculate image ratio and maintain proportions when resizing photos.
              Enter width or height to find the other dimension automatically.
            </p>
            <a
              href="/resources/aspect-ratio-guide"
              class="text-sm text-primary-600 dark:text-primary-400 hover:underline inline-flex items-center"
            >
              Complete aspect ratio guide
              <svg class="w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
          <div class="bg-gray-50 dark:bg-gray-700 rounded-xl p-6">
            <div
              class="w-10 h-10 bg-purple-100 dark:bg-purple-900/30 rounded-lg flex items-center justify-center mb-4"
            >
              <svg
                class="w-5 h-5 text-purple-600 dark:text-purple-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">
              Screen Ratio Comparison
            </h3>
            <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">
              Compare screen ratios for monitors and TVs. Convert between 21:9 ultrawide
              and standard 16:9 display aspect ratios.
            </p>
            <a
              href="/monitor-screen-size-calculator"
              class="text-sm text-primary-600 dark:text-primary-400 hover:underline inline-flex items-center"
            >
              Monitor size calculator
              <svg class="w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <FAQSection faqs={faqs} title="Aspect Ratio FAQ: Formulas & Conversions" />
  </main>

  <script
    type="application/ld+json"
    set:html={JSON.stringify(softwareSchema)}
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(howToSchema)}
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />
</Layout>
