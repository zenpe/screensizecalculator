---
import Layout from '../../layouts/Layout.astro';
import PhoneSizeTable from '../../components/PhoneSizeTable.astro';
import { devices, type Device } from '../../data/devices';
import { getCompareToolUrl } from '../../utils/url';
import { siteConfig } from '../../site.config';

const phones = devices
  .filter((device): device is Device => device.category === 'phone')
  .sort((a, b) => b.diagonal - a.diagonal || ((b.phone?.dimensions?.width ?? 0) - (a.phone?.dimensions?.width ?? 0)));

const title = 'Phone Screen Size Chart - Compare Smartphone Display Sizes';
const description = 'Complete phone screen size chart with iPhone, Samsung Galaxy and Google Pixel display size, body width, weight, PPI and handling fit.';
const keywords = 'phone screen size chart, smartphone screen size chart, compare phone screen sizes, phone dimensions chart';
const updatedDate = '2026-06-03';

const largest = phones.slice(0, 5);
const smallest = [...phones].sort((a, b) => a.diagonal - b.diagonal).slice(0, 5);
const narrowest = [...phones].sort((a, b) => (a.phone?.dimensions?.width ?? 999) - (b.phone?.dimensions?.width ?? 999)).slice(0, 5);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Phones', item: `${siteConfig.siteUrl}/phones` },
    { '@type': 'ListItem', position: 3, name: 'Phone Screen Size Chart', item: `${siteConfig.siteUrl}/phones/phone-screen-size-chart` },
  ],
};
---

<Layout title={title} description={description} keywords={keywords} modifiedTime={updatedDate}>
  <main class="flex-1">
    <section class="bg-white dark:bg-gray-900 pt-8 pb-12">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="mb-8 text-sm text-gray-500 dark:text-gray-400" aria-label="Breadcrumb">
          <a href="/" class="hover:text-primary-600">Home</a> / <a href="/phones" class="hover:text-primary-600">Phones</a> / <span class="text-gray-900 dark:text-gray-100">Chart</span>
        </nav>
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-wide text-emerald-700 dark:text-emerald-300 mb-3">Reference chart</p>
          <h1 class="text-4xl sm:text-5xl font-bold text-gray-950 dark:text-white mb-4">Phone Screen Size Chart</h1>
          <p class="text-lg text-gray-600 dark:text-gray-300">
            Compare smartphone screen size, body width, weight and pixel density in one table. Use screen diagonal for display area, and body width for hand comfort.
          </p>
        </div>
      </div>
    </section>

    <section class="pb-12 bg-white dark:bg-gray-900">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <PhoneSizeTable phones={phones} />
      </div>
    </section>

    <section class="py-12 bg-gray-50 dark:bg-gray-950">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-3 gap-5">
          <div class="rounded-xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 p-5">
            <h2 class="font-bold text-gray-950 dark:text-white mb-4">Largest screens</h2>
            <ul class="space-y-3 text-sm text-gray-700 dark:text-gray-300">
              {largest.map(phone => <li class="flex justify-between"><span>{phone.name}</span><strong>{phone.diagonal}"</strong></li>)}
            </ul>
          </div>
          <div class="rounded-xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 p-5">
            <h2 class="font-bold text-gray-950 dark:text-white mb-4">Smallest screens</h2>
            <ul class="space-y-3 text-sm text-gray-700 dark:text-gray-300">
              {smallest.map(phone => <li class="flex justify-between"><span>{phone.name}</span><strong>{phone.diagonal}"</strong></li>)}
            </ul>
          </div>
          <div class="rounded-xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 p-5">
            <h2 class="font-bold text-gray-950 dark:text-white mb-4">Narrowest bodies</h2>
            <ul class="space-y-3 text-sm text-gray-700 dark:text-gray-300">
              {narrowest.map(phone => <li class="flex justify-between"><span>{phone.name}</span><strong>{phone.phone?.dimensions?.width ?? '-'}mm</strong></li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="py-12 bg-gray-950 text-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold mb-3">Need a visual comparison?</h2>
        <p class="text-gray-300 mb-6">Use the compare tool when two phones are close on paper but feel different in hand.</p>
        <a href={getCompareToolUrl('iphone-17-pro-max', 'samsung-galaxy-s26-ultra')} class="inline-flex rounded-lg bg-white px-5 py-3 text-sm font-semibold text-gray-950 hover:bg-gray-100">
          Compare iPhone Pro Max and Galaxy Ultra
        </a>
      </div>
    </section>
  </main>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Layout>
