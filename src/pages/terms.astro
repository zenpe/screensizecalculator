---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const title = 'Terms of Use - ScreenSizeCalculators.com';
const description = 'Terms and conditions for using ScreenSizeCalculators.com free screen calculators. Simple terms for our free online tools.';
const keywords = 'terms of use, terms and conditions, screen calculator terms, free calculator terms';
---

<Layout title={title} description={description} keywords={keywords}>
  <Header />

  <main class="flex-1">
    <!-- Hero Section -->
    <section class="bg-gradient-to-b from-gray-50 to-white dark:from-gray-800/20 dark:to-gray-900 py-12 lg:py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-gray-100 mb-4 text-center">
          Terms of Use
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-300 max-w-3xl mx-auto mb-6 text-center">
          Last updated: December 8, 2025
        </p>
      </div>
    </section>

    <!-- Terms of Use Content -->
    <section class="py-12 lg:py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm p-8 border border-gray-100 dark:border-gray-700">

          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6">Agreement to Terms</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            By accessing ScreenSizeCalculators.com ("the Site"), you agree to these Terms of Use.
            If you disagree with any part, please do not use the Site.
          </p>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            <strong>The short version:</strong> Our calculators are free to use for personal and commercial purposes.
            Results are estimates for reference only—always verify important measurements yourself.
          </p>

          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 mt-8">Our Services</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            ScreenSizeCalculators.com provides free online tools including:
          </p>
          <ul class="list-disc pl-6 text-gray-600 dark:text-gray-400 mb-6 space-y-2">
            <li>Screen size calculators (TV, monitor, phone, projector)</li>
            <li>PPI (pixels per inch) calculator</li>
            <li>Aspect ratio calculator</li>
            <li>Screen size comparison tools</li>
            <li>Educational content about display technology</li>
          </ul>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            All tools are provided free of charge with no registration required.
          </p>

          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 mt-8">Use License</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            You are free to:
          </p>
          <ul class="list-disc pl-6 text-gray-600 dark:text-gray-400 mb-6 space-y-2">
            <li>Use our calculators for personal or commercial purposes</li>
            <li>Share links to our tools with others</li>
            <li>Reference our calculations in your own work</li>
          </ul>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            You may not:
          </p>
          <ul class="list-disc pl-6 text-gray-600 dark:text-gray-400 mb-6 space-y-2">
            <li>Copy or reproduce our website content without attribution</li>
            <li>Use automated tools to scrape or extract data at scale</li>
            <li>Attempt to disrupt or overload our servers</li>
            <li>Frame or embed our tools on other websites without permission</li>
          </ul>

          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 mt-8">Calculator Accuracy & Disclaimer</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            <strong>Important:</strong> Our calculators provide estimates based on standard formulas and typical conditions.
          </p>
          <ul class="list-disc pl-6 text-gray-600 dark:text-gray-400 mb-6 space-y-2">
            <li><strong>Screen dimensions:</strong> Based on diagonal size and aspect ratio. Actual bezels and enclosures vary by manufacturer.</li>
            <li><strong>Viewing distance:</strong> Recommendations based on industry guidelines. Personal preferences may differ.</li>
            <li><strong>PPI calculations:</strong> Mathematical calculations assuming uniform pixel distribution.</li>
            <li><strong>Device specifications:</strong> We strive for accuracy but manufacturer specs may change.</li>
          </ul>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            Always verify critical measurements with actual devices or manufacturer specifications before making purchase decisions.
          </p>

          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 mt-8">Limitation of Liability</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            ScreenSizeCalculators.com is provided "as is" without warranties of any kind. We are not liable for:
          </p>
          <ul class="list-disc pl-6 text-gray-600 dark:text-gray-400 mb-6 space-y-2">
            <li>Decisions made based on our calculator results</li>
            <li>Purchase decisions influenced by our comparisons</li>
            <li>Any inaccuracies in calculations or device data</li>
            <li>Service interruptions or technical errors</li>
          </ul>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            Use our tools as a helpful reference, not as the sole basis for important decisions.
          </p>

          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 mt-8">Third-Party Links</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            Our Site may contain links to external websites (manufacturer pages, retailers, etc.).
            We are not responsible for the content, accuracy, or practices of these third-party sites.
          </p>

          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 mt-8">Intellectual Property</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            The Site design, logo, original content, and calculator interfaces are owned by ScreenSizeCalculators.com.
            Device names, logos, and specifications belong to their respective manufacturers. We are not affiliated
            with or endorsed by any device manufacturer.
          </p>

          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 mt-8">Changes to Terms</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            We may update these Terms occasionally. Continued use of the Site after changes constitutes acceptance
            of the new terms. Check this page periodically for updates.
          </p>

          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 mt-8">Governing Law</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            These Terms are governed by the laws of the United States. Any disputes will be resolved
            in accordance with applicable U.S. law.
          </p>

          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 mt-8">Contact Us</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            Questions about these Terms? Contact us at:
          </p>
          <div class="bg-gray-50 dark:bg-gray-700 p-6 rounded-lg border border-gray-200 dark:border-gray-600">
            <p class="text-gray-600 dark:text-gray-300">
              <strong>Email:</strong> legal@screensizecalculators.com
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>