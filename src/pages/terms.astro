---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Terms of Use - ScreenSizeCalculator.net';
const description = 'Terms and conditions for using ScreenSizeCalculator.net. Read our terms of use before using our calculator tools and services.';
const keywords = 'terms of use, terms and conditions, website terms, service agreement, calculator terms';
---

<Layout title={title} description={description} keywords={keywords}>
  <Header />

  <main class="flex-1">
    <!-- Hero Section -->
    <section class="bg-gradient-to-b from-gray-50 to-white dark:from-gray-800/20 dark:to-gray-900 py-12 lg:py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-gray-100 mb-4 text-center">
          Terms of Use
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-300 max-w-3xl mx-auto mb-6 text-center">
          Last updated: December 2, 2025
        </p>
      </div>
    </section>

    <!-- Terms of Use Content -->
    <section class="py-12 lg:py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm p-8 border border-gray-100 dark:border-gray-700">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6">Introduction</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            Welcome to ScreenSizeCalculator.net ("the Site", "we", "us", or "our"). These Terms of Use ("Terms", "Terms of Use") 
            govern your use of our website and services, including our screen size calculators, available at https://screensizecalculator.net.
          </p>
          
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            By accessing or using the Site, you agree to be bound by these Terms. If you disagree with any part of the terms, 
            then you may not access the Site. These Terms of Use constitute an agreement between you and ScreenSizeCalculator.net.
          </p>
          
          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 mt-8">Use License</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            Unless otherwise stated, ScreenSizeCalculator.net and its licensors own the intellectual property rights for all 
            material on ScreenSizeCalculator.net. All intellectual property rights are reserved.
          </p>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            You are granted a limited, non-exclusive license to access and use the Site for your personal, non-commercial use. 
            This license shall not include any data mining, robots, scraping, or similar data gathering methods.
          </p>
          
          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 mt-8">User Responsibilities</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            By using our Site, you agree to:
          </p>
          <ul class="list-disc pl-6 text-gray-600 dark:text-gray-400 mb-6 space-y-2">
            <li>Use the Site in compliance with all applicable laws and regulations</li>
            <li>Not use the Site for any unlawful or prohibited purpose</li>
            <li>Not attempt to gain unauthorized access to the Site or its related systems</li>
            <li>Provide accurate and current information when required</li>
            <li>Be responsible for maintaining the confidentiality of your account information</li>
            <li>Accept all risks associated with the use of our calculators</li>
          </ul>
          
          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 mt-8">Calculators and Information Accuracy</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            Our screen size calculators are provided for informational and educational purposes only. While we strive 
            to keep the information up to date and correct, we make no representations or warranties of any kind about 
            the completeness, accuracy, reliability, or suitability of the calculators and the information contained therein.
          </p>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            The results from our calculators are estimates based on standard industry formulas and guidelines. 
            Individual results may vary based on specific equipment, viewing conditions, and personal preferences.
          </p>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            You acknowledge that you use our calculators at your own risk. We shall not be liable for any damages 
            arising from your use of our calculators or reliance on the information provided.
          </p>
          
          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 mt-8">Prohibited Uses</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            You are specifically prohibited from:
          </p>
          <ul class="list-disc pl-6 text-gray-600 dark:text-gray-400 mb-6 space-y-2">
            <li>Using the Site for any illegal purpose</li>
            <li>Transmitting any material that infringes third-party rights</li>
            <li>Using the Site in any way that impacts the availability or performance of the Site</li>
            <li>Attempting to interfere with the proper working of the Site</li>
            <li>Harvesting or collecting information about users or visitors</li>
          </ul>
          
          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 mt-8">Limitation of Liability</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            In no event shall ScreenSizeCalculator.net, nor its directors, employees, partners, agents, suppliers, 
            or affiliates, be liable for any indirect, incidental, special, consequential or punitive damages, 
            including without limitation, loss of profits, data, use, goodwill, or other intangible losses, 
            resulting from your access to or use of or inability to access or use the Site.
          </p>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            We do not guarantee that our Site will be uninterrupted or error-free, and we shall not be liable 
            for any loss or damage arising from interruptions or errors in our service.
          </p>
          
          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 mt-8">Disclaimer of Warranties</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            The Site is provided to you completely on an "as is" and "as available" basis, without any warranties 
            of any kind, express or implied.
          </p>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            We make no warranties or representations about the accuracy or completeness of the Site's content 
            or the content of any websites linked to the Site and assume no liability for any errors, 
            omissions, or inaccuracies.
          </p>
          
          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 mt-8">Changes to Terms</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-4">
            We reserve the right, at our sole discretion, to modify or replace these Terms at any time. 
            If a revision is material, we will provide at least 30 days' notice before any new terms take effect.
          </p>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            By continuing to access or use our Service after any revisions become effective, you agree to be 
            bound by the revised terms. If you do not agree to the new terms, you are no longer authorized 
            to use the Service.
          </p>
          
          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 mt-8">Governing Law</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            These Terms shall be governed and construed in accordance with the laws of the United States, 
            without regard to its conflict of law provisions. Our failure to enforce any right or provision 
            of these Terms will not be considered a waiver of those rights. If any provision of these Terms 
            is held to be invalid or unenforceable by a court, the remaining provisions of these Terms will 
            remain in effect.
          </p>
          
          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 mt-8">Contact Us</h2>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            If you have any questions about these Terms of Use, please contact us:
          </p>
          <div class="bg-gray-50 dark:bg-gray-700 p-6 rounded-lg border border-gray-200 dark:border-gray-600">
            <p class="text-gray-600 dark:text-gray-300">
              Through our contact form or support system
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>