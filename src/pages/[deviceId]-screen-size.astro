                      •{" "}
                      {device.diagonal <= 8.5
                        ? "E-reading and portable entertainment"
                        : device.diagonal <= 11
                          ? "Note-taking and media consumption"
                          : "Professional creative work"}
                    </li>
                    {device.diagonal >= 10 && (
                      <li>• Drawing and digital art</li>
                    )}
                    {device.diagonal >= 11 && (
                      <li>• Laptop replacement for light work</li>
                    )}
                    {device.diagonal <= 9 && <li>• Travel and commuting</li>}
                    <li>
                      •{" "}
                      {device.diagonal <= 10
                        ? "Handheld use and reading"
                        : "Desk-based productivity"}
                    </li>
                  </>
                )
              }
              {
                device.category === "projector" && (
                  <>
                    <li>• Home theater and movie nights</li>
                    <li>
                      • Rooms with {fmt((device.diagonal * 1.5) / 12, 0)}+ feet
                      viewing distance
                    </li>
                    {device.diagonal >= 120 && (
                      <li>• True cinema-like experience</li>
                    )}
                    <li>
                      •{" "}
                      {device.diagonal <= 100
                        ? "Casual movie viewing"
                        : "Dedicated home theater rooms"}
                    </li>
                    <li>
                      • Wall width of at least {fmt(dims.width / 12, 1)} feet
                    </li>
                  </>
                )
              }
            </ul>
          </div>

          <!-- Consider If -->
          <div>
            <h3
              class="font-semibold text-amber-600 dark:text-amber-400 mb-3 flex items-center gap-2"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z"
                  clip-rule="evenodd"></path>
              </svg>
              Consider Alternatives If
            </h3>
            <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-400">
              {
                device.category === "phone" && (
                  <>
                    {device.diagonal >= 6.5 && (
                      <li>• You prefer easy one-handed operation</li>
                    )}
                    {device.diagonal <= 6.1 && (
                      <li>• You watch lots of videos or play games</li>
                    )}
                    {device.diagonal >= 6.7 && (
                      <li>• You have smaller hands or pockets</li>
                    )}
                    {device.diagonal <= 6.3 && (
                      <li>• You need maximum screen real estate</li>
                    )}
                    <li>
                      • You prioritize{" "}
                      {device.diagonal <= 6.3
                        ? "larger display"
                        : "compact size"}
                    </li>
                  </>
                )
              }
              {
                device.category === "tv" && (
                  <>
                    {device.diagonal >= 65 && (
                      <li>
                        • Your viewing distance is under{" "}
                        {fmt((device.diagonal * 1.2) / 12, 0)} feet
                      </li>
                    )}
                    {device.diagonal <= 55 && (
                      <li>• You want a more immersive experience</li>
                    )}
                    {device.diagonal >= 75 && (
                      <li>• Your room has limited wall space</li>
                    )}
                    <li>
                      • Your seating is{" "}
                      {device.diagonal <= 55
                        ? "far from the TV (10+ ft)"
                        : "very close (under 6 ft)"}
                    </li>
                    <li>
                      • You need to{" "}
                      {device.diagonal >= 65
                        ? "fit in a smaller space"
                        : "fill a large room"}
                    </li>
                  </>
                )
              }
              {
                device.category === "monitor" && (
                  <>
                    {device.diagonal >= 32 && (
                      <li>• Your desk is less than 30 inches deep</li>
                    )}
                    {device.diagonal <= 24 && (
                      <li>• You need to multitask with many windows</li>
                    )}
                    {device.diagonal >= 27 && (
                      <li>• You have limited desk space</li>
                    )}
                    <li>
                      • You sit{" "}
                      {device.diagonal <= 24
                        ? "far from your screen (3+ ft)"
                        : "very close (under 2 ft)"}
                    </li>
                    <li>
                      • You primarily do{" "}
                      {device.diagonal <= 27
                        ? "detailed creative work"
                        : "simple browsing tasks"}
                    </li>
                  </>
                )
              }
              {
                device.category === "tablet" && (
                  <>
                    {device.diagonal >= 11 && (
                      <li>• Portability is your top priority</li>
                    )}
                    {device.diagonal <= 9 && (
                      <li>• You need a laptop replacement</li>
                    )}
                    {device.diagonal >= 12 && (
                      <li>• You travel frequently with your device</li>
                    )}
                    <li>
                      • You mainly use it for{" "}
                      {device.diagonal <= 10
                        ? "heavy productivity"
                        : "quick reading sessions"}
                    </li>
                    <li>
                      • Weight is a concern (
                      {device.diagonal >= 11
                        ? "larger tablets are heavier"
                        : "consider larger for desk use"}
                      )
                    </li>
                  </>
                )
              }
              {
                device.category === "projector" && (
                  <>
                    <li>• Your room has significant ambient light</li>
                    {device.diagonal >= 120 && (
                      <li>
                        • Your viewing distance is under{" "}
                        {fmt((device.diagonal * 1.2) / 12, 0)} feet
                      </li>
                    )}
                    {device.diagonal <= 100 && (
                      <li>• You want a true cinema experience</li>
                    )}
                    <li>• You need a permanent, always-on display</li>
                    <li>
                      • Your wall space is less than{" "}
                      {fmt(dims.width / 12 + 1, 0)} feet wide
                    </li>
                  </>
                )
              }
            </ul>
          </div>
        </div>

        <!-- Alternative Device Links -->
        {
          relatedDevices.length > 0 && (
            <div class="mt-6 pt-4 border-t border-gray-200 dark:border-gray-700">
              <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">
                <strong>Consider these alternatives:</strong>
              </p>
              <div class="flex flex-wrap gap-2">
                {relatedDevices.slice(0, 4).map((d) => (
                  <a
                    href={`/${d.id}-screen-size`}
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-100 dark:bg-gray-700 rounded-lg text-sm text-gray-700 dark:text-gray-300 hover:bg-primary-100 dark:hover:bg-primary-900/30 hover:text-primary-700 dark:hover:text-primary-300 transition-colors max-w-full"
                  >
                    <span class="truncate max-w-[140px] sm:max-w-[200px]">
                      {d.name}
                    </span>
                    <span class="text-gray-400 dark:text-gray-500 flex-shrink-0">
                      ({d.diagonal}")
                    </span>
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </div>

    <!-- Deep Dive Analysis - Device-specific insights based on attributes -->
    {deviceInsights.length > 0 && (
      <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 overflow-hidden mb-8">
        <div class="p-6">
          <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
            </svg>
            {device.name} Deep Dive
          </h2>
          <div class="space-y-4">
            {deviceInsights.map((insight, index) => (
              <div class="flex gap-3">
                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center">
                  <span class="text-purple-600 dark:text-purple-400 text-sm font-semibold">{index + 1}</span>
                </div>
                <p class="text-gray-700 dark:text-gray-300 text-sm sm:text-base leading-relaxed pt-1">{insight}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    )}

    <!-- Browse Similar Devices -->
    {
      displayRelatedComparisons.length > 0 && (
        <div class="bg-gradient-to-br from-primary-50 to-accent-50 dark:from-primary-900/20 dark:to-accent-900/20 rounded-xl p-6 mb-8 border border-primary-200 dark:border-primary-800">
          <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-4 flex items-center gap-2">
            <svg
              class="w-5 h-5 text-primary-600 dark:text-primary-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"
              />
            </svg>
            Browse Similar {CATEGORY_NAMES[device.category] || "Devices"}
          </h2>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
            {displayRelatedComparisons.map(({ device: related, href, shouldIndex }) => (
              <div class="group bg-white dark:bg-gray-700 rounded-lg p-4 hover:shadow-lg hover:border-primary-400 dark:hover:border-primary-600 transition-all border border-gray-200 dark:border-gray-600">
                <a href={`/${related.id}-screen-size`} class="block mb-2">
                  <p class="text-sm font-semibold text-gray-900 dark:text-gray-100 mb-1 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                    {related.name}
                  </p>
                  <p class="text-xs text-gray-600 dark:text-gray-400">
                    {related.diagonal}" display
                  </p>
                </a>
                {comparisonSeoEnabled && shouldIndex && (
                  <a
                    href={href}
                    class="inline-flex items-center gap-1 text-xs font-medium text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors"
                  >
                    <svg
                      class="w-3 h-3"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                      />
                    </svg>
                    Compare
                  </a>
                )}
              </div>
            ))}
          </div>
          <div class="mt-4 pt-4 border-t border-primary-200 dark:border-primary-800 flex flex-wrap items-center gap-4">
            <a
              href={`/devices/${device.category}s`}
              class="inline-flex items-center gap-1 text-sm font-medium text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors"
            >
              View all {device.category}s
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                />
              </svg>
            </a>
          </div>
        </div>
      )
    }

    <!-- Tips & Recommendations Section -->
    {tips.length > 0 && (
      <div class="mb-8">
        <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-4">
          Tips & Recommendations
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {tips.map((tip) => (
            <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4 hover:shadow-md transition-shadow">
              <div class="flex items-start gap-3">
                <span class="text-2xl flex-shrink-0">{tip.icon}</span>
                <div>
                  <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-1">
                    {tip.title}
                  </h3>
                  <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
                    {tip.content}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- FAQ Section -->
    <div class="mb-6 sm:mb-8">
      <FAQSection faqs={faqs} title="Frequently Asked Questions" compact />
    </div>

    <!-- Device SEO Link Hub -->
    <section class="mb-6 sm:mb-8 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 sm:p-6">
      <div class="mb-5">
        <h2 class="text-lg sm:text-xl font-bold text-gray-900 dark:text-gray-100 mb-2">
          More About {device.name} and Similar Screen Sizes
        </h2>
        <p class="text-sm sm:text-base text-gray-600 dark:text-gray-400">
          Continue from this device page into the most relevant size guides,
          calculators, and nearby {CATEGORY_NAMES[device.category]?.toLowerCase() || "devices"}.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {seoLinkSections.map((section) => (
          <div class="rounded-xl bg-gray-50 dark:bg-gray-900/40 border border-gray-200 dark:border-gray-700 p-4">
            <h3 class="text-sm font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-3">
              {section.title}
            </h3>
            <div class="space-y-2">
              {section.links.map((link) => (
                <a
                  href={link.href}
                  class="block text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                >
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Related Comparisons -->
    {indexedRelatedComparisons.length > 0 && (
      <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl border border-gray-200 dark:border-gray-700">
        <div class="p-4 sm:p-6 border-b border-gray-200 dark:border-gray-700">
          <h2 class="text-lg sm:text-xl font-bold text-gray-900 dark:text-gray-100">
            Related Comparisons
          </h2>
        </div>
        <div class="p-4 sm:p-6">
          <div class="flex flex-wrap gap-2">
            {indexedRelatedComparisons.map(({ device: related, href }) => (
              <a
                href={href}
                class="px-3 py-1.5 bg-white dark:bg-gray-700 rounded-lg text-sm text-gray-700 dark:text-gray-300 hover:bg-primary-50 dark:hover:bg-primary-900/30 hover:text-primary-600 dark:hover:text-primary-400 border border-gray-200 dark:border-gray-600 transition-colors"
              >
                {device.name} vs {related.name}
              </a>
            ))}
          </div>
        </div>
      </div>
    )}

    <!-- Back to Calculator -->
    <div class="mt-8 text-center">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 font-medium transition-colors"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to Screen Size Calculator
      </a>
    </div>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(finalSchema)} />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />
</Layout>
