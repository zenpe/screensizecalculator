          : `${device.name} is large enough to feel more like a compact laptop or drawing canvas, but it is less comfortable for long handheld sessions.`,
      links: [
        { href: "/blog/best-tablet-size-guide", label: "Read the tablet size guide" },
      ],
    },
    {
      title: "Creative and Work Fit",
      summary: isLarge
        ? `${device.name} gives you more room for drawing, split-screen apps, keyboard use, and document work. It makes the most sense if the tablet often sits on a desk or stand.`
        : `${device.name} is easier to carry and hold, but heavy drawing, split-screen, or keyboard workflows may feel tighter than on larger tablets.`,
      links: [
        { href: "/tablet-screen-size-calculator", label: "Calculate tablet dimensions" },
      ],
    },
    {
      title: "Compare Next",
      summary: `Before choosing ${device.name}, compare it with both a smaller and larger tablet class so the trade-off between carry comfort and workspace is clear.`,
      links: [
        { href: "/devices/tablets", label: "Browse tablet sizes" },
        { href: "/resources/common-screen-sizes", label: "See common screen sizes" },
      ],
    },
  ];
};

const getProjectorScenarioDecisionCards = (
  device: Device,
): ScenarioDecisionCard[] => {
  if (device.category !== "projector") return [];

  const minRoomDepth = (device.diagonal * 1.2) / 12;
  const isStarter = device.diagonal <= 100;
  const isTheaterSweetSpot = device.diagonal === 120;
  const isDedicatedRoom = device.diagonal >= 150;

  return [
    {
      title: "Room Requirement",
      summary: isStarter
        ? `${device.name} is the safest projector-screen size for mixed-use rooms and first projector setups.`
        : isTheaterSweetSpot
          ? `${device.name} is the common home-theater target when the room has enough seating distance and light control.`
          : `${device.name} needs a dedicated room mindset: enough wall width, seating depth, brightness, and strong light control.`,
      links: [
        { href: "/blog/100-vs-120-vs-150-inch-projector-screen", label: "Compare 100 vs 120 vs 150 inch screens" },
      ],
    },
    {
      title: "Viewing Distance",
      summary: `Plan for roughly ${fmt(minRoomDepth, 1)} feet or more of viewing distance before ${device.name} starts to feel comfortable rather than overwhelming.`,
      links: [
        { href: "/projector-screen-size-calculator", label: "Calculate projector screen size" },
      ],
    },
    {
      title: "Setup Risk",
      summary: isDedicatedRoom
        ? `${device.name} can look cinematic, but brightness, throw distance, and ambient light become the limiting factors.`
        : `${device.name} is easier to make work than larger screens, but throw ratio and room light still matter more than the diagonal size alone.`,
      links: [
        { href: "/blog/understanding-projector-throw-ratios", label: "Understand projector throw ratios" },
        { href: "/blog/tv-vs-projector-for-living-room", label: "Compare TV vs projector" },
      ],
    },
  ];
};

const getScenarioDecisionCards = (device: Device): ScenarioDecisionCard[] => {
  if (device.category === "phone") return getPhoneScenarioDecisionCards(device);
  if (device.category === "monitor") return getMonitorScenarioDecisionCards(device);
  if (device.category === "tv") return getTvScenarioDecisionCards(device);
  if (device.category === "tablet") return getTabletScenarioDecisionCards(device);
  if (device.category === "projector") return getProjectorScenarioDecisionCards(device);
  return [];
};

const getScenarioDecisionIntro = (device: Device): string => {
  const introByCategory: Record<Device["category"], string> = {
    phone: `Use these quick checks to decide whether ${device.name} fits easier daily carry, bigger-screen use, or a size-up comparison before you buy.`,
    monitor: `Use these quick checks to decide whether ${device.name} fits your desk depth, resolution expectations, and daily work style.`,
    tv: `Use these quick checks to decide whether ${device.name} fits your room, seating distance, and upgrade expectations.`,
    tablet: `Use these quick checks to decide whether ${device.name} fits handheld reading, creative work, or productivity use.`,
    projector: `Use these quick checks to decide whether ${device.name} fits your room depth, throw distance, and light-control limits.`,
  };

  return introByCategory[device.category];
};

const scenarioDecisionCards = getScenarioDecisionCards(device);
const scenarioDecisionIntro = getScenarioDecisionIntro(device);
const deviceSeoRecommendation = getDeviceSeoRecommendation(device.id);

// OG Image URL for this device
const ogImageUrl = `${siteConfig.siteUrl}/og/${device.id}.png`;

// Conditional Schema: Product (with price) or SoftwareApplication (utility tool)
// This ensures 100% clean SEO reports by avoiding "missing offers" warnings for unpriced items.
const isToolSchema = !device.price;

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: device.name,
  description: description,
  image: {
    "@type": "ImageObject",
    url: ogImageUrl,
    width: 1200,
    height: 630,
  },
  brand: {
    "@type": "Brand",
    name: brand || "Universal",
  },
  sku: device.id,
  mpn: device.id,
  ...(device.price
    ? {
        offers: {
          "@type": "Offer",
          price: device.price,
          priceCurrency: "USD",
          availability: "https://schema.org/InStock",
          url: `${siteConfig.siteUrl}/${device.id}-screen-size`,
          priceValidUntil: "2026-12-31",
        },
      }
    : {}),
};

const toolSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: `${pageHeading} Calculator`,
  description: description,
  dateModified: lastUpdated,
  applicationCategory: "UtilityApplication",
  operatingSystem: "All",
  url: `${siteConfig.siteUrl}/${device.id}-screen-size`,
  image: ogImageUrl,
  author: {
    "@type": "Organization",
    name: "Screen Size Calculator",
  },
  about: {
    "@type": "Thing",
    name: device.name,
    description: `Specifications and screen dimensions for ${device.name}.`,
  },
};

const finalSchema = isToolSchema ? toolSchema : productSchema;

// Amazon URL
const getAmazonUrl = () => {
  const searchTerm = device.name
    .toLowerCase()
    .replace(/['"]/g, "")
    .replace(/\s+/g, "+");
  return getAmazonSearchUrl(searchTerm);
};

// Category display name mapping
const CATEGORY_NAMES: Record<string, string> = {
  phone: "Phones",
  tv: "TVs",
  monitor: "Monitors",
  tablet: "Tablets",
  projector: "Projectors",
};

const CATEGORY_PATHS: Record<Device["category"], string> = {
  phone: "/devices/phones",
  tv: "/devices/tvs",
  monitor: "/devices/monitors",
  tablet: "/devices/tablets",
  projector: "/devices/projectors",
};

const CALCULATOR_PATHS: Record<Device["category"], { href: string; label: string }> = {
  phone: { href: "/phone-screen-size-calculator", label: "Phone screen size calculator" },
  tv: { href: "/tv-screen-size-calculator", label: "TV screen size calculator" },
  monitor: { href: "/monitor-screen-size-calculator", label: "Monitor screen size calculator" },
  tablet: { href: "/tablet-screen-size-calculator", label: "Tablet screen size calculator" },
  projector: { href: "/projector-screen-size-calculator", label: "Projector screen size calculator" },
};

const GUIDE_LINKS = {
  phoneChoosing: { href: "/blog/choosing-right-phone-size", label: "Choose the right phone size" },
  phoneSizeRange: { href: "/blog/6-1-vs-6-7-phone-size-real-life", label: "6.1 vs 6.7 inch phone size" },
  phoneProMax: { href: "/blog/is-iphone-pro-max-worth-upgrade", label: "Pro vs Pro Max trade-offs" },
  monitorViewing: { href: "/blog/monitor-viewing-distance-chart", label: "Monitor viewing distance chart" },
  monitor24Vs27: { href: "/blog/24-vs-27-inch-monitor", label: "24 vs 27 inch monitor" },
  monitor27Vs32: { href: "/blog/27-vs-32-monitor-for-office-work", label: "27 vs 32 inch monitor" },
  monitor1440p: { href: "/blog/is-1440p-worth-it-on-27-inch-monitor", label: "1440p on 27 inch monitors" },
  monitorUltrawide: { href: "/blog/34-inch-ultrawide-vs-32-inch-4k-for-productivity", label: "Ultrawide vs 32 inch 4K" },
  monitorDual: { href: "/blog/ultrawide-vs-dual-monitor-setup", label: "Ultrawide vs dual monitors" },
  tvViewing: { href: "/blog/tv-size-by-viewing-distance-chart", label: "TV size by viewing distance" },
  tvMidSize: { href: "/blog/55-vs-65-vs-75-tv-size-at-8-10-feet", label: "55 vs 65 vs 75 inch TV" },
  tvRoom: { href: "/blog/how-to-choose-tv-size-for-room", label: "Choose TV size for your room" },
  tvBedroom: { href: "/blog/best-tv-size-for-bedroom-apartment", label: "Best TV size for bedrooms" },
  tv8k: { href: "/blog/8k-tv-viewing-distance-guide", label: "8K TV viewing distance" },
  tvProjector: { href: "/blog/tv-vs-projector-for-living-room", label: "TV vs projector" },
  tabletSize: { href: "/blog/best-tablet-size-guide", label: "Best tablet size guide" },
  commonSizes: { href: "/resources/common-screen-sizes", label: "Common screen sizes" },
  ppiExplained: { href: "/resources/ppi-explained", label: "PPI explained" },
  projectorSizes: { href: "/blog/100-vs-120-vs-150-inch-projector-screen", label: "100 vs 120 vs 150 inch screen" },
  projectorThrow: { href: "/blog/understanding-projector-throw-ratios", label: "Projector throw ratios" },
} satisfies Record<string, ScenarioDecisionLink>;

const uniqueGuideLinks = (links: ScenarioDecisionLink[]): ScenarioDecisionLink[] => {
  const seen = new Set<string>();
  return links.filter((link) => {
    if (seen.has(link.href)) return false;
    seen.add(link.href);
    return true;
  });
};

const getDeviceGuideLinks = (device: Device): ScenarioDecisionLink[] => {
  const isLargePhone = device.diagonal >= 6.7 || /pro-max|ultra|plus/i.test(device.id);
  const isUltrawideMonitor = device.category === "monitor" && device.ratio >= 21 / 9;

  if (device.category === "phone") {
    return uniqueGuideLinks(
      isLargePhone
        ? [GUIDE_LINKS.phoneProMax, GUIDE_LINKS.phoneSizeRange, GUIDE_LINKS.phoneChoosing]
        : [GUIDE_LINKS.phoneChoosing, GUIDE_LINKS.phoneSizeRange, CALCULATOR_PATHS.phone]
    );
  }

  if (device.category === "monitor") {
    if (isUltrawideMonitor) {
      return uniqueGuideLinks([GUIDE_LINKS.monitorUltrawide, GUIDE_LINKS.monitorDual, GUIDE_LINKS.monitorViewing]);
    }

    if (device.diagonal <= 24) {
      return uniqueGuideLinks([GUIDE_LINKS.monitor24Vs27, GUIDE_LINKS.monitorViewing, GUIDE_LINKS.monitor1440p]);
    }

    if (device.diagonal <= 27) {
      return uniqueGuideLinks([GUIDE_LINKS.monitorViewing, GUIDE_LINKS.monitor27Vs32, GUIDE_LINKS.monitor1440p]);
    }

    return uniqueGuideLinks([GUIDE_LINKS.monitor27Vs32, GUIDE_LINKS.monitorUltrawide, GUIDE_LINKS.monitorViewing]);
  }

  if (device.category === "tv") {
    if (device.diagonal >= 85) {
      return uniqueGuideLinks([GUIDE_LINKS.tvProjector, GUIDE_LINKS.tv8k, GUIDE_LINKS.tvViewing]);
    }

    if (device.diagonal <= 55) {
      return uniqueGuideLinks([GUIDE_LINKS.tvBedroom, GUIDE_LINKS.tvViewing, GUIDE_LINKS.tvRoom]);
    }

    return uniqueGuideLinks([GUIDE_LINKS.tvMidSize, GUIDE_LINKS.tvViewing, GUIDE_LINKS.tvRoom]);
  }

  if (device.category === "tablet") {
    if (device.diagonal >= 12) {
      return uniqueGuideLinks([GUIDE_LINKS.tabletSize, CALCULATOR_PATHS.tablet, GUIDE_LINKS.ppiExplained]);
    }

    return uniqueGuideLinks([GUIDE_LINKS.tabletSize, GUIDE_LINKS.commonSizes, GUIDE_LINKS.ppiExplained]);
  }

  return uniqueGuideLinks([GUIDE_LINKS.projectorSizes, GUIDE_LINKS.projectorThrow, GUIDE_LINKS.tvProjector]);
};

const seoLinkSections = [
  {
    title: "Browse this category",
    links: [
      {
        href: CATEGORY_PATHS[device.category],
        label: `All ${CATEGORY_NAMES[device.category] || "Devices"}`,
      },
      CALCULATOR_PATHS[device.category],
    ],
  },
  {
    title: "Related guides",
    links: getDeviceGuideLinks(device),
  },
  {
    title: "Nearby devices",
    links: relatedDevices.slice(0, 6).map((related) => ({
      href: `/${related.id}-screen-size`,
      label: `${related.name} (${related.diagonal}")`,
    })),
  },
].filter((section) => section.links.length > 0);

// Breadcrumb Schema - using siteUrl from config
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: siteConfig.siteUrl,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Devices",
      item: `${siteConfig.siteUrl}/devices`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: CATEGORY_NAMES[device.category] || "Devices",
      item: `${siteConfig.siteUrl}/devices/${device.category}s`,
    },
    {
      "@type": "ListItem",
      position: 4,
      name: device.name,
      item: `${siteConfig.siteUrl}/${device.id}-screen-size`,
    },
  ],
};
