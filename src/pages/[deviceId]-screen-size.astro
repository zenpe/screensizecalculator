            d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"
          ></path>
        </svg>
        Key Takeaways
      </h2>
      <ul
        class="grid grid-cols-1 md:grid-cols-2 gap-2 md:gap-x-6 md:gap-y-2 text-sm sm:text-base text-gray-700 dark:text-gray-300"
      >
        <li class="flex items-start gap-2">
          <svg
            class="w-4 h-4 sm:w-5 sm:h-5 text-green-500 mt-0.5 flex-shrink-0"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
