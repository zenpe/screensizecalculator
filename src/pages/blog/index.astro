---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const title = "Screen Size Guide & Blog - TV, Monitor & Projector Buying Tips";
const description =
  "Expert guides on choosing the right screen size for your room, understanding viewing distances, projector throw ratios, and display technology comparisons.";
const keywords =
  "screen size guide, tv buying guide, monitor buying guide, projector guide, viewing distance guide, display technology, screen size tips, tv size recommendations, monitor setup guide";

const blogs = await getCollection("blog");
// Sort blogs by date (newest first)
const sortedBlogs = blogs.sort(
  (a, b) =>
    new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
);

const guideClusters = [
  {
    name: "Phone Size Guides",
    description:
      "Pocket comfort, one-handed use, Pro Max trade-offs, and real-world phone size decisions.",
    href: "/phones",
    slugs: [
      "choosing-right-phone-size",
      "6-1-vs-6-7-phone-size-real-life",
      "is-iphone-pro-max-worth-upgrade",
    ],
  },
  {
    name: "Monitor Size Guides",
    description:
      "Desk depth, coding layouts, 1440p vs 4K, ultrawide setups, and productivity decisions.",
    href: "/devices/monitors",
    slugs: [
      "monitor-viewing-distance-chart",
      "27-vs-32-monitor-for-office-work",
      "34-inch-ultrawide-vs-32-inch-4k-for-productivity",
      "is-1440p-worth-it-on-27-inch-monitor",
    ],
  },
  {
    name: "TV Viewing Distance",
    description:
      "Room size, seating distance, 55 vs 65 vs 75 inch choices, and 4K vs 8K context.",
    href: "/devices/tvs",
    slugs: [
      "tv-size-by-viewing-distance-chart",
      "55-vs-65-vs-75-tv-size-at-8-10-feet",
      "how-to-choose-tv-size-for-room",
      "4k-vs-8k-viewing-distance",
    ],
  },
  {
    name: "Projector Room Fit",
    description:
      "Projector screen size, throw distance, 100 vs 120 vs 150 inch screens, and living-room trade-offs.",
    href: "/devices/projectors",
    slugs: [
      "100-vs-120-vs-150-inch-projector-screen",
      "understanding-projector-throw-ratios",
      "tv-vs-projector-for-living-room",
    ],
  },
];

const blogBySlug = new Map(sortedBlogs.map((post) => [post.slug, post]));
const clustersWithPosts = guideClusters.map((cluster) => ({
  ...cluster,
  posts: cluster.slugs
    .map((slug) => blogBySlug.get(slug))
    .filter((post): post is (typeof sortedBlogs)[number] => Boolean(post)),
}));

// Calculate read time estimate
function estimateReadTime(content: string) {
  const wordsPerMinute = 200;
  const wordCount = content.split(/\s+/).length;
  const minutes = Math.ceil(wordCount / wordsPerMinute);
  return `${minutes} min read`;
}
---

<Layout title={title} description={description} keywords={keywords}>
  <main class="flex-1">
    <!-- Hero Section -->
    <section
      class="bg-gradient-to-b from-primary-50 to-white py-12 lg:py-16 dark:from-gray-800 dark:to-gray-900"
    >
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1
          class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white mb-4"
        >
          Screen Size Guides & Blog
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
          Expert advice on choosing the perfect TV, monitor, or projector for
          your space.
        </p>
      </div>
    </section>

    <!-- Topic Clusters -->
    <section class="py-12 lg:py-16 bg-white dark:bg-gray-900">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mb-8">
          <p class="text-sm font-semibold text-primary-600 dark:text-primary-400 uppercase tracking-wide mb-2">
            Start by topic
          </p>
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-3">
            Screen Size Guide Hubs
          </h2>
          <p class="text-gray-600 dark:text-gray-300">
            Use these clusters to move from broad size questions into calculators,
            device pages, and practical buying guides.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          {
            clustersWithPosts.map((cluster) => (
              <section class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/60 p-6">
                <div class="flex items-start justify-between gap-4 mb-4">
                  <div>
                    <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">
                      {cluster.name}
                    </h3>
                    <p class="text-sm text-gray-600 dark:text-gray-300">
                      {cluster.description}
                    </p>
                  </div>
                  <a
                    href={cluster.href}
                    class="shrink-0 text-sm font-semibold text-primary-600 dark:text-primary-400 hover:underline"
                  >
                    Browse
                  </a>
                </div>
                <div class="space-y-3">
                  {cluster.posts.map((post) => (
                    <a
                      href={`/blog/${post.slug}`}
                      class="block rounded-xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 p-4 hover:border-primary-300 dark:hover:border-primary-600 transition-colors"
                    >
                      <span class="text-xs font-medium text-primary-600 dark:text-primary-400">
                        {post.data.category}
                      </span>
                      <h4 class="mt-1 font-semibold text-gray-900 dark:text-white">
                        {post.data.title}
                      </h4>
                      <p class="mt-1 text-sm text-gray-600 dark:text-gray-400 line-clamp-2">
                        {post.data.description}
                      </p>
                    </a>
                  ))}
                </div>
              </section>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Blog Posts Grid -->
    <section class="py-12 lg:py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mb-8">
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-3">
            Latest Screen Size Articles
          </h2>
          <p class="text-gray-600 dark:text-gray-300">
            Detailed guides for screen dimensions, viewing distance, pixel density,
            and practical device-size decisions.
          </p>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {
            sortedBlogs.map((post) => (
              <article class="bg-white dark:bg-gray-800 rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-shadow">
                <div class="p-6">
                  <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-medium text-primary-600 bg-primary-50 dark:text-primary-400 dark:bg-gray-700 px-3 py-1 rounded-full">
                      {post.data.category}
                    </span>
                    <span class="text-xs text-gray-500 dark:text-gray-400">
                      {estimateReadTime(post.body)}
                    </span>
                  </div>
                  <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-3 hover:text-primary-600 dark:hover:text-primary-400">
                    <a href={`/blog/${post.slug}`}>{post.data.title}</a>
                  </h2>
                  <p class="text-gray-600 dark:text-gray-300 text-sm mb-4">
                    {post.data.description}
                  </p>
                  <div class="flex items-center justify-between">
                    <time
                      class="text-xs text-gray-500 dark:text-gray-400"
                      datetime={post.data.pubDate}
                    >
                      {new Date(post.data.pubDate).toLocaleDateString("en-US", {
                        month: "long",
                        day: "numeric",
                        year: "numeric",
                      })}
                    </time>
                    <a
                      href={`/blog/${post.slug}`}
                      class="text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-500 font-medium text-sm flex items-center gap-1"
                    >
                      Read More
                      <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M9 5l7 7-7 7"
                        />
                      </svg>
                    </a>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section
      class="bg-gradient-to-br from-primary-700 to-primary-900 py-12 lg:py-16"
    >
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">
          Ready to Calculate Your Perfect Screen Size?
        </h2>
        <p class="text-gray-300 mb-8 max-w-2xl mx-auto">
          Use our free calculator with viewing distance recommendations and PPI
          analysis.
        </p>
        <a
          href="/#calculator"
          class="inline-flex items-center gap-2 bg-white hover:bg-gray-100 text-primary-700 font-semibold px-6 py-3 rounded-lg transition-colors"
        >
          Try Calculator Now
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
      </div>
    </section>
  </main>
</Layout>
