---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const title = 'Screen Size Guide & Blog - TV, Monitor & Projector Buying Tips';
const description = 'Expert guides on choosing the right screen size for your room, understanding viewing distances, projector throw ratios, and display technology comparisons.';

const blogs = await getCollection('blog');
// Sort blogs by date (newest first)
const sortedBlogs = blogs.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// Calculate read time estimate
function estimateReadTime(content: string) {
  const wordsPerMinute = 200;
  const wordCount = content.split(/\s+/).length;
  const minutes = Math.ceil(wordCount / wordsPerMinute);
  return `${minutes} min read`;
}
---

<Layout title={title} description={description}>
  <Header />

  <main class="flex-1">
    <!-- Hero Section -->
    <section class="bg-gradient-to-b from-primary-50 to-white py-12 lg:py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
          Screen Size Guides & Blog
        </h1>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Expert advice on choosing the perfect TV, monitor, or projector for your space.
        </p>
      </div>
    </section>

    <!-- Blog Posts Grid -->
    <section class="py-12 lg:py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {sortedBlogs.map((post) => (
            <article class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-shadow">
              <div class="p-6">
                <div class="flex items-center justify-between mb-3">
                  <span class="text-xs font-medium text-primary-600 bg-primary-50 px-3 py-1 rounded-full">
                    {post.data.category}
                  </span>
                  <span class="text-xs text-gray-500">{estimateReadTime(post.body)}</span>
                </div>
                <h2 class="text-xl font-bold text-gray-900 mb-3 hover:text-primary-600">
                  <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
                </h2>
                <p class="text-gray-600 text-sm mb-4">
                  {post.data.description}
                </p>
                <div class="flex items-center justify-between">
                  <time class="text-xs text-gray-500" datetime={post.data.pubDate}>
                    {new Date(post.data.pubDate).toLocaleDateString('en-US', {
                      month: 'long',
                      day: 'numeric',
                      year: 'numeric'
                    })}
                  </time>
                  <a
                    href={`/blog/${post.slug}/`}
                    class="text-primary-600 hover:text-primary-700 font-medium text-sm flex items-center gap-1"
                  >
                    Read More
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="bg-primary-600 py-12 lg:py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">
          Ready to Calculate Your Perfect Screen Size?
        </h2>
        <p class="text-primary-100 mb-8 max-w-2xl mx-auto">
          Use our free calculator with viewing distance recommendations and PPI analysis.
        </p>
        <a
          href="/#calculator"
          class="inline-flex items-center gap-2 bg-white text-primary-600 font-semibold px-6 py-3 rounded-lg hover:bg-primary-50 transition-colors"
        >
          Try Calculator Now
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
