---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import ComparisonVisualizer from "../../components/ComparisonVisualizer.tsx";
import ShareButtons from "../../components/ShareButtons.astro";
import {
  devices,
  getDeviceById,
  isValidComparison,
  calculateDimensions,
  calculateArea,
  calculatePercentageDifference,
} from "../../data/devices";
import {
  getAmazonSearchUrl,
  siteConfig,
  contentDates,
} from "../../site.config";
import { getComparisonUrl } from "../../utils/url";
import {
  generateComparisonDescription,
  generateUseCaseScenarios,
  generateRecommendations,
  generateComparisonFAQ,
} from "../../utils/comparisonContent";

// Generate valid comparison pairs with alphabetical deduplication (SEO: single canonical URL)
export function getStaticPaths() {
  const paths = [];

  for (let i = 0; i < devices.length; i++) {
    for (let j = i + 1; j < devices.length; j++) {
      const deviceA = devices[i];
      const deviceB = devices[j];

      // Check if this comparison is valid based on category rules
      if (isValidComparison(deviceA.category, deviceB.category)) {
        // Enforce alphabetical order for URL slug to prevent duplicates
        const [first, second] =
          deviceA.id < deviceB.id ? [deviceA, deviceB] : [deviceB, deviceA];

        const slug = `${first.id}-vs-${second.id}`;
        paths.push({
          params: { slug },
          props: { deviceA: first, deviceB: second },
        });
      }
    }
  }

  return paths;
}

// Get props from static paths (alphabetically ordered)
const { deviceA, deviceB } = Astro.props;

// Calculate comparison data
const areaA = calculateArea(deviceA.diagonal, deviceA.ratio);
const areaB = calculateArea(deviceB.diagonal, deviceB.ratio);
const dimsA = calculateDimensions(deviceA.diagonal, deviceA.ratio);
const dimsB = calculateDimensions(deviceB.diagonal, deviceB.ratio);

// Smart Display Logic: Sort by screen size for better UX
// Primary device = larger screen, Secondary device = smaller screen
const primaryDevice = areaA >= areaB ? deviceA : deviceB;
const secondaryDevice = areaA < areaB ? deviceA : deviceB;
const primaryArea = Math.max(areaA, areaB);
const secondaryArea = Math.min(areaA, areaB);
const primaryDims = primaryDevice === deviceA ? dimsA : dimsB;
const secondaryDims = secondaryDevice === deviceA ? dimsA : dimsB;

// Calculate percentage difference
const percentLarger = ((primaryArea - secondaryArea) / secondaryArea) * 100;

// Format number helper
const formatNum = (num: number, decimals = 1) => num.toFixed(decimals);

// SEO metadata
const title = `${primaryDevice.name} vs ${secondaryDevice.name} Screen Size Comparison`;
const description = `Compare screen sizes between ${primaryDevice.name} (${primaryDevice.diagonal}") and ${secondaryDevice.name} (${secondaryDevice.diagonal}"). See visual overlay comparison and exact dimensions.`;
const keywords = `${primaryDevice.name} vs ${secondaryDevice.name}, screen size comparison, ${primaryDevice.name} screen size, ${secondaryDevice.name} screen size, display comparison`;

// Amazon search URLs (generic searches)
const getAmazonUrl = (device: typeof deviceA) => {
  const searchTerm = device.name
    .toLowerCase()
    .replace(/['"]/g, "")
    .replace(/\s+/g, "+");
  return getAmazonSearchUrl(searchTerm);
};

// Generate unique content
const comparisonDescription = generateComparisonDescription(
  primaryDevice,
  secondaryDevice,
  primaryArea,
  secondaryArea,
  primaryDims,
  secondaryDims,
);

const useCaseScenarios = generateUseCaseScenarios(
  primaryDevice,
  secondaryDevice,
);
const recommendations = generateRecommendations(
  primaryDevice,
  secondaryDevice,
  primaryArea,
  secondaryArea,
);
const comparisonFAQs = generateComparisonFAQ(
  primaryDevice,
  secondaryDevice,
  primaryArea,
  secondaryArea,
  primaryDims,
  secondaryDims,
);

// Calculate display date: MAX(primaryDevice.updatedAt, secondaryDevice.updatedAt, contentDates.deviceContent)
// This ensures freshness when either device data or page template is updated
const toISO8601 = (date: string): string => {
  if (date.includes("T")) return date;
  return `${date}T10:00:00+08:00`;
};

const deviceDates = [primaryDevice.updatedAt, secondaryDevice.updatedAt]
  .filter((d): d is string => Boolean(d))
  .map((d) => new Date(d).getTime());
const templateDate = new Date(contentDates.deviceContent).getTime();
const allDates = [...deviceDates, templateDate];
const displayDateStr = new Date(Math.max(...allDates))
  .toISOString()
  .split("T")[0];
const lastUpdated = toISO8601(displayDateStr);

// FAQ Schema for SEO
const faqSchema =
  comparisonFAQs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: comparisonFAQs.map((faq) => ({
          "@type": "Question",
          name: faq.question,
          acceptedAnswer: {
            "@type": "Answer",
            text: faq.answer,
          },
        })),
      }
    : null;

// Breadcrumb Schema for SEO
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: siteConfig.siteUrl,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Comparisons",
      item: `${siteConfig.siteUrl}/comparison`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: `${primaryDevice.name} vs ${secondaryDevice.name}`,
      item: `${siteConfig.siteUrl}/comparison/${deviceA.id}-vs-${deviceB.id}`,
    },
  ],
};

// OG Image URL - use primary device's image
const ogImageUrl = `${siteConfig.siteUrl}/og/${primaryDevice.id}.png`;

// Conditional Schema: Product (with price) or SoftwareApplication (utility tool)
const isToolSchema = !primaryDevice.price && !secondaryDevice.price;

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: primaryDevice.name,
  description: description,
  dateModified: lastUpdated,
  image: {
    "@type": "ImageObject",
    url: ogImageUrl,
    width: 1200,
    height: 630,
  },
  brand: {
    "@type": "Brand",
    name: primaryDevice.name.split(" ")[0],
  },
  sku: primaryDevice.id,
  ...(primaryDevice.price
    ? {
        offers: {
          "@type": "Offer",
          price: primaryDevice.price,
          priceCurrency: "USD",
          availability: "https://schema.org/InStock",
          url: `${siteConfig.siteUrl}/comparison/${deviceA.id}-vs-${deviceB.id}`,
          priceValidUntil: "2026-12-31",
        },
      }
    : {}),
  isRelatedTo: {
    "@type": "Product",
    name: secondaryDevice.name,
    description: `Comparison device: ${secondaryDevice.name}`,
    sku: secondaryDevice.id,
    ...(secondaryDevice.price
      ? {
          offers: {
            "@type": "Offer",
            price: secondaryDevice.price,
            priceCurrency: "USD",
          },
        }
      : {}),
  },
};

const toolSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: `${primaryDevice.name} vs ${secondaryDevice.name} Screen Size Comparison`,
  description: description,
  dateModified: lastUpdated,
  applicationCategory: "UtilityApplication",
  operatingSystem: "All",
  url: `${siteConfig.siteUrl}/comparison/${deviceA.id}-vs-${deviceB.id}`,
  image: ogImageUrl,
  author: {
    "@type": "Organization",
    name: "Screen Size Calculator",
  },
};

const finalSchema = isToolSchema ? toolSchema : productSchema;
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  ogImage={`/og/${primaryDevice.id}.png`}
  modifiedTime={lastUpdated}
>
  <Header />

  <main class="max-w-6xl mx-auto px-3 sm:px-4 py-6 sm:py-8">
    <!-- Breadcrumb Navigation -->
    <nav class="mb-4 sm:mb-6 overflow-x-auto" aria-label="Breadcrumb">
      <ol
        class="flex items-center gap-1 sm:gap-2 text-xs sm:text-sm text-gray-600 dark:text-gray-400 whitespace-nowrap"
      >
        <li>
          <a
            href="/"
            class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
            >Home</a
          >
        </li>
        <li>
          <svg
            class="w-3 h-3 sm:w-4 sm:h-4 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"></path></svg
          >
        </li>
        <li>
          <a
            href="/comparison"
            class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
            >Comparisons</a
          >
        </li>
        <li>
          <svg
            class="w-3 h-3 sm:w-4 sm:h-4 flex-shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"></path></svg
          >
        </li>
        <li
          class="font-semibold text-gray-900 dark:text-gray-100 truncate max-w-[200px] sm:max-w-none"
        >
          {primaryDevice.name} vs {secondaryDevice.name}
        </li>
      </ol>
    </nav>

    <!-- Page Header -->
    <div class="text-center mb-6 sm:mb-8">
      <h1
        class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-3 sm:mb-4 px-2"
      >
        {primaryDevice.name} vs {secondaryDevice.name} Screen Size Comparison
      </h1>
      <p
        class="text-sm sm:text-base lg:text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto px-2 mb-4"
      >
        Visual comparison showing how the {primaryDevice.name} ({
          primaryDevice.diagonal
        }") and
        {secondaryDevice.name} ({secondaryDevice.diagonal}") screens compare in
        actual size.
      </p>
      <div class="flex justify-center">
        <ShareButtons
          title={`${primaryDevice.name} vs ${secondaryDevice.name} Screen Size Comparison`}
          url={`${siteConfig.siteUrl}/comparison/${deviceA.id}-vs-${deviceB.id}`}
          description={description}
        />
      </div>
      <p
        class="text-xs text-gray-500 dark:text-gray-400 mt-3 flex items-center justify-center gap-1"
      >
        <svg
          class="w-3.5 h-3.5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
          ></path>
        </svg>
        Last updated: {
          new Date(lastUpdated).toLocaleDateString("en-US", {
            month: "short",
            year: "numeric",
          })
        }
      </p>
    </div>

    <!-- Detailed Comparison Description -->
    <div
      class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 p-4 sm:p-6 mb-6 sm:mb-8"
    >
      <h2
        class="text-lg sm:text-xl font-bold text-gray-900 dark:text-gray-100 mb-3 sm:mb-4"
      >
        Detailed Comparison Analysis
      </h2>
      <div
        class="prose prose-gray dark:prose-invert max-w-none prose-sm sm:prose-base"
      >
        <p
          class="text-gray-700 dark:text-gray-300 leading-relaxed text-sm sm:text-base"
        >
          {comparisonDescription}
        </p>
      </div>
    </div>

    <!-- Visualizer Component -->
    <div class="mb-6 sm:mb-8">
      <ComparisonVisualizer
        client:load
        deviceA={primaryDevice}
        deviceB={secondaryDevice}
      />
    </div>

    <!-- The Verdict Section -->
    <div
      class="bg-gradient-to-r from-primary-600 to-primary-700 rounded-xl p-4 sm:p-6 mb-6 sm:mb-8 text-white"
    >
      <h2 class="text-lg sm:text-xl font-bold mb-2 sm:mb-3">The Verdict</h2>
      <p class="text-sm sm:text-base lg:text-lg">
        {
          percentLarger > 0 ? (
            <>
              The <strong>{primaryDevice.name}</strong> is{" "}
              <strong class="text-accent-300">
                {formatNum(percentLarger)}% larger
              </strong>{" "}
              than the <strong>{secondaryDevice.name}</strong> in screen area.
            </>
          ) : (
            <>
              Both devices have <strong>identical screen areas</strong>, though
              their aspect ratios may differ.
            </>
          )
        }
      </p>
      <div class="mt-4 grid grid-cols-2 gap-2 sm:gap-4 text-sm">
        <div class="bg-white/10 rounded-lg p-2 sm:p-3">
          <p
            class="text-white/70 text-[10px] sm:text-xs uppercase tracking-wide mb-1 truncate"
          >
            {primaryDevice.name}
          </p>
          <p class="font-bold text-sm sm:text-base">
            {formatNum(primaryArea)} sq in
          </p>
        </div>
        <div class="bg-white/10 rounded-lg p-2 sm:p-3">
          <p
            class="text-white/70 text-[10px] sm:text-xs uppercase tracking-wide mb-1 truncate"
          >
            {secondaryDevice.name}
          </p>
          <p class="font-bold text-sm sm:text-base">
            {formatNum(secondaryArea)} sq in
          </p>
        </div>
      </div>
    </div>

    <!-- View Individual Device Pages -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4 mb-6 sm:mb-8">
      <a
        href={`/${primaryDevice.id}-screen-size`}
        class="flex items-center justify-between bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 hover:shadow-lg hover:border-primary-400 dark:hover:border-primary-600 transition-all group"
      >
        <div>
          <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">
            View full specs
          </p>
          <p
            class="font-semibold text-gray-900 dark:text-gray-100 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors"
          >
            {primaryDevice.name} Screen Size
          </p>
        </div>
        <svg
          class="w-5 h-5 text-gray-400 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      <a
        href={`/${secondaryDevice.id}-screen-size`}
        class="flex items-center justify-between bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 hover:shadow-lg hover:border-primary-400 dark:hover:border-primary-600 transition-all group"
      >
        <div>
          <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">
            View full specs
          </p>
          <p
            class="font-semibold text-gray-900 dark:text-gray-100 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors"
          >
            {secondaryDevice.name} Screen Size
          </p>
        </div>
        <svg
          class="w-5 h-5 text-gray-400 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>

    <!-- Use Case Scenarios -->
    {
      useCaseScenarios.length > 0 && (
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 p-4 sm:p-6 mb-6 sm:mb-8">
          <h2 class="text-lg sm:text-xl font-bold text-gray-900 dark:text-gray-100 mb-3 sm:mb-4">
            Use Case Comparison
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
            {useCaseScenarios.map((scenario) => (
              <div class="bg-gray-50 dark:bg-gray-900 rounded-lg p-3 sm:p-4">
                <div class="flex items-center gap-2 mb-2 sm:mb-3">
                  <span class="text-xl sm:text-2xl">{scenario.icon}</span>
                  <h3 class="font-semibold text-sm sm:text-base text-gray-900 dark:text-gray-100">
                    {scenario.title}
                  </h3>
                </div>
                <p class="text-[10px] sm:text-xs text-gray-500 dark:text-gray-400 mb-2 sm:mb-3">
                  {scenario.description}
                </p>
                <div class="grid grid-cols-2 gap-1.5 sm:gap-2 text-sm">
                  <div class="bg-white dark:bg-gray-800 rounded p-1.5 sm:p-2">
                    <div class="text-[10px] sm:text-xs text-gray-500 dark:text-gray-400 mb-0.5 sm:mb-1 truncate">
                      {primaryDevice.name}
                    </div>
                    <div class="font-medium text-xs sm:text-sm text-gray-900 dark:text-gray-100">
                      {scenario.deviceA}
                    </div>
                  </div>
                  <div class="bg-white dark:bg-gray-800 rounded p-1.5 sm:p-2">
                    <div class="text-[10px] sm:text-xs text-gray-500 dark:text-gray-400 mb-0.5 sm:mb-1 truncate">
                      {secondaryDevice.name}
                    </div>
                    <div class="font-medium text-xs sm:text-sm text-gray-900 dark:text-gray-100">
                      {scenario.deviceB}
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )
    }

    <!-- Which Should You Choose -->
    {
      (recommendations.larger.length > 0 ||
        recommendations.smaller.length > 0) && (
        <div class="bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 rounded-xl p-4 sm:p-6 mb-6 sm:mb-8">
          <h2 class="text-lg sm:text-xl font-bold text-gray-900 dark:text-gray-100 mb-4 sm:mb-6 text-center">
            Which Should You Choose?
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
            {recommendations.larger.length > 0 && (
              <div class="bg-white dark:bg-gray-800 rounded-lg p-3 sm:p-5">
                <div class="flex items-center gap-2 sm:gap-3 mb-3 sm:mb-4">
                  <div class="w-8 h-8 sm:w-10 sm:h-10 bg-green-100 dark:bg-green-900/30 rounded-full flex items-center justify-center flex-shrink-0">
                    <svg
                      class="w-4 h-4 sm:w-6 sm:h-6 text-green-600 dark:text-green-400"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M5 13l4 4L19 7"
                      />
                    </svg>
                  </div>
                  <h3 class="font-bold text-sm sm:text-base text-gray-900 dark:text-gray-100">
                    Choose{" "}
                    {primaryArea > secondaryArea
                      ? primaryDevice.name
                      : secondaryDevice.name}
                  </h3>
                </div>
                <ul class="space-y-1.5 sm:space-y-2">
                  {recommendations.larger.map((rec) => (
                    <li class="flex items-start gap-2 text-xs sm:text-sm text-gray-700 dark:text-gray-300">
                      <span class="text-green-500 mt-0.5">•</span>
                      <span>{rec}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {recommendations.smaller.length > 0 && (
              <div class="bg-white dark:bg-gray-800 rounded-lg p-3 sm:p-5">
                <div class="flex items-center gap-2 sm:gap-3 mb-3 sm:mb-4">
                  <div class="w-8 h-8 sm:w-10 sm:h-10 bg-blue-100 dark:bg-blue-900/30 rounded-full flex items-center justify-center flex-shrink-0">
                    <svg
                      class="w-4 h-4 sm:w-6 sm:h-6 text-blue-600 dark:text-blue-400"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M5 13l4 4L19 7"
                      />
                    </svg>
                  </div>
                  <h3 class="font-bold text-sm sm:text-base text-gray-900 dark:text-gray-100">
                    Choose{" "}
                    {primaryArea < secondaryArea
                      ? primaryDevice.name
                      : secondaryDevice.name}
                  </h3>
                </div>
                <ul class="space-y-1.5 sm:space-y-2">
                  {recommendations.smaller.map((rec) => (
                    <li class="flex items-start gap-2 text-xs sm:text-sm text-gray-700 dark:text-gray-300">
                      <span class="text-blue-500 mt-0.5">•</span>
                      <span>{rec}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>
      )
    }

    <!-- Detailed Specs Comparison -->
    <div
      class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 overflow-hidden mb-8"
    >
      <div class="p-4 sm:p-6">
        <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-4">
          Detailed Specifications
        </h2>

        <!-- Mobile: Card Layout -->
        <div class="block sm:hidden space-y-3">
          <!-- Diagonal -->
          <div class="bg-gray-50 dark:bg-gray-900 rounded-lg p-3">
            <div
              class="text-xs text-gray-500 dark:text-gray-400 mb-2 font-medium"
            >
              Diagonal
            </div>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <div
                  class="text-[10px] text-gray-400 dark:text-gray-500 truncate"
                >
                  {primaryDevice.name}
                </div>
                <div class="font-semibold text-gray-900 dark:text-gray-100">
                  {primaryDevice.diagonal}"
                </div>
              </div>
              <div>
                <div
                  class="text-[10px] text-gray-400 dark:text-gray-500 truncate"
                >
                  {secondaryDevice.name}
                </div>
                <div class="font-semibold text-gray-900 dark:text-gray-100">
                  {secondaryDevice.diagonal}"
                </div>
              </div>
            </div>
            <div class="text-[10px] text-gray-500 dark:text-gray-400 mt-1">
              Diff: {
                formatNum(
                  Math.abs(primaryDevice.diagonal - secondaryDevice.diagonal),
                  1,
                )
              }"
            </div>
          </div>

          <!-- Dimensions -->
          <div class="bg-gray-50 dark:bg-gray-900 rounded-lg p-3">
            <div
              class="text-xs text-gray-500 dark:text-gray-400 mb-2 font-medium"
            >
              Dimensions (W × H)
            </div>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <div
                  class="text-[10px] text-gray-400 dark:text-gray-500 truncate"
                >
                  {primaryDevice.name}
                </div>
                <div
                  class="font-semibold text-gray-900 dark:text-gray-100 text-sm"
                >
                  {formatNum(primaryDims.width, 1)}" × {
                    formatNum(primaryDims.height, 1)
                  }"
                </div>
              </div>
              <div>
                <div
                  class="text-[10px] text-gray-400 dark:text-gray-500 truncate"
                >
                  {secondaryDevice.name}
                </div>
                <div
                  class="font-semibold text-gray-900 dark:text-gray-100 text-sm"
                >
                  {formatNum(secondaryDims.width, 1)}" × {
                    formatNum(secondaryDims.height, 1)
                  }"
                </div>
              </div>
            </div>
          </div>

          <!-- Screen Area -->
          <div class="bg-gray-50 dark:bg-gray-900 rounded-lg p-3">
            <div
              class="text-xs text-gray-500 dark:text-gray-400 mb-2 font-medium"
            >
              Screen Area
