---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ComparisonVisualizer from '../../components/ComparisonVisualizer.tsx';
import {
  devices,
  getDeviceById,
  isValidComparison,
  calculateDimensions,
  calculateArea,
  calculatePercentageDifference
} from '../../data/devices';
import { getAmazonSearchUrl, siteConfig } from '../../site.config';
import { getComparisonUrl } from '../../utils/url';

// Generate valid comparison pairs with alphabetical deduplication (SEO: single canonical URL)
export function getStaticPaths() {
  const paths = [];

  for (let i = 0; i < devices.length; i++) {
    for (let j = i + 1; j < devices.length; j++) {
      const deviceA = devices[i];
      const deviceB = devices[j];

      // Check if this comparison is valid based on category rules
      if (isValidComparison(deviceA.category, deviceB.category)) {
        // Enforce alphabetical order for URL slug to prevent duplicates
        const [first, second] = deviceA.id < deviceB.id
          ? [deviceA, deviceB]
          : [deviceB, deviceA];

        const slug = `${first.id}-vs-${second.id}`;
        paths.push({
          params: { slug },
          props: { deviceA: first, deviceB: second },
        });
      }
    }
  }

  return paths;
}

// Get props from static paths (alphabetically ordered)
const { deviceA, deviceB } = Astro.props;

// Calculate comparison data
const areaA = calculateArea(deviceA.diagonal, deviceA.ratio);
const areaB = calculateArea(deviceB.diagonal, deviceB.ratio);
const dimsA = calculateDimensions(deviceA.diagonal, deviceA.ratio);
const dimsB = calculateDimensions(deviceB.diagonal, deviceB.ratio);

// Smart Display Logic: Sort by screen size for better UX
// Primary device = larger screen, Secondary device = smaller screen
const primaryDevice = areaA >= areaB ? deviceA : deviceB;
const secondaryDevice = areaA < areaB ? deviceA : deviceB;
const primaryArea = Math.max(areaA, areaB);
const secondaryArea = Math.min(areaA, areaB);
const primaryDims = primaryDevice === deviceA ? dimsA : dimsB;
const secondaryDims = secondaryDevice === deviceA ? dimsA : dimsB;

// Calculate percentage difference
const percentLarger = ((primaryArea - secondaryArea) / secondaryArea) * 100;

// Format number helper
const formatNum = (num: number, decimals = 1) => num.toFixed(decimals);

// SEO metadata (primary device first for better readability)
const title = `${primaryDevice.name} vs ${secondaryDevice.name} Screen Size Comparison`;
const description = `Compare screen sizes between ${primaryDevice.name} (${primaryDevice.diagonal}") and ${secondaryDevice.name} (${secondaryDevice.diagonal}"). See visual overlay comparison and exact dimensions.`;
const keywords = `${primaryDevice.name} vs ${secondaryDevice.name}, screen size comparison, ${primaryDevice.name} screen size, ${secondaryDevice.name} screen size, display comparison`;

// Amazon search URLs (generic searches)
const getAmazonUrl = (device: typeof deviceA) => {
  const searchTerm = device.name.toLowerCase().replace(/['"]/g, '').replace(/\s+/g, '+');
  return getAmazonSearchUrl(searchTerm);
};
---

<Layout title={title} description={description} keywords={keywords}>
  <Header />

  <main class="max-w-6xl mx-auto px-4 py-8">
    <!-- Page Header -->
    <div class="text-center mb-8">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-4">
        {primaryDevice.name} vs {secondaryDevice.name} Screen Size Comparison
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
        Visual comparison showing how the {primaryDevice.name} ({primaryDevice.diagonal}") and
        {secondaryDevice.name} ({secondaryDevice.diagonal}") screens compare in actual size.
      </p>
    </div>

    <!-- Visualizer Component -->
    <div class="mb-8">
      <ComparisonVisualizer
        client:load
        deviceA={primaryDevice}
        deviceB={secondaryDevice}
      />
    </div>

    <!-- The Verdict Section -->
    <div class="bg-gradient-to-r from-primary-600 to-primary-700 rounded-xl p-6 mb-8 text-white">
      <h2 class="text-xl font-bold mb-3">The Verdict</h2>
      <p class="text-lg">
        {percentLarger > 0 ? (
          <>
            The <strong>{primaryDevice.name}</strong> is <strong class="text-accent-300">{formatNum(percentLarger)}% larger</strong> than
            the <strong>{secondaryDevice.name}</strong> in screen area.
          </>
        ) : (
          <>
            Both devices have <strong>identical screen areas</strong>, though their aspect ratios may differ.
          </>
        )}
      </p>
      <div class="mt-4 grid grid-cols-2 gap-4 text-sm">
        <div class="bg-white/10 rounded-lg p-3">
          <p class="text-white/70 text-xs uppercase tracking-wide mb-1">{primaryDevice.name}</p>
          <p class="font-bold">{formatNum(primaryArea)} sq inches</p>
        </div>
        <div class="bg-white/10 rounded-lg p-3">
          <p class="text-white/70 text-xs uppercase tracking-wide mb-1">{secondaryDevice.name}</p>
          <p class="font-bold">{formatNum(secondaryArea)} sq inches</p>
        </div>
      </div>
    </div>

    <!-- Detailed Specs Comparison -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 overflow-hidden mb-8">
      <div class="p-6">
        <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-4">
          Detailed Specifications
        </h2>

        <div class="overflow-x-auto">
          <table class="w-full text-left">
            <thead>
              <tr class="border-b border-gray-200 dark:border-gray-700">
                <th class="py-3 px-4 text-sm font-medium text-gray-500 dark:text-gray-400">Specification</th>
                <th class="py-3 px-4 text-sm font-medium text-gray-900 dark:text-gray-100">{primaryDevice.name}</th>
                <th class="py-3 px-4 text-sm font-medium text-gray-900 dark:text-gray-100">{secondaryDevice.name}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
              <tr>
                <td class="py-3 px-4 text-sm text-gray-500 dark:text-gray-400">Diagonal</td>
                <td class="py-3 px-4 text-sm font-medium text-gray-900 dark:text-gray-100">{primaryDevice.diagonal}"</td>
                <td class="py-3 px-4 text-sm font-medium text-gray-900 dark:text-gray-100">{secondaryDevice.diagonal}"</td>
              </tr>
              <tr>
                <td class="py-3 px-4 text-sm text-gray-500 dark:text-gray-400">Width</td>
                <td class="py-3 px-4 text-sm font-medium text-gray-900 dark:text-gray-100">{formatNum(primaryDims.width, 2)}"</td>
                <td class="py-3 px-4 text-sm font-medium text-gray-900 dark:text-gray-100">{formatNum(secondaryDims.width, 2)}"</td>
              </tr>
              <tr>
                <td class="py-3 px-4 text-sm text-gray-500 dark:text-gray-400">Height</td>
                <td class="py-3 px-4 text-sm font-medium text-gray-900 dark:text-gray-100">{formatNum(primaryDims.height, 2)}"</td>
                <td class="py-3 px-4 text-sm font-medium text-gray-900 dark:text-gray-100">{formatNum(secondaryDims.height, 2)}"</td>
              </tr>
              <tr>
                <td class="py-3 px-4 text-sm text-gray-500 dark:text-gray-400">Screen Area</td>
                <td class="py-3 px-4 text-sm font-medium text-gray-900 dark:text-gray-100">{formatNum(primaryArea, 1)} sq in</td>
                <td class="py-3 px-4 text-sm font-medium text-gray-900 dark:text-gray-100">{formatNum(secondaryArea, 1)} sq in</td>
              </tr>
              <tr>
                <td class="py-3 px-4 text-sm text-gray-500 dark:text-gray-400">Aspect Ratio</td>
                <td class="py-3 px-4 text-sm font-medium text-gray-900 dark:text-gray-100">{formatNum(primaryDevice.ratio, 2)}:1</td>
                <td class="py-3 px-4 text-sm font-medium text-gray-900 dark:text-gray-100">{formatNum(secondaryDevice.ratio, 2)}:1</td>
              </tr>
              {(primaryDevice.resolution || secondaryDevice.resolution) && (
                <tr>
                  <td class="py-3 px-4 text-sm text-gray-500 dark:text-gray-400">Resolution</td>
                  <td class="py-3 px-4 text-sm font-medium text-gray-900 dark:text-gray-100">{primaryDevice.resolution || 'N/A'}</td>
                  <td class="py-3 px-4 text-sm font-medium text-gray-900 dark:text-gray-100">{secondaryDevice.resolution || 'N/A'}</td>
                </tr>
              )}
              <tr>
                <td class="py-3 px-4 text-sm text-gray-500 dark:text-gray-400">Category</td>
                <td class="py-3 px-4 text-sm font-medium text-gray-900 dark:text-gray-100 capitalize">{primaryDevice.category}</td>
                <td class="py-3 px-4 text-sm font-medium text-gray-900 dark:text-gray-100 capitalize">{secondaryDevice.category}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Affiliate Buttons -->
    {siteConfig.amazon.enabled && (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
        <a
          href={getAmazonUrl(primaryDevice)}
          target="_blank"
          rel="noopener noreferrer nofollow"
          class="flex items-center justify-center gap-2 bg-gradient-to-r from-accent-400 to-accent-500 hover:from-accent-500 hover:to-accent-600 text-gray-900 font-semibold py-4 px-6 rounded-xl shadow-lg hover:shadow-xl transition-all"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M21.53 9.51c.15-.38.22-.79.22-1.21 0-1.13-.51-2.13-1.31-2.8-.81-.68-1.91-1-3.14-1-1.39 0-2.59.43-3.44 1.11-.85.68-1.35 1.62-1.35 2.69 0 .42.08.83.22 1.21H3v2h18.53v-2zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/>
          </svg>
          Shop {primaryDevice.name} on Amazon
        </a>
        <a
          href={getAmazonUrl(secondaryDevice)}
          target="_blank"
          rel="noopener noreferrer nofollow"
          class="flex items-center justify-center gap-2 bg-gradient-to-r from-accent-400 to-accent-500 hover:from-accent-500 hover:to-accent-600 text-gray-900 font-semibold py-4 px-6 rounded-xl shadow-lg hover:shadow-xl transition-all"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M21.53 9.51c.15-.38.22-.79.22-1.21 0-1.13-.51-2.13-1.31-2.8-.81-.68-1.91-1-3.14-1-1.39 0-2.59.43-3.44 1.11-.85.68-1.35 1.62-1.35 2.69 0 .42.08.83.22 1.21H3v2h18.53v-2zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/>
          </svg>
          Shop {secondaryDevice.name} on Amazon
        </a>
      </div>
    )}

    <!-- Related Comparisons -->
    <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-6">
      <h2 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-4">
        Related Comparisons
      </h2>
      <div class="flex flex-wrap gap-2">
        {devices
          .filter(d => d.id !== primaryDevice.id && d.id !== secondaryDevice.id && isValidComparison(primaryDevice.category, d.category))
          .slice(0, 6)
          .map(d => (
            <a
              href={getComparisonUrl(primaryDevice.id, d.id)}
              class="px-3 py-1.5 bg-white dark:bg-gray-700 rounded-lg text-sm text-gray-700 dark:text-gray-300 hover:bg-primary-50 dark:hover:bg-primary-900/30 hover:text-primary-600 dark:hover:text-primary-400 border border-gray-200 dark:border-gray-600 transition-colors"
            >
              {primaryDevice.name} vs {d.name}
            </a>
          ))
        }
        {devices
          .filter(d => d.id !== primaryDevice.id && d.id !== secondaryDevice.id && isValidComparison(secondaryDevice.category, d.category))
          .slice(0, 6)
          .map(d => (
            <a
              href={getComparisonUrl(secondaryDevice.id, d.id)}
              class="px-3 py-1.5 bg-white dark:bg-gray-700 rounded-lg text-sm text-gray-700 dark:text-gray-300 hover:bg-primary-50 dark:hover:bg-primary-900/30 hover:text-primary-600 dark:hover:text-primary-400 border border-gray-200 dark:border-gray-600 transition-colors"
            >
              {secondaryDevice.name} vs {d.name}
            </a>
          ))
        }
      </div>
    </div>

    <!-- Back to Calculator -->
    <div class="mt-8 text-center">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 font-medium transition-colors"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Screen Size Calculator
      </a>
    </div>
  </main>
</Layout>
