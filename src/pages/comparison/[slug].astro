                        : "N/A"}
                    </td>
                    <td class="py-3 px-4 text-sm font-medium text-gray-900 dark:text-gray-100">
                      {secondaryDevice.phone?.dimensions
                        ? `${secondaryDevice.phone.dimensions.height}×${secondaryDevice.phone.dimensions.width}×${secondaryDevice.phone.dimensions.depth}mm`
                        : "N/A"}
                    </td>
                    <td class="py-3 px-4 text-sm text-gray-600 dark:text-gray-400">
                      -
                    </td>
                  </tr>
                )
              }
              {
                (primaryDevice.phone?.alwaysOnDisplay !== undefined ||
                  secondaryDevice.phone?.alwaysOnDisplay !== undefined) && (
                  <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                    <td class="py-3 px-4 text-sm text-gray-500 dark:text-gray-400">
                      Always-On Display
                    </td>
                    <td class="py-3 px-4 text-sm font-medium text-gray-900 dark:text-gray-100">
                      {primaryDevice.phone?.alwaysOnDisplay ? "Yes" : "No"}
                    </td>
                    <td class="py-3 px-4 text-sm font-medium text-gray-900 dark:text-gray-100">
                      {secondaryDevice.phone?.alwaysOnDisplay ? "Yes" : "No"}
                    </td>
                    <td class="py-3 px-4 text-sm text-gray-600 dark:text-gray-400">
                      -
                    </td>
                  </tr>
                )
              }
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                <td class="py-3 px-4 text-sm text-gray-500 dark:text-gray-400"
                  >Category</td
                >
                <td
                  class="py-3 px-4 text-sm font-medium text-gray-900 dark:text-gray-100 capitalize"
                  >{primaryDevice.category}</td
                >
                <td
                  class="py-3 px-4 text-sm font-medium text-gray-900 dark:text-gray-100 capitalize"
                  >{secondaryDevice.category}</td
                >
                <td class="py-3 px-4 text-sm text-gray-600 dark:text-gray-400"
                  >-</td
                >
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Affiliate Buttons -->
    {
      siteConfig.amazon.enabled && (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4 mb-8">
          <a
            href={getAmazonUrl(primaryDevice)}
            target="_blank"
            rel="noopener noreferrer nofollow"
            class="flex items-center justify-center gap-2 bg-gradient-to-r from-accent-400 to-accent-500 hover:from-accent-500 hover:to-accent-600 text-gray-900 font-semibold py-3 sm:py-4 px-4 sm:px-6 rounded-xl shadow-lg hover:shadow-xl transition-all text-sm sm:text-base"
          >
            <svg
              class="w-4 h-4 sm:w-5 sm:h-5 flex-shrink-0"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path d="M21.53 9.51c.15-.38.22-.79.22-1.21 0-1.13-.51-2.13-1.31-2.8-.81-.68-1.91-1-3.14-1-1.39 0-2.59.43-3.44 1.11-.85.68-1.35 1.62-1.35 2.69 0 .42.08.83.22 1.21H3v2h18.53v-2zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z" />
            </svg>
            <span class="truncate">Shop {primaryDevice.name}</span>
          </a>
          <a
            href={getAmazonUrl(secondaryDevice)}
            target="_blank"
            rel="noopener noreferrer nofollow"
            class="flex items-center justify-center gap-2 bg-gradient-to-r from-accent-400 to-accent-500 hover:from-accent-500 hover:to-accent-600 text-gray-900 font-semibold py-3 sm:py-4 px-4 sm:px-6 rounded-xl shadow-lg hover:shadow-xl transition-all text-sm sm:text-base"
          >
            <svg
              class="w-4 h-4 sm:w-5 sm:h-5 flex-shrink-0"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path d="M21.53 9.51c.15-.38.22-.79.22-1.21 0-1.13-.51-2.13-1.31-2.8-.81-.68-1.91-1-3.14-1-1.39 0-2.59.43-3.44 1.11-.85.68-1.35 1.62-1.35 2.69 0 .42.08.83.22 1.21H3v2h18.53v-2zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z" />
            </svg>
            <span class="truncate">Shop {secondaryDevice.name}</span>
          </a>
        </div>
      )
    }

    <!-- FAQ Section -->
    {
      comparisonFAQs.length > 0 && (
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 p-4 sm:p-6 mb-6 sm:mb-8">
          <h2 class="text-lg sm:text-xl font-bold text-gray-900 dark:text-gray-100 mb-4 sm:mb-6">
            Frequently Asked Questions
          </h2>
          <div class="space-y-3 sm:space-y-4">
            {comparisonFAQs.map((faq, index) => (
              <details class="group">
                <summary class="flex justify-between items-center cursor-pointer list-none p-3 sm:p-4 bg-gray-50 dark:bg-gray-900 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
                  <h3 class="font-semibold text-sm sm:text-base text-gray-900 dark:text-gray-100 pr-2 sm:pr-4">
                    {faq.question}
                  </h3>
                  <svg
                    class="w-4 h-4 sm:w-5 sm:h-5 text-gray-500 dark:text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 9l-7 7-7-7"
                    />
                  </svg>
                </summary>
                <div class="px-3 sm:px-4 pt-3 sm:pt-4 pb-2 text-xs sm:text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
                  {faq.answer}
                </div>
              </details>
            ))}
          </div>
        </div>
      )
    }

    <!-- Related Comparisons -->
    <div class="bg-gray-50 dark:bg-gray-800/50 rounded-xl p-4 sm:p-6">
      <h2
        class="text-base sm:text-lg font-bold text-gray-900 dark:text-gray-100 mb-3 sm:mb-4"
      >
        Related Comparisons
      </h2>
      <div class="flex flex-wrap gap-1.5 sm:gap-2">
        {
          devices
            .filter(
              (d) =>
                d.id !== primaryDevice.id &&
                d.id !== secondaryDevice.id &&
                isValidComparison(primaryDevice.category, d.category),
            )
            .slice(0, 6)
            .map((d) => (
              <a
                href={getComparisonUrl(primaryDevice.id, d.id)}
                class="px-2 sm:px-3 py-1 sm:py-1.5 bg-white dark:bg-gray-700 rounded-lg text-xs sm:text-sm text-gray-700 dark:text-gray-300 hover:bg-primary-50 dark:hover:bg-primary-900/30 hover:text-primary-600 dark:hover:text-primary-400 border border-gray-200 dark:border-gray-600 transition-colors"
              >
                <span class="hidden sm:inline">
                  {primaryDevice.name} vs {d.name}
                </span>
                <span class="sm:hidden">vs {d.name}</span>
              </a>
            ))
        }
        {
          devices
            .filter(
              (d) =>
                d.id !== primaryDevice.id &&
                d.id !== secondaryDevice.id &&
                isValidComparison(secondaryDevice.category, d.category),
            )
            .slice(0, 6)
            .map((d) => (
              <a
                href={getComparisonUrl(secondaryDevice.id, d.id)}
                class="px-2 sm:px-3 py-1 sm:py-1.5 bg-white dark:bg-gray-700 rounded-lg text-xs sm:text-sm text-gray-700 dark:text-gray-300 hover:bg-primary-50 dark:hover:bg-primary-900/30 hover:text-primary-600 dark:hover:text-primary-400 border border-gray-200 dark:border-gray-600 transition-colors"
              >
                <span class="hidden sm:inline">
                  {secondaryDevice.name} vs {d.name}
                </span>
                <span class="sm:hidden">vs {d.name}</span>
              </a>
            ))
        }
      </div>
    </div>

    <!-- Back to Calculator -->
    <div class="mt-8 text-center">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 font-medium transition-colors"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to Screen Size Calculator
      </a>
    </div>
  </main>

  <!-- FAQ Schema -->
  {
    faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )
  }
  <!-- Breadcrumb Schema -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />
  <!-- Primary Schema (Product or SoftwareApplication) -->
  <script type="application/ld+json" set:html={JSON.stringify(finalSchema)} />
</Layout>
