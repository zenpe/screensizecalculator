---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import ComparisonSearch from '../../../components/ComparisonSearch';
import { devices, type Device } from '../../../data/devices';
import { getComparisonSlug } from '../../../utils/url';

// SEO metadata
const title = 'Phone Screen Size Comparisons - iPhone vs Samsung & More';
const description =
  'Compare phone screen sizes: iPhone, Samsung Galaxy, Google Pixel, and more. Visual size comparison tool for smartphone displays.';
const keywords =
  'phone screen size comparison, iPhone vs Samsung, iPhone vs Pixel, smartphone display comparison, phone size compare';

// --- Data Fetching and Processing ---

const phoneDevices = devices.filter(d => d.category === 'phone');
const comparisonPairs = [];
for (let i = 0; i < phoneDevices.length; i++) {
  for (let j = i + 1; j < phoneDevices.length; j++) {
    const a = phoneDevices[i];
    const b = phoneDevices[j];
    comparisonPairs.push({
      a,
      b,
      slug: getComparisonSlug(a.id, b.id),
      searchText: `${a.name} ${b.name} ${a.brand} ${b.brand}`.toLowerCase(),
    });
  }
}

// --- Dynamic Search Placeholders ---
const latestIphone = phoneDevices.find(p => p.id.includes('iphone') && !p.id.includes('pro') && !p.id.includes('plus') && !p.id.includes('mini'));
const latestSamsung = phoneDevices.find(p => p.id.includes('samsung-galaxy-s') && p.id.includes('ultra'));
const placeholder = `Search comparisons (e.g. ${latestIphone?.name}, ${latestSamsung?.name})...`;
const searchHint = `Try '${latestIphone?.name}' or '${latestSamsung?.name.replace('Samsung Galaxy ', '')}'`;

// --- Comparison Grouping Logic ---
const isIphone = (id: string) => id.includes('iphone');
const isSamsung = (id: string) => id.includes('samsung');
const isGoogle = (id: string) => id.includes('google-pixel');

const groupFilters = {
  iphoneVsIphone: (p: any) => isIphone(p.a.id) && isIphone(p.b.id),
  samsungVsSamsung: (p: any) => isSamsung(p.a.id) && isSamsung(p.b.id),
  googleVsGoogle: (p: any) => isGoogle(p.a.id) && isGoogle(p.b.id),
  iphoneVsSamsung: (p: any) => (isIphone(p.a.id) && isSamsung(p.b.id)) || (isSamsung(p.a.id) && isIphone(p.b.id)),
  iphoneVsGoogle: (p: any) => (isIphone(p.a.id) && isGoogle(p.b.id)) || (isGoogle(p.a.id) && isIphone(p.b.id)),
  samsungVsGoogle: (p: any) => (isSamsung(p.a.id) && isGoogle(p.b.id)) || (isGoogle(p.a.id) && isSamsung(p.b.id)),
};

const iphoneVsIphonePairs = comparisonPairs.filter(groupFilters.iphoneVsIphone);
const samsungVsSamsungPairs = comparisonPairs.filter(groupFilters.samsungVsSamsung);
const googleVsGooglePairs = comparisonPairs.filter(groupFilters.googleVsGoogle);
const iphoneVsSamsungPairs = comparisonPairs.filter(groupFilters.iphoneVsSamsung);
const iphoneVsGooglePairs = comparisonPairs.filter(groupFilters.iphoneVsGoogle);
const samsungVsGooglePairs = comparisonPairs.filter(groupFilters.samsungVsGoogle);

const allGroupedPairs = new Set([
    ...iphoneVsIphonePairs,
    ...samsungVsSamsungPairs,
    ...googleVsGooglePairs,
    ...iphoneVsSamsungPairs,
    ...iphoneVsGooglePairs,
    ...samsungVsGooglePairs
]);
const otherPairs = comparisonPairs.filter(p => !allGroupedPairs.has(p));

const comparisonSections = [
  { title: 'iPhone vs iPhone', pairs: iphoneVsIphonePairs, id: 'iphone-v-iphone' },
  { title: 'Samsung vs Samsung', pairs: samsungVsSamsungPairs, id: 'samsung-v-samsung' },
  { title: 'Google vs Google', pairs: googleVsGooglePairs, id: 'google-v-google' },
  { title: 'iPhone vs Samsung', pairs: iphoneVsSamsungPairs, id: 'iphone-v-samsung' },
  { title: 'iPhone vs Google', pairs: iphoneVsGooglePairs, id: 'iphone-v-google' },
  { title: 'Samsung vs Google', pairs: samsungVsGooglePairs, id: 'samsung-v-google' },
  { title: 'Other Comparisons', pairs: otherPairs, id: 'other' },
].filter(section => section.pairs.length > 0);

const DISPLAY_LIMIT = 15;
---

<Layout title={title} description={description} keywords={keywords}>
  <Header />

  <main class="max-w-6xl mx-auto px-4 py-8">
    <!-- Breadcrumb -->
    <nav class="mb-6 text-sm">
      <ol class="flex items-center gap-2 text-gray-500 dark:text-gray-400">
        <li><a href="/" class="hover:text-primary-600 dark:hover:text-primary-400">Home</a></li>
        <li>/</li>
        <li><a href="/comparison" class="hover:text-primary-600 dark:hover:text-primary-400">Comparison</a></li>
        <li>/</li>
        <li class="text-gray-900 dark:text-gray-100">Phones</li>
      </ol>
    </nav>

    <!-- Page Header -->
    <div class="mb-10">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-4">
        Phone Screen Size Comparisons
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-3xl">
        Compare smartphone screen sizes visually. See how iPhone, Samsung Galaxy, and other phones compare in actual
        screen area with our interactive overlay tool.
      </p>
      <p class="mt-2 text-sm text-gray-500 dark:text-gray-500">
        {comparisonPairs.length} phone comparisons available
      </p>
    </div>

    <!-- Search Component -->
    <div class="mb-12">
      <ComparisonSearch
        client:load
        devices={phoneDevices}
        comparisons={comparisonPairs}
        placeholder={placeholder}
        searchHint={searchHint}
      />
    </div>

    <!-- Comparison Sections -->
    {comparisonSections.map(section => (
      <section class="mb-10">
        <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-4 flex items-center gap-2">
          {section.title}
          <span class="text-sm font-normal text-gray-500">({section.pairs.length})</span>
        </h2>
        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
            {/* Initially visible items */}
            {section.pairs.slice(0, DISPLAY_LIMIT).map(({ a, b, slug }, index) => (
              <a
                href={`/comparison/${slug}`}
                class={`px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors flex items-center justify-between border-gray-200 dark:border-gray-700
                  ${index < section.pairs.slice(0, DISPLAY_LIMIT).length - 1 ? 'border-b sm:border-b-0 sm:border-r' : ''}
                `}
              >
                <span class="text-sm text-gray-700 dark:text-gray-300">{a.name} vs {b.name}</span>
                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              </a>
            ))}
          </div>
          {/* Hidden items */}
          {section.pairs.length > DISPLAY_LIMIT && (
            <div id={`hidden-${section.id}`} class="hidden">
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 border-t border-gray-200 dark:border-gray-700">
                {section.pairs.slice(DISPLAY_LIMIT).map(({ a, b, slug }, index) => (
                  <a
                    href={`/comparison/${slug}`}
                    class={`px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors flex items-center justify-between border-gray-200 dark:border-gray-700
                      ${index < section.pairs.slice(DISPLAY_LIMIT).length - 1 ? 'border-b sm:border-b-0 sm:border-r' : ''}
                    `}
                  >
                    <span class="text-sm text-gray-700 dark:text-gray-300">{a.name} vs {b.name}</span>
                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
        {/* Show All Button */}
        {section.pairs.length > DISPLAY_LIMIT && (
          <div class="pt-2 text-center">
            <button
              class="show-all-button w-full text-sm font-medium text-primary-600 dark:text-primary-400 hover:underline p-3 rounded-b-lg"
              data-target={`#hidden-${section.id}`}
            >
              Show all {section.pairs.length} comparisons
            </button>
          </div>
        )}
      </section>
    ))}

    <!-- Back Navigation -->
    <div class="flex justify-between items-center pt-6 border-t border-gray-200 dark:border-gray-700">
      <a href="/comparison" class="inline-flex items-center gap-2 text-primary-600 dark:text-primary-400 hover:text-primary-700">All Comparisons</a>
      <a href="/comparison/monitors" class="inline-flex items-center gap-2 text-primary-600 dark:text-primary-400 hover:text-primary-700">Monitor Comparisons →</a>
    </div>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const buttons = document.querySelectorAll('.show-all-button');
      buttons.forEach(button => {
        button.addEventListener('click', () => {
          const targetId = button.getAttribute('data-target');
          if (targetId) {
            const targetElement = document.querySelector(targetId) as HTMLElement;
            if (targetElement) {
              targetElement.classList.remove('hidden');
              button.parentElement?.remove(); // Remove the button's container after click
            }
          }
        });
      });
    });
  </script>
</Layout>
