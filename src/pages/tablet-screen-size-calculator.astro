---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import ScreenSizeCalculator from "../components/ScreenSizeCalculator";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import UseCaseScenarios from "../components/UseCaseScenarios.astro";
import type { UseCase } from "../components/UseCaseScenarios.astro";
import { siteConfig } from "../site.config";

// Use case scenarios for Tablet users
const tabletUseCases: UseCase[] = [
  {
    icon: 'draw',
    title: 'Digital Artists & Illustrators',
    audience: 'Professional artists & creative hobbyists',
    recommendations: [
      '11-13 inch for large canvas area',
      'Apple Pencil Pro or S Pen support',
      'High color accuracy (P3 wide color gamut)',
      '120Hz ProMotion for smooth brush strokes'
    ],
    proTip: 'The iPad Pro 13" with Apple Pencil Pro offers the best drawing experience with tilt and pressure sensitivity. For budget options, the iPad Air 11" is excellent for most artists.'
  },
  {
    icon: 'read',
    title: 'Students & Readers',
    audience: 'Students, researchers & book lovers',
    recommendations: [
      '8.3-11 inch for comfortable reading',
      '4:3 aspect ratio matches book proportions',
      'High PPI (264+) for crisp text',
      'Lightweight for extended reading sessions'
    ],
    proTip: 'The iPad mini (8.3") is perfect for one-handed reading like a paperback. For textbooks and PDFs, 10-11 inch tablets display full pages without zooming.'
  },
  {
    icon: 'media',
    title: 'Entertainment & Media',
    audience: 'Movie watchers & casual gamers',
    recommendations: [
      '11-14.6 inch for immersive viewing',
      '16:10 aspect ratio for less letterboxing',
      'OLED display for superior contrast',
      'Quad speakers for enhanced audio'
    ],
    proTip: 'Samsung Galaxy Tab S9 Ultra (14.6") provides the most cinematic tablet experience. Its 16:10 ratio fits widescreen content better than iPad\'s 4:3.'
  }
];
const title = "Tablet Screen Size Calculator - Display Dimensions & PPI";
const description =
  "Calculate tablet display size and screen dimensions. Compare iPad Pro, iPad Air, Samsung Galaxy Tab, and Surface Pro display sizes, PPI, and specs.";
const keywords =
  "tablet display size calculator, tablet display size, tablet size calculator, tablet screen size calculator, iPad screen size, iPad Pro dimensions, iPad Air size, Samsung Galaxy Tab size, Surface Pro screen size, tablet dimensions";

const faqData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What size iPad should I get?",
      acceptedAnswer: {
        "@type": "Answer",
        text: 'For portability, the iPad mini (8.3") or iPad 10.9" are ideal. For productivity and note-taking, the iPad Air 11" offers a good balance. For professional work, illustration, or replacing a laptop, the iPad Pro 13" or iPad Air 13" provide the most screen real estate.',
      },
    },
    {
      "@type": "Question",
      name: "How big is the iPad Pro 13 inch?",
      acceptedAnswer: {
        "@type": "Answer",
        text: 'The iPad Pro 13" has a screen measuring approximately 10.4" × 7.8" (264mm × 198mm) with a 4:3 aspect ratio. The total screen area is about 81 square inches, making it comparable to a small laptop display.',
      },
    },
    {
      "@type": "Question",
      name: "What's the difference between iPad and Samsung Galaxy Tab aspect ratios?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "iPads use a 4:3 aspect ratio, which is better for productivity, reading, and note-taking. Samsung Galaxy Tabs use 16:10, which is wider and better for watching videos. The 4:3 ratio provides more vertical space, while 16:10 is more cinematic.",
      },
    },
    {
      "@type": "Question",
      name: "Is a bigger tablet screen always better?",
      acceptedAnswer: {
        "@type": "Answer",
        text: 'Not necessarily. Larger tablets (12"+) are excellent for productivity and media but are heavier and less portable. Smaller tablets (8-10") are better for reading, casual use, and portability. Consider your primary use case when choosing a size.',
      },
    },
    {
      "@type": "Question",
      name: "What is the best tablet size for drawing and illustration?",
      acceptedAnswer: {
        "@type": "Answer",
        text: 'For digital artists and illustrators, 11-13 inch tablets are ideal. The iPad Pro 13" with Apple Pencil Pro or Samsung Galaxy Tab S9 Ultra provide large canvas areas. Larger screens reduce the need for constant zooming and allow more natural arm movements similar to traditional drawing.',
      },
    },
    {
      "@type": "Question",
      name: "How does tablet PPI affect display quality?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Tablet PPI (pixels per inch) determines text sharpness and image clarity. Most modern tablets have 250-330 PPI, which is sufficient for sharp text and detailed images. iPad Pro has 264 PPI while Samsung Galaxy Tab S9 Ultra has 240 PPI. Higher PPI matters most for reading small text and detailed illustration work.",
      },
    },
    {
      "@type": "Question",
      name: "What tablet size is best for watching movies?",
      acceptedAnswer: {
        "@type": "Answer",
        text: 'For movie watching, 11-14.6 inch tablets with 16:10 aspect ratio are ideal. Samsung Galaxy Tab S9 series fits widescreen content better than iPads with less letterboxing. The Galaxy Tab S9 Ultra (14.6") provides the most immersive viewing experience. Consider OLED displays for better contrast and HDR content.',
      },
    },
    {
      "@type": "Question",
      name: "Can I use a tablet as a laptop replacement?",
      acceptedAnswer: {
        "@type": "Answer",
        text: 'Yes, tablets 11" and larger with keyboard accessories can replace laptops for many tasks. iPad Pro and iPad Air with Magic Keyboard, or Surface Pro with Type Cover, offer laptop-like productivity. Consider 13"+ sizes for comfortable typing and multitasking. Note that some professional software may still require a traditional laptop.',
      },
    },
    {
      "@type": "Question",
      name: "What is the best tablet size for reading ebooks and documents?",
      acceptedAnswer: {
        "@type": "Answer",
        text: 'For reading, 8-11 inch tablets are ideal. The iPad mini (8.3") is perfect for one-handed reading similar to a paperback book. For PDF documents and textbooks, 10-11 inch tablets display full pages without excessive zooming. The 4:3 aspect ratio of iPads better matches book proportions than wider Android tablets.',
      },
    },
  ],
};

// SoftwareApplication Schema for the calculator tool
const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Tablet Size Calculator",
  description: description,
  applicationCategory: "UtilityApplication",
  operatingSystem: "All",
  url: `${siteConfig.siteUrl}/tablet-screen-size-calculator`,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
};

// Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: siteConfig.siteUrl,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Calculators",
      item: `${siteConfig.siteUrl}/calculators`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Tablet Screen Size Calculator",
      item: `${siteConfig.siteUrl}/tablet-screen-size-calculator`,
    },
  ],
};

// HowTo Schema for step-by-step guide
const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: "How to Choose the Right Tablet Size",
  description:
    "Learn how to calculate and compare tablet screen dimensions, PPI, and resolution for iPad, Samsung Galaxy Tab, and Surface Pro.",
  totalTime: "PT5M",
  step: [
    {
      "@type": "HowToStep",
      position: 1,
      name: "Determine Your Primary Use Case",
      text: "Identify how you'll primarily use the tablet: portability and reading (8-9 inches), general use (10-11 inches), or productivity (12+ inches).",
    },
    {
      "@type": "HowToStep",
      position: 2,
      name: "Enter Tablet Screen Size",
      text: "Input your desired tablet diagonal size in inches or cm. The calculator shows exact width and height dimensions.",
    },
    {
      "@type": "HowToStep",
      position: 3,
      name: "Select Aspect Ratio",
      text: "Choose your tablet's aspect ratio (4:3 for iPad, 16:10 for Samsung Galaxy Tab, 3:2 for Surface Pro).",
    },
    {
      "@type": "HowToStep",
      position: 4,
      name: "Compare Specifications",
      text: "Review PPI, screen area, and resolution to compare different tablet sizes and find the best fit for your needs.",
    },
  ],
};
---

<Layout title={title} description={description} keywords={keywords}>
  <Header />

  <main class="flex-1">
    <section
      class="bg-gradient-to-b from-purple-50 to-white dark:from-purple-900/20 dark:to-gray-900 py-12 lg:py-16"
    >
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Breadcrumb Navigation -->
        <nav class="mb-6 overflow-x-auto" aria-label="Breadcrumb">
          <ol
            class="flex items-center gap-1 sm:gap-2 text-xs sm:text-sm text-gray-600 dark:text-gray-400 whitespace-nowrap"
          >
            <li>
              <a
                href="/"
                class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                >Home</a
              >
            </li>
            <li>
              <svg
                class="w-3 h-3 sm:w-4 sm:h-4 flex-shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path></svg
              >
            </li>
            <li>
              <a
                href="/calculators"
                class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                >Calculators</a
              >
            </li>
            <li>
              <svg
                class="w-3 h-3 sm:w-4 sm:h-4 flex-shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path></svg
              >
            </li>
            <li>
              <span class="text-gray-900 dark:text-gray-100 font-medium"
                >Tablet Screen Size Calculator</span
              >
            </li>
          </ol>
        </nav>

        <div class="text-center">
          <h1
            class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-gray-100 mb-4"
          >
            Tablet Screen Size Calculator
          </h1>
          <p
            class="text-lg text-gray-600 dark:text-gray-300 max-w-3xl mx-auto mb-6"
          >
            Calculate tablet display size, screen dimensions, resolution, and PPI for iPad, Samsung
            Galaxy Tab, Surface Pro, and other tablets. Find the perfect tablet
            size for your needs.
          </p>
          <div
            class="flex flex-wrap justify-center gap-3 text-sm text-gray-600 dark:text-gray-400"
          >
          <span class="flex items-center gap-1">
            <svg
              class="w-5 h-5 text-purple-600 dark:text-purple-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"></path>
            </svg>
            iPad & Android Tablets
          </span>
          <span class="flex items-center gap-1">
            <svg
              class="w-5 h-5 text-purple-600 dark:text-purple-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"></path>
            </svg>
            PPI & Resolution Analysis
          </span>
          <span class="flex items-center gap-1">
            <svg
              class="w-5 h-5 text-purple-600 dark:text-purple-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"></path>
            </svg>
            Dimension Calculator
          </span>
        </div>
      </div>
    </section>

    <section class="py-12 lg:py-16" id="calculator">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <ScreenSizeCalculator client:load initialDeviceMode="tablet" showTabs={false} />
      </div>
    </section>

    <!-- Use Case Scenarios -->
    <UseCaseScenarios
      title="Tablet Recommendations by Use Case"
      subtitle="Different tablet uses require different screen considerations. Find the ideal tablet size for your specific needs."
      useCases={tabletUseCases}
      themeColor="purple"
    />

    <section class="py-12 lg:py-16 bg-gray-50 dark:bg-gray-800/50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2
          class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100 mb-8 text-center"
        >
          Tablet Size Comparison Guide
        </h2>
        <div class="overflow-x-auto">
          <table
            class="w-full bg-white dark:bg-gray-800 rounded-xl shadow-sm overflow-hidden border border-gray-100 dark:border-gray-700"
          >
            <thead
              class="bg-gradient-to-r from-purple-600 to-purple-700 text-white"
            >
              <tr>
                <th class="px-6 py-4 text-left font-semibold">Tablet Size</th>
                <th class="px-6 py-4 text-left font-semibold">Common Models</th>
                <th class="px-6 py-4 text-left font-semibold">Aspect Ratio</th>
                <th class="px-6 py-4 text-left font-semibold">Best For</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                <td
                  class="px-6 py-4 font-medium text-gray-900 dark:text-gray-200"
                  >8 - 9 inches</td
                >
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300"
                  >iPad mini 8.3"</td
                >
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400 text-sm"
                  >4:3</td
                >
                <td class="px-6 py-4 text-sm text-gray-600 dark:text-gray-400"
                  >Reading, portability, one-handed use</td
                >
              </tr>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                <td
                  class="px-6 py-4 font-medium text-gray-900 dark:text-gray-200"
                  >10 - 11 inches</td
                >
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300"
                  >iPad 10.9", iPad Air 11", Galaxy Tab S10</td
                >
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400 text-sm"
                  >4:3 / 16:10</td
                >
                <td class="px-6 py-4 text-sm text-gray-600 dark:text-gray-400"
                  >General use, note-taking, media</td
                >
              </tr>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                <td
                  class="px-6 py-4 font-medium text-gray-900 dark:text-gray-200"
                  >12 - 13 inches</td
                >
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300"
                  >iPad Pro 13", iPad Air 13", Surface Pro, Galaxy Tab S10+</td
                >
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400 text-sm"
                  >4:3 / 3:2 / 16:10</td
                >
                <td class="px-6 py-4 text-sm text-gray-600 dark:text-gray-400"
                  >Productivity, illustration, laptop replacement</td
                >
              </tr>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                <td
                  class="px-6 py-4 font-medium text-gray-900 dark:text-gray-200"
                  >14+ inches</td
                >
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300"
                  >Galaxy Tab S10 Ultra</td
                >
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400 text-sm"
                  >16:10</td
                >
                <td class="px-6 py-4 text-sm text-gray-600 dark:text-gray-400"
                  >Professional work, multitasking, desktop replacement</td
                >
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="py-12 lg:py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2
          class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100 mb-8 text-center"
        >
          Frequently Asked Questions
        </h2>
        <div class="space-y-4">
          <details
            class="bg-white dark:bg-gray-800 rounded-lg shadow-sm overflow-hidden group border border-gray-100 dark:border-gray-700"
          >
            <summary
              class="px-6 py-4 cursor-pointer font-semibold text-gray-900 dark:text-gray-200 flex justify-between items-center hover:bg-gray-50 dark:hover:bg-gray-700/50"
            >
              What size iPad should I get?
              <svg
                class="w-5 h-5 text-gray-400 transform group-open:rotate-180 transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="px-6 pb-4 text-gray-700 dark:text-gray-300">
              <ul class="space-y-2">
                <li>
                  • <strong>iPad mini (8.3"):</strong> Best for portability and reading
                </li>
                <li>
                  • <strong>iPad 10.9" / iPad Air 11":</strong> Great balance of size
                  and portability
                </li>
                <li>
                  • <strong>iPad Air 13" / iPad Pro 13":</strong> Best for productivity
                  and creative work
                </li>
              </ul>
            </div>
          </details>

          <details
            class="bg-white dark:bg-gray-800 rounded-lg shadow-sm overflow-hidden group border border-gray-100 dark:border-gray-700"
          >
            <summary
              class="px-6 py-4 cursor-pointer font-semibold text-gray-900 dark:text-gray-200 flex justify-between items-center hover:bg-gray-50 dark:hover:bg-gray-700/50"
            >
              How big is the iPad Pro 13 inch?
              <svg
                class="w-5 h-5 text-gray-400 transform group-open:rotate-180 transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="px-6 pb-4 text-gray-700 dark:text-gray-300">
              <p>
                The iPad Pro 13" has a screen measuring approximately <strong
                  >10.4" × 7.8"</strong
                > (264mm × 198mm) with a 4:3 aspect ratio. The total screen area is
                about 81 square inches, comparable to a small laptop display.
              </p>
            </div>
          </details>

          <details
            class="bg-white dark:bg-gray-800 rounded-lg shadow-sm overflow-hidden group border border-gray-100 dark:border-gray-700"
          >
            <summary
              class="px-6 py-4 cursor-pointer font-semibold text-gray-900 dark:text-gray-200 flex justify-between items-center hover:bg-gray-50 dark:hover:bg-gray-700/50"
            >
              What's the difference between iPad and Samsung Galaxy Tab aspect
              ratios?
              <svg
                class="w-5 h-5 text-gray-400 transform group-open:rotate-180 transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="px-6 pb-4 text-gray-700 dark:text-gray-300">
              <ul class="space-y-2">
                <li>
                  • <strong>iPad (4:3):</strong> More square, better for productivity,
                  reading, and note-taking
                </li>
                <li>
                  • <strong>Samsung Galaxy Tab (16:10):</strong> Wider, better for
                  watching videos and multitasking with split-screen
                </li>
              </ul>
            </div>
          </details>

          <details
            class="bg-white dark:bg-gray-800 rounded-lg shadow-sm overflow-hidden group border border-gray-100 dark:border-gray-700"
          >
            <summary
              class="px-6 py-4 cursor-pointer font-semibold text-gray-900 dark:text-gray-200 flex justify-between items-center hover:bg-gray-50 dark:hover:bg-gray-700/50"
            >
              Is a bigger tablet screen always better?
              <svg
                class="w-5 h-5 text-gray-400 transform group-open:rotate-180 transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="px-6 pb-4 text-gray-700 dark:text-gray-300">
              <p class="mb-2">Not necessarily. Consider these trade-offs:</p>
              <ul class="space-y-1">
                <li>
                  • <strong>Larger (12"+):</strong> Better for productivity but heavier
                  and less portable
                </li>
                <li>
                  • <strong>Smaller (8-10"):</strong> Better for reading, casual use,
                  and carrying around
                </li>
              </ul>
            </div>
          </details>

          <details
            class="bg-white dark:bg-gray-800 rounded-lg shadow-sm overflow-hidden group border border-gray-100 dark:border-gray-700"
          >
            <summary
              class="px-6 py-4 cursor-pointer font-semibold text-gray-900 dark:text-gray-200 flex justify-between items-center hover:bg-gray-50 dark:hover:bg-gray-700/50"
            >
              What is the best tablet size for drawing and illustration?
              <svg
                class="w-5 h-5 text-gray-400 transform group-open:rotate-180 transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="px-6 pb-4 text-gray-700 dark:text-gray-300">
              <p class="mb-3">
                For digital artists and illustrators, <strong>11-13 inch tablets</strong>
                are ideal.
              </p>
              <ul class="space-y-1 mb-3">
                <li>• <strong>iPad Pro 13":</strong> Large canvas with Apple Pencil Pro support</li>
                <li>• <strong>Samsung Galaxy Tab S9 Ultra:</strong> 14.6" for maximum drawing area</li>
                <li>• <strong>Surface Pro:</strong> Runs full desktop art software</li>
              </ul>
              <p>
                Larger screens reduce the need for constant zooming and allow more
                natural arm movements similar to traditional drawing.
              </p>
            </div>
          </details>

          <details
            class="bg-white dark:bg-gray-800 rounded-lg shadow-sm overflow-hidden group border border-gray-100 dark:border-gray-700"
          >
            <summary
              class="px-6 py-4 cursor-pointer font-semibold text-gray-900 dark:text-gray-200 flex justify-between items-center hover:bg-gray-50 dark:hover:bg-gray-700/50"
            >
              How does tablet PPI affect display quality?
              <svg
                class="w-5 h-5 text-gray-400 transform group-open:rotate-180 transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="px-6 pb-4 text-gray-700 dark:text-gray-300">
              <p class="mb-3">
                Tablet <strong>PPI (pixels per inch)</strong> determines text sharpness
                and image clarity.
              </p>
              <ul class="space-y-1 mb-3">
                <li>• <strong>iPad Pro:</strong> 264 PPI (excellent sharpness)</li>
                <li>• <strong>iPad Air/mini:</strong> 264 PPI</li>
                <li>• <strong>Samsung Galaxy Tab S9 Ultra:</strong> 240 PPI</li>
                <li>• <strong>Surface Pro:</strong> 267 PPI</li>
              </ul>
              <p>
                Most modern tablets have 250-330 PPI, which is sufficient for sharp
                text. Higher PPI matters most for reading small text and detailed
                illustration work.
              </p>
            </div>
          </details>

          <details
