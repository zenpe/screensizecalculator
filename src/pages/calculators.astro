---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const title = 'Screen Calculators - Free Online Display Tools | PPI, Resolution, Aspect Ratio';
const description = 'Free online screen calculators: PPI calculator, resolution scaler, aspect ratio converter, and screen size comparators for TVs, monitors, phones, and projectors.';
const keywords = 'screen calculator, ppi calculator, resolution calculator, aspect ratio calculator, screen size calculator, display tools, pixel density, tv size calculator, monitor calculator';

// Calculator categories
const screenCalculators = [
  {
    title: 'TV Screen Size Calculator',
    description: 'Calculate optimal viewing distance, compare TV sizes, and find the perfect screen for your room.',
    href: '/tv-screen-size-calculator',
    icon: 'tv',
    color: 'blue',
    features: ['Viewing distance', 'Size comparison', 'Room optimization'],
  },
  {
    title: 'Monitor Screen Size Calculator',
    description: 'Compare monitor sizes for gaming, productivity, and professional work. Find your ideal desktop display.',
    href: '/monitor-screen-size-calculator',
    icon: 'monitor',
    color: 'purple',
    features: ['Gaming setups', 'Multi-monitor', 'Desk space planning'],
  },
  {
    title: 'Phone Screen Size Calculator',
    description: 'Compare iPhone, Samsung, Pixel and other smartphone screen sizes side by side.',
    href: '/phone-screen-size-calculator',
    icon: 'phone',
    color: 'green',
    features: ['iPhone vs Android', 'Hand comfort', 'Display comparison'],
  },
  {
    title: 'Projector Screen Size Calculator',
    description: 'Calculate throw distance, screen size, and optimal projector placement for home theater.',
    href: '/projector-screen-size-calculator',
    icon: 'projector',
    color: 'amber',
    features: ['Throw distance', 'Screen sizing', 'Room setup'],
  },
];

const toolCalculators = [
  {
    title: 'PPI Calculator',
    description: 'Calculate pixel density (PPI) for any display. Find if your screen is Retina-quality and compare sharpness.',
    href: '/ppi-calculator',
    icon: 'ppi',
    color: 'indigo',
    features: ['Pixel density', 'Retina check', 'Sharpness comparison'],
  },
  {
    title: 'Resolution Calculator',
    description: 'Scale resolutions, compare pixel counts, and calculate megapixels for any display.',
    href: '/resolution-calculator',
    icon: 'resolution',
    color: 'rose',
    features: ['Resolution scaling', 'Pixel comparison', 'Format conversion'],
  },
  {
    title: 'Aspect Ratio Calculator',
    description: 'Calculate and convert aspect ratios. Find dimensions for 16:9, 21:9, 4:3 and custom ratios.',
    href: '/aspect-ratio-calculator',
    icon: 'ratio',
    color: 'cyan',
    features: ['Ratio conversion', 'Dimension finder', 'Format matching'],
  },
];

// All calculators for Schema
const allCalculators = [...screenCalculators, ...toolCalculators];

// ItemList Schema for SEO
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Screen Calculators",
  "description": "Free online tools to calculate screen sizes, pixel density, resolution, and aspect ratios",
  "numberOfItems": allCalculators.length,
  "itemListElement": allCalculators.map((calc, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": calc.title,
    "description": calc.description,
    "url": `https://screensizecalculators.com${calc.href}`
  }))
};

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What calculators are available on this site?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We offer 7 free calculators: TV, Monitor, Phone, and Projector screen size calculators for comparing displays, plus PPI Calculator for pixel density, Resolution Calculator for scaling, and Aspect Ratio Calculator for dimension conversions."
      }
    },
    {
      "@type": "Question",
      "name": "Are these calculators free to use?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, all calculators on this site are completely free with no registration required. Results are calculated instantly in your browser."
      }
    },
    {
      "@type": "Question",
      "name": "Which calculator should I use to compare screen sizes?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Use the device-specific calculators: TV Calculator for televisions, Monitor Calculator for computer displays, Phone Calculator for smartphones, or Projector Calculator for projection screens. Each is optimized for its device category."
      }
    }
  ]
};

// Icon components
const icons = {
  tv: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />`,
  monitor: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />`,
  phone: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />`,
  projector: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />`,
  ppi: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />`,
  resolution: `<rect x="3" y="3" width="7" height="7" rx="1" stroke-width="2"/><rect x="14" y="14" width="7" height="7" rx="1" stroke-width="2"/><path d="M21 3l-9 9M14 3h7v7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>`,
  ratio: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />`,
};

const colorClasses = {
  blue: { bg: 'bg-blue-100 dark:bg-blue-900/30', text: 'text-blue-600 dark:text-blue-400', border: 'hover:border-blue-300 dark:hover:border-blue-700' },
  purple: { bg: 'bg-purple-100 dark:bg-purple-900/30', text: 'text-purple-600 dark:text-purple-400', border: 'hover:border-purple-300 dark:hover:border-purple-700' },
  green: { bg: 'bg-green-100 dark:bg-green-900/30', text: 'text-green-600 dark:text-green-400', border: 'hover:border-green-300 dark:hover:border-green-700' },
  amber: { bg: 'bg-amber-100 dark:bg-amber-900/30', text: 'text-amber-600 dark:text-amber-400', border: 'hover:border-amber-300 dark:hover:border-amber-700' },
  indigo: { bg: 'bg-indigo-100 dark:bg-indigo-900/30', text: 'text-indigo-600 dark:text-indigo-400', border: 'hover:border-indigo-300 dark:hover:border-indigo-700' },
  rose: { bg: 'bg-rose-100 dark:bg-rose-900/30', text: 'text-rose-600 dark:text-rose-400', border: 'hover:border-rose-300 dark:hover:border-rose-700' },
  cyan: { bg: 'bg-cyan-100 dark:bg-cyan-900/30', text: 'text-cyan-600 dark:text-cyan-400', border: 'hover:border-cyan-300 dark:hover:border-cyan-700' },
};
---

<Layout title={title} description={description} keywords={keywords}>
  <Header />

  <main class="flex-1">
    <!-- Hero Section -->
    <section class="bg-gradient-to-b from-primary-50 to-white dark:from-gray-800 dark:to-gray-900 py-12 lg:py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-gray-100 mb-4">
          Screen Calculators
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
          Free online tools to calculate screen sizes, pixel density, resolution, and aspect ratios for any display.
        </p>
      </div>
    </section>

    <!-- Screen Size Calculators -->
    <section class="py-12 lg:py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2">
            Screen Size Calculators
          </h2>
          <p class="text-gray-600 dark:text-gray-400">
            Compare display sizes and find the perfect screen for your setup
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          {screenCalculators.map((calc) => (
            <a
              href={calc.href}
              class={`group block bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 shadow-sm hover:shadow-md transition-all ${colorClasses[calc.color].border}`}
            >
              <div class="flex items-start gap-4">
                <div class={`w-12 h-12 rounded-xl ${colorClasses[calc.color].bg} flex items-center justify-center flex-shrink-0`}>
                  <svg class={`w-6 h-6 ${colorClasses[calc.color].text}`} fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={icons[calc.icon]} />
                </div>
                <div class="flex-1 min-w-0">
                  <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                    {calc.title}
                  </h3>
                  <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
                    {calc.description}
                  </p>
                  <div class="flex flex-wrap gap-2 mt-3">
                    {calc.features.map((feature) => (
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300">
                        {feature}
                      </span>
                    ))}
                  </div>
                </div>
                <svg class="w-5 h-5 text-gray-400 group-hover:text-primary-500 transition-colors flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Tool Calculators -->
    <section class="py-12 lg:py-16 bg-gray-50 dark:bg-gray-900">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2">
            Display Tools
          </h2>
          <p class="text-gray-600 dark:text-gray-400">
            Calculate pixel density, resolution, and aspect ratios
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {toolCalculators.map((calc) => (
            <a
              href={calc.href}
              class={`group block bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 shadow-sm hover:shadow-md transition-all ${colorClasses[calc.color].border}`}
            >
              <div class={`w-12 h-12 rounded-xl ${colorClasses[calc.color].bg} flex items-center justify-center mb-4`}>
                <svg class={`w-6 h-6 ${colorClasses[calc.color].text}`} fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={icons[calc.icon]} />
              </div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                {calc.title}
              </h3>
              <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">
                {calc.description}
              </p>
              <div class="flex flex-wrap gap-2 mt-4">
                {calc.features.map((feature) => (
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300">
                    {feature}
                  </span>
                ))}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Quick Links -->
    <section class="py-12 lg:py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-gradient-to-r from-primary-600 to-primary-700 rounded-2xl p-8 text-center">
          <h2 class="text-2xl font-bold text-white mb-4">
            Compare Screen Sizes
          </h2>
          <p class="text-primary-100 mb-6 max-w-xl mx-auto">
            Use our comparison tools to see how different screens stack up against each other
          </p>
          <div class="flex flex-wrap justify-center gap-3">
            <a href="/comparison/phones" class="inline-flex items-center px-4 py-2 bg-white/10 hover:bg-white/20 text-white rounded-lg text-sm font-medium transition-colors">
              Compare Phones
            </a>
            <a href="/comparison/monitors" class="inline-flex items-center px-4 py-2 bg-white/10 hover:bg-white/20 text-white rounded-lg text-sm font-medium transition-colors">
              Compare Monitors
            </a>
            <a href="/comparison/tvs" class="inline-flex items-center px-4 py-2 bg-white/10 hover:bg-white/20 text-white rounded-lg text-sm font-medium transition-colors">
              Compare TVs
            </a>
            <a href="/comparison/projectors" class="inline-flex items-center px-4 py-2 bg-white/10 hover:bg-white/20 text-white rounded-lg text-sm font-medium transition-colors">
              Compare Projectors
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-12 lg:py-16 bg-gray-50 dark:bg-gray-900">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-8">
          Frequently Asked Questions
        </h2>
        <div class="space-y-4">
          {faqSchema.mainEntity.map((faq) => (
            <details class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm">
              <summary class="font-semibold text-gray-900 dark:text-gray-100 cursor-pointer">
                {faq.name}
              </summary>
              <p class="mt-3 text-gray-600 dark:text-gray-300">
                {faq.acceptedAnswer.text}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>
