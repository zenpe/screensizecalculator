---
import Layout from '../layouts/Layout.astro';
import CategoryIcon from '../components/icons/CategoryIcon.astro';
import { devices } from '../data/devices';
import {
  getComparisonBrowseUrl,
  isComparisonSeoEnabled,
  siteConfig,
} from '../site.config';

const title = 'Screen Size Calculators - Free PPI, Resolution & Ratio Tools';
const description = 'Free online screen calculators: PPI calculator, resolution scaler, aspect ratio converter, and screen size comparators for TVs, monitors, and phones.';
const keywords = 'screen calculator, ppi calculator, resolution calculator, aspect ratio calculator, screen size calculator, display tools, pixel density, tv size calculator, monitor calculator, tablet screen size';

// Stats for hero section
const totalDevices = devices.length;
const comparisonSeoEnabled = isComparisonSeoEnabled();
const comparisonBrowseHref = comparisonSeoEnabled ? getComparisonBrowseUrl() : '/compare';

// Calculator categories
const screenCalculators = [
  {
    title: 'TV Screen Size Calculator',
    description: 'Calculate optimal viewing distance, compare TV sizes, and find the perfect screen for your room.',
    href: '/tv-screen-size-calculator',
    icon: 'tv' as const,
    color: 'blue',
    features: ['Viewing distance', 'Size comparison', 'Room optimization'],
  },
  {
    title: 'Monitor Screen Size Calculator',
    description: 'Compare monitor sizes for gaming, productivity, and professional work. Find your ideal desktop display.',
    href: '/monitor-screen-size-calculator',
    icon: 'monitor' as const,
    color: 'purple',
    features: ['Gaming setups', 'Multi-monitor', 'Desk space planning'],
  },
  {
    title: 'Phone Screen Size Calculator',
    description: 'Compare iPhone, Samsung, Pixel and other smartphone screen sizes side by side.',
    href: '/phone-screen-size-calculator',
    icon: 'phone' as const,
    color: 'green',
    features: ['iPhone vs Android', 'Hand comfort', 'Display comparison'],
  },
  {
    title: 'Tablet Screen Size Calculator',
    description: 'Compare iPad, Galaxy Tab, Surface and other tablet screen sizes. Find the perfect tablet for your needs.',
    href: '/tablet-screen-size-calculator',
    icon: 'tablet' as const,
    color: 'indigo',
    features: ['iPad comparisons', 'Productivity', 'Portability check'],
  },
  {
    title: 'Projector Screen Size Calculator',
    description: 'Calculate throw distance, screen size, and optimal projector placement for home theater.',
    href: '/projector-screen-size-calculator',
    icon: 'projector' as const,
    color: 'amber',
    features: ['Throw distance', 'Screen sizing', 'Room setup'],
  },
];

const toolCalculators = [
  {
    title: 'Viewport Checker',
    description: 'Detect live viewport size, DPR, and Tailwind or Bootstrap responsive breakpoints for frontend testing.',
    href: '/viewport-checker',
    icon: 'viewport' as const,
    color: 'teal',
    features: ['Viewport detection', 'Breakpoints', 'DPR images'],
  },
  {
    title: 'PPI & DPI Calculator',
    description: 'Calculate pixel density (PPI/DPI) for any display. Find if your screen is Retina-quality and compare sharpness.',
    href: '/ppi-calculator',
    icon: 'ppi' as const,
    color: 'rose',
    features: ['Pixel density', 'DPI calculation', 'Sharpness comparison'],
  },
  {
    title: 'Resolution Calculator',
    description: 'Scale resolutions, compare pixel counts, and calculate megapixels for any display.',
    href: '/resolution-calculator',
    icon: 'resolution' as const,
    color: 'orange',
    features: ['Resolution scaling', 'Pixel comparison', 'Format conversion'],
  },
  {
    title: 'Aspect Ratio Calculator',
    description: 'Calculate and convert aspect ratios. Find dimensions for 16:9, 21:9, 4:3 and custom ratios.',
    href: '/aspect-ratio-calculator',
    icon: 'ratio' as const,
    color: 'cyan',
    features: ['Ratio conversion', 'Dimension finder', 'Format matching'],
  },
];

const scenarioGuides = [
  {
    title: 'Living Room TV Setup',
    description: 'Start with sofa-to-TV distance, then validate whether you should buy 55", 65", or 75".',
    href: '/tv-screen-size-calculator',
    ctaLabel: 'Open TV calculator',
    icon: 'tv' as const,
    color: 'blue',
    steps: ['Enter viewing distance', 'Check recommended TV range', 'Open a size-vs-size comparison'],
    links: [
      { label: 'Distance Chart', href: '/blog/tv-size-by-viewing-distance-chart' },
      { label: 'Open Compare Tool', href: '/compare' },
    ],
  },
  {
    title: 'Desk Monitor Planning',
    description: 'Choose monitor size by desk depth, work style, and whether you use single or dual displays.',
    href: '/monitor-screen-size-calculator',
    ctaLabel: 'Open Monitor calculator',
    icon: 'monitor' as const,
    color: 'purple',
    steps: ['Measure desk depth', 'Match use case to size', 'Validate with ratio and resolution'],
    links: [
      { label: 'Monitor Size Guide', href: '/blog/choosing-right-monitor-size' },
      { label: 'Aspect Ratio Calculator', href: '/aspect-ratio-calculator' },
    ],
  },
  {
    title: 'Phone Size Decision',
    description: 'Compare hand feel, readability, and pocket comfort before choosing compact vs large phones.',
    href: '/phone-screen-size-calculator',
    ctaLabel: 'Open Phone calculator',
    icon: 'phone' as const,
    color: 'green',
    steps: ['Pick candidate models', 'Compare width/height side by side', 'Confirm readability and one-hand use'],
    links: [
      { label: 'How to Measure Screen Size', href: '/blog/how-to-measure-screen-size-tv-monitor-phone' },
      {
        label: comparisonSeoEnabled ? 'Compare Phones' : 'Browse Phones',
        href: getComparisonBrowseUrl('phone'),
      },
    ],
  },
];

// All calculators for Schema
const allCalculators = [...screenCalculators, ...toolCalculators];

// ItemList Schema for SEO
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Screen Size Calculators",
  "description": "Free online tools to calculate screen sizes, pixel density, resolution, and aspect ratios",
  "numberOfItems": allCalculators.length,
  "itemListElement": allCalculators.map((calc, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": calc.title,
    "description": calc.description,
    "url": `${siteConfig.siteUrl}${calc.href}`
  }))
};

const faqs = [
  {
    question: "What calculators are available on this site?",
    answer: "We offer free calculators for TV, monitor, phone, tablet, and projector screen sizes, plus viewport, PPI/DPI, resolution, and aspect ratio tools.",
  },
  {
    question: "Are these calculators free to use?",
    answer: "Yes, all calculators on this site are completely free with no registration required. Results are calculated instantly in your browser.",
  },
  {
    question: "Which calculator should I use to compare screen sizes?",
    answer: "Use the device-specific calculators: TV Calculator for televisions, Monitor Calculator for computer displays, Phone Calculator for smartphones, Tablet Calculator for iPads and tablets, or Projector Calculator for projection screens. Each is optimized for its device category.",
  },
  {
    question: "How accurate are the screen size calculations?",
    answer: "Our calculations use manufacturer specifications and industry-standard formulas. Screen dimensions are calculated from diagonal size and aspect ratio using the Pythagorean theorem, ensuring high accuracy for all supported devices.",
  },
];

// Color classes for icon backgrounds and text
const colorClasses: Record<string, { bg: string; text: string; border: string }> = {
  blue: { bg: 'bg-blue-100 dark:bg-blue-900/30', text: 'text-blue-600 dark:text-blue-400', border: 'hover:border-blue-300 dark:hover:border-blue-700' },
  purple: { bg: 'bg-purple-100 dark:bg-purple-900/30', text: 'text-purple-600 dark:text-purple-400', border: 'hover:border-purple-300 dark:hover:border-purple-700' },
  green: { bg: 'bg-green-100 dark:bg-green-900/30', text: 'text-green-600 dark:text-green-400', border: 'hover:border-green-300 dark:hover:border-green-700' },
  amber: { bg: 'bg-amber-100 dark:bg-amber-900/30', text: 'text-amber-600 dark:text-amber-400', border: 'hover:border-amber-300 dark:hover:border-amber-700' },
  indigo: { bg: 'bg-indigo-100 dark:bg-indigo-900/30', text: 'text-indigo-600 dark:text-indigo-400', border: 'hover:border-indigo-300 dark:hover:border-indigo-700' },
  rose: { bg: 'bg-rose-100 dark:bg-rose-900/30', text: 'text-rose-600 dark:text-rose-400', border: 'hover:border-rose-300 dark:hover:border-rose-700' },
  cyan: { bg: 'bg-cyan-100 dark:bg-cyan-900/30', text: 'text-cyan-600 dark:text-cyan-400', border: 'hover:border-cyan-300 dark:hover:border-cyan-700' },
  orange: { bg: 'bg-orange-100 dark:bg-orange-900/30', text: 'text-orange-600 dark:text-orange-400', border: 'hover:border-orange-300 dark:hover:border-orange-700' },
  teal: { bg: 'bg-primary-100 dark:bg-primary-900/30', text: 'text-primary-600 dark:text-primary-400', border: 'hover:border-primary-300 dark:hover:border-primary-700' },
};
---

<Layout title={title} description={description} keywords={keywords}>

  <main class="flex-1">
    <!-- Hero Section -->
    <section class="bg-gradient-to-b from-primary-50 to-white dark:from-gray-800 dark:to-gray-900 pt-6 pb-12 lg:pb-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Breadcrumb -->
        <nav class="mb-8" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400" itemscope itemtype="https://schema.org/BreadcrumbList">
            <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <a href="/" class="hover:text-primary-600 dark:hover:text-primary-400" itemprop="item">
                <span itemprop="name">Home</span>
              </a>
              <meta itemprop="position" content="1" />
            </li>
            <li class="text-gray-400">/</li>
            <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <span class="text-gray-900 dark:text-gray-100 font-medium" itemprop="name">Calculators</span>
              <meta itemprop="position" content="2" />
            </li>
          </ol>
        </nav>

        <div class="text-center">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-gray-100 mb-4">
            Screen Size Calculators
          </h1>
          <p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto mb-8">
            Free online tools to calculate screen sizes, pixel density, resolution, and aspect ratios for any display.
          </p>
          <!-- Stats -->
          <div class="flex flex-wrap justify-center gap-6 text-sm">
            <div class="flex items-center gap-2 px-4 py-2 bg-white dark:bg-gray-800 rounded-full shadow-sm border border-gray-200 dark:border-gray-700">
              <span class="font-bold text-primary-600 dark:text-primary-400">{allCalculators.length}</span>
              <span class="text-gray-600 dark:text-gray-400">Calculators</span>
            </div>
            <div class="flex items-center gap-2 px-4 py-2 bg-white dark:bg-gray-800 rounded-full shadow-sm border border-gray-200 dark:border-gray-700">
              <span class="font-bold text-primary-600 dark:text-primary-400">{totalDevices}+</span>
              <span class="text-gray-600 dark:text-gray-400">Devices</span>
            </div>
            <div class="flex items-center gap-2 px-4 py-2 bg-white dark:bg-gray-800 rounded-full shadow-sm border border-gray-200 dark:border-gray-700">
              <span class="font-bold text-green-600 dark:text-green-400">100%</span>
              <span class="text-gray-600 dark:text-gray-400">Free</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Screen Size Calculators -->
    <section class="py-12 lg:py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2">
            Screen Size Calculators
          </h2>
          <p class="text-gray-600 dark:text-gray-400">
            Compare display sizes and find the perfect screen for your setup
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          {screenCalculators.map((calc) => (
            <a
              href={calc.href}
              class={`group block bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 shadow-sm hover:shadow-md transition-all ${colorClasses[calc.color].border}`}
            >
              <div class="flex items-start gap-4">
                <div class={`w-12 h-12 rounded-xl ${colorClasses[calc.color].bg} flex items-center justify-center flex-shrink-0`}>
                  <CategoryIcon icon={calc.icon} size="xl" color={colorClasses[calc.color].text} useSvg />
                </div>
                <div class="flex-1 min-w-0">
                  <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                    {calc.title}
                  </h3>
                  <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
                    {calc.description}
                  </p>
                  <div class="flex flex-wrap gap-2 mt-3">
                    {calc.features.map((feature) => (
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300">
                        {feature}
                      </span>
                    ))}
                  </div>
                </div>
                <svg class="w-5 h-5 text-gray-400 group-hover:text-primary-500 transition-colors flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Tool Calculators -->
    <section class="py-12 lg:py-16 bg-gray-50 dark:bg-gray-900">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2">
            Display Tools
          </h2>
          <p class="text-gray-600 dark:text-gray-400">
            Calculate pixel density, resolution, and aspect ratios
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {toolCalculators.map((calc) => (
            <a
              href={calc.href}
              class={`group block bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 shadow-sm hover:shadow-md transition-all ${colorClasses[calc.color].border}`}
            >
              <div class={`w-12 h-12 rounded-xl ${colorClasses[calc.color].bg} flex items-center justify-center mb-4`}>
                <CategoryIcon icon={calc.icon} size="xl" color={colorClasses[calc.color].text} useSvg />
              </div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                {calc.title}
              </h3>
              <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">
                {calc.description}
              </p>
              <div class="flex flex-wrap gap-2 mt-4">
                {calc.features.map((feature) => (
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300">
                    {feature}
                  </span>
                ))}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Scenario Picker -->
    <section class="py-12 lg:py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2">
            Choose a Calculator by Scenario
          </h2>
          <p class="text-gray-600 dark:text-gray-400">
            Start from your real usage situation, then jump to the best-fit tool and guide.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          {scenarioGuides.map((scenario) => (
            <div class={`bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 shadow-sm ${colorClasses[scenario.color].border}`}>
              <div class="flex items-start gap-4">
                <div class={`w-11 h-11 rounded-lg ${colorClasses[scenario.color].bg} flex items-center justify-center flex-shrink-0`}>
                  <CategoryIcon icon={scenario.icon} size="lg" color={colorClasses[scenario.color].text} useSvg />
                </div>
                <div class="min-w-0">
                  <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">
                    {scenario.title}
                  </h3>
                  <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
                    {scenario.description}
                  </p>
                </div>
              </div>

              <ul class="mt-4 space-y-2 text-sm text-gray-700 dark:text-gray-300">
                {scenario.steps.map((step) => (
                  <li class="flex items-start gap-2">
                    <span class="mt-1 h-1.5 w-1.5 rounded-full bg-gray-400 dark:bg-gray-500"></span>
                    <span>{step}</span>
                  </li>
                ))}
              </ul>

              <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700 flex flex-wrap gap-3 text-sm">
                <a href={scenario.href} class="font-semibold text-primary-600 dark:text-primary-400 hover:underline">
                  {scenario.ctaLabel}
                </a>
                {scenario.links.map((link) => (
                  <a href={link.href} class="text-gray-600 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400 hover:underline">
                    {link.label}
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Quick Links -->
    <section class="py-12 lg:py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-gray-900 dark:bg-gray-800 rounded-2xl p-8 text-center">
          <h2 class="text-2xl font-bold text-white mb-4">
            {comparisonSeoEnabled ? 'Compare Screen Sizes' : 'Explore Device Sizes'}
          </h2>
          <p class="text-gray-300 mb-6 max-w-xl mx-auto">
            {comparisonSeoEnabled
              ? 'Use our comparison tools to see how different screens stack up against each other'
              : 'Browse device categories or open the compare tool to evaluate different screens side by side'}
          </p>
          <div class="flex flex-wrap justify-center gap-3">
            <a href={getComparisonBrowseUrl('phone')} class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 hover:bg-white/20 text-white rounded-lg text-sm font-medium transition-colors">
              <CategoryIcon icon="phone" size="sm" color="text-white" />
              {comparisonSeoEnabled ? 'Compare Phones' : 'Browse Phones'}
            </a>
            <a href={getComparisonBrowseUrl('tablet')} class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 hover:bg-white/20 text-white rounded-lg text-sm font-medium transition-colors">
              <CategoryIcon icon="tablet" size="sm" color="text-white" />
              {comparisonSeoEnabled ? 'Compare Tablets' : 'Browse Tablets'}
            </a>
            <a href={getComparisonBrowseUrl('monitor')} class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 hover:bg-white/20 text-white rounded-lg text-sm font-medium transition-colors">
              <CategoryIcon icon="monitor" size="sm" color="text-white" />
              {comparisonSeoEnabled ? 'Compare Monitors' : 'Browse Monitors'}
            </a>
            <a href={getComparisonBrowseUrl('tv')} class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 hover:bg-white/20 text-white rounded-lg text-sm font-medium transition-colors">
              <CategoryIcon icon="tv" size="sm" color="text-white" />
              {comparisonSeoEnabled ? 'Compare TVs' : 'Browse TVs'}
            </a>
            <a href={getComparisonBrowseUrl('projector')} class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 hover:bg-white/20 text-white rounded-lg text-sm font-medium transition-colors">
              <CategoryIcon icon="projector" size="sm" color="text-white" />
              {comparisonSeoEnabled ? 'Compare Projectors' : 'Browse Projectors'}
            </a>
          </div>
          <a href={comparisonBrowseHref} class="inline-flex items-center gap-2 mt-6 text-gray-400 hover:text-white text-sm transition-colors">
            {comparisonSeoEnabled ? 'View all comparisons' : 'Open compare tool'}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-12 lg:py-16 bg-gray-50 dark:bg-gray-900">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-8">
          Frequently Asked Questions
        </h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <details class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm">
              <summary class="font-semibold text-gray-900 dark:text-gray-100 cursor-pointer">
                {faq.question}
              </summary>
              <p class="mt-3 text-gray-600 dark:text-gray-300">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
</Layout>
