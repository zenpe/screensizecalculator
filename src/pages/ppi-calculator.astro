---
import Layout from "../layouts/Layout.astro";
import PPICalculator from "../components/calculators/PPICalculator";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import FAQSection from "../components/FAQSection.astro";
import {
  getLatestIphoneWithPPI,
  getLatestSamsungWithPPI,
} from "../data/devices";
import { siteConfig } from "../site.config";

const title = "PPI Calculator & DPI Calculator - Pixel Density Tool";
const description =
  "Free PPI and DPI calculator. Calculate pixels per inch for any screen, find pixel density for monitors, phones, and TVs. Compare screen sharpness instantly.";
const keywords =
  "ppi calculator, dpi calculator, pixel density calculator, pixels per inch, pixel calculator, screen ppi, monitor ppi, pixel density, screen sharpness, retina display";

// Get latest phone PPI data
const latestIphone = getLatestIphoneWithPPI();
const latestSamsung = getLatestSamsungWithPPI();

const faqs = [
  {
    question: "What is PPI (Pixels Per Inch)?",
    answer: "PPI (Pixels Per Inch) measures pixel density - how many pixels are packed into one inch of screen. Higher PPI means sharper images and text. It's calculated by dividing the diagonal pixel count by the screen's diagonal size in inches.",
  },
  {
    question: "What PPI is considered Retina display?",
    answer: "Apple defines Retina as a display where pixels are not individually distinguishable at typical viewing distance. For phones (held at ~10-12 inches), this is around 300+ PPI. For laptops (~18 inches), it's around 220 PPI. For desktop monitors (~24 inches), about 110 PPI may suffice.",
  },
  {
    question: "How do I calculate PPI?",
    answer: "PPI = √(width² + height²) / diagonal. For example, a 27-inch 2560×1440 monitor: √(2560² + 1440²) / 27 = 2940 / 27 ≈ 109 PPI.",
  },
  {
    question: "What is the difference between PPI and DPI?",
    answer: "PPI (Pixels Per Inch) refers to screen display density. DPI (Dots Per Inch) traditionally refers to print resolution. For screens, PPI is the correct term, though they're often used interchangeably.",
  },
  {
    question: "Does higher PPI mean better quality?",
    answer: "Higher PPI generally means sharper images, but the optimal PPI depends on viewing distance. A 55-inch 4K TV at 80 PPI looks sharp from a couch, while a phone at the same PPI would look pixelated. Match PPI to your typical viewing distance.",
  },
  {
    question: "What is a good PPI for a monitor?",
    answer: "For desktop monitors at typical viewing distance (24-30 inches), 100-110 PPI is acceptable, 140-160 PPI is good for sharp text, and 200+ PPI is excellent. A 27-inch 4K monitor at 163 PPI offers a great balance of sharpness and usability.",
  },
  {
    question: "What PPI do I need for gaming?",
    answer: "For gaming monitors at typical desk distance (2-3 feet), 100-110 PPI is the minimum for acceptable clarity. 140-165 PPI (27\" 4K or 24\" 1440p) provides excellent sharpness while maintaining good frame rates. Higher PPI requires more GPU power to maintain smooth gameplay.",
  },
  {
    question: "Is 4K worth it on a 27-inch monitor?",
    answer: "Yes, 4K on a 27-inch monitor provides 163 PPI, which is excellent for sharp text and detailed images. However, you may need to use display scaling (125-150%) for comfortable reading, and you'll need a powerful GPU for gaming at native 4K resolution.",
  },
  {
    question: "How do I convert DPI to PPI?",
    answer: "For screens, DPI and PPI are essentially the same value - no conversion needed. DPI is traditionally used for printing while PPI is used for screens. When someone says a monitor has '96 DPI', they mean 96 PPI. Our calculator works for both PPI and DPI calculations.",
  },
];

// SoftwareApplication Schema for the calculator tool
const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "PPI & DPI Calculator",
  applicationCategory: "UtilityApplication",
  operatingSystem: "Web Browser",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  author: {
    "@type": "Organization",
    name: "Screen Size Calculator",
  },
  description:
    "Free online PPI and DPI calculator to calculate pixel density for screens, monitors, phones, and TVs. Compare screen sharpness across devices.",
  featureList: [
    "Calculate PPI from resolution and screen size",
    "DPI to PPI conversion",
    "Find required resolution for target PPI",
    "Compare with popular device pixel densities",
    "Visual text clarity simulation",
  ],
};

// HowTo Schema for step-by-step instructions
const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: "How to Calculate PPI (Pixels Per Inch)",
  description:
    "Learn how to calculate pixel density (PPI/DPI) for any screen or find the required resolution for a target PPI.",
  step: [
    {
      "@type": "HowToStep",
      name: "Choose Your Mode",
      text: "Select 'Calculate PPI/DPI' to find pixel density from resolution and screen size, or 'Find Resolution' to calculate the required resolution for a target PPI.",
    },
    {
      "@type": "HowToStep",
      name: "Enter Your Display Details",
      text: "Input your screen resolution (width × height in pixels) and diagonal screen size in inches or centimeters. Use device presets for quick calculations.",
    },
    {
      "@type": "HowToStep",
      name: "View Results and Compare",
      text: "Get instant PPI calculation with quality rating, pixel pitch, and optimal viewing distance. Compare your display against popular devices like iPhones and MacBooks.",
    },
  ],
};

// Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: siteConfig.siteUrl,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Calculators",
      item: `${siteConfig.siteUrl}/calculators`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "PPI & DPI Calculator",
      item: `${siteConfig.siteUrl}/ppi-calculator`,
    },
  ],
};
