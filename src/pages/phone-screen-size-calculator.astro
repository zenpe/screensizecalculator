            </div>
          </div>
          <div
            class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm border border-gray-100 dark:border-gray-700"
          >
            <div class="flex items-start gap-4">
              <div
                class="bg-amber-100 dark:bg-amber-900/50 rounded-lg p-3 text-amber-600 dark:text-amber-400 font-bold text-xl"
              >
                3
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">
                  Set Resolution
                </h3>
                <p class="text-gray-600 dark:text-gray-400 text-sm">
                  Select your phone's resolution (e.g., 1170 x 2532 for iPhone
                  14) to calculate PPI and pixel density.
                </p>
              </div>
            </div>
          </div>
          <div
            class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm border border-gray-100 dark:border-gray-700"
          >
            <div class="flex items-start gap-4">
              <div
                class="bg-amber-100 dark:bg-amber-900/50 rounded-lg p-3 text-amber-600 dark:text-amber-400 font-bold text-xl"
              >
                4
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">
                  Review Specifications
                </h3>
                <p class="text-gray-600 dark:text-gray-400 text-sm">
                  Get exact dimensions, PPI, total pixels and pixel pitch. See
                  if it's a 'retina' quality display (300+ PPI).
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Use Case Scenarios -->
    <UseCaseScenarios
      title="Phone Recommendations by Use Case"
      subtitle="Different lifestyles demand different phone sizes. Find the ideal smartphone screen for your daily needs."
      useCases={phoneUseCases}
      themeColor="amber"
    />

    <!-- Phone Size Guide -->
    <section class="py-12 lg:py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
