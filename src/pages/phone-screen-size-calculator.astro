---
import Layout from "../layouts/Layout.astro";
import ScreenSizeCalculator from "../components/ScreenSizeCalculator";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import UseCaseScenarios from "../components/UseCaseScenarios.astro";
import FAQSection from "../components/FAQSection.astro";
import type { UseCase } from "../components/UseCaseScenarios.astro";
import { siteConfig } from "../site.config";

// Use case scenarios for Phone users
const phoneUseCases: UseCase[] = [
  {
    icon: 'photo',
    title: 'Photography Enthusiasts',
    audience: 'Mobile photographers & content creators',
    recommendations: [
      '6.5-6.8 inch for detailed photo editing',
      'OLED display for accurate colors',
      'High resolution (1440p+) for sharp previews',
      'HDR support for editing HDR photos'
    ],
    proTip: 'Choose phones with P3 wide color gamut and 1000+ nits brightness for accurate outdoor photo review and editing.'
  },
  {
    icon: 'game',
    title: 'Mobile Gamers',
    audience: 'Casual & competitive mobile gamers',
    recommendations: [
      '6.5-6.8 inch for immersive gameplay',
      '120Hz+ refresh rate for smooth action',
      'High touch sampling rate (240Hz+)',
      'Balanced aspect ratio (20:9) for controls'
    ],
    proTip: 'Enable gaming mode to prioritize performance. Consider phones with vapor chamber cooling for extended gaming sessions without throttling.'
  },
  {
    icon: 'business',
    title: 'Business Professionals',
    audience: 'Productivity-focused users',
    recommendations: [
      '6.1-6.4 inch for one-handed use',
      'High PPI for crisp document reading',
      'Comfortable grip for all-day use',
      'Good outdoor visibility (bright display)'
    ],
    proTip: 'Prioritize battery life and security features. Phones around 6.1 inches offer the best balance of screen size and pocket portability.'
  }
];
const title = "Phone Screen Size Calculator - Display Dimensions & PPI";
const description =
  "Calculate phone display size and screen dimensions. Compare iPhone vs Android display sizes, calculate PPI, and find the perfect smartphone size for your needs.";
const keywords =
  "phone display size calculator, phone display size, phone size calculator, phone screen size calculator, iPhone screen size, Android screen size, phone dimensions, smartphone size comparison, phone PPI calculator";

// FAQ data
const faqs = [
  {
    question: "How big is a 6.1 inch phone?",
    answer: `<p class="mb-3">A <strong>6.1 inch phone</strong> has dimensions of approximately <strong>5.9 x 2.8 inches</strong> (150 x 71 mm) for the screen area.</p><p>This is considered a medium-sized phone, suitable for one-handed use while providing enough screen real estate for multitasking. The iPhone 14 has these dimensions.</p>`,
  },
  {
    question: "What size phone is best for small hands?",
    answer: `<p class="mb-3">Phones with <strong>5.4-5.8 inch screens</strong> are ideal for small hands.</p><p>Examples include the iPhone 14 Mini (5.4 inches), iPhone SE (5.4 inches), and smaller Android models. These sizes allow for comfortable one-handed use with easy reach to all screen areas.</p>`,
  },
  {
    question: "What's the difference between phone PPI and TV PPI?",
    answer: `<p class="mb-3">Phone PPI (pixels per inch) is typically much higher than TV PPI due to closer viewing distances.</p><p>Phone screens range from <strong>300-600+ PPI</strong> (iPhone 14 Pro Max is 460 PPI), while TVs typically have 50-150 PPI. Higher PPI on phones prevents visible pixels at normal viewing distances.</p>`,
  },
  {
    question: "Is bigger phone screen always better?",
    answer: `<p class="mb-3">Not always. Larger screens (6.7+ inches) offer better media consumption and multitasking but may be harder to use one-handed.</p><p>Consider your usage patterns and hand size when choosing a phone screen size. Larger phones may not fit comfortably in smaller pockets.</p>`,
  },
  {
    question: "What is a good PPI for a phone screen?",
    answer: `<p class="mb-3"><strong>300+ PPI</strong> is considered 'Retina' quality where individual pixels become invisible at normal viewing distance.</p><p>Most modern smartphones have 400-500+ PPI. Budget phones with 250-300 PPI are still acceptable but may show slight pixelation on close inspection.</p>`,
  },
  {
    question: "What phone size is best for video watching?",
    answer: `<p class="mb-3">For video watching, <strong>6.5-6.8 inch phones</strong> with 20:9 or 21:9 aspect ratios are ideal.</p><p>Larger screens like the iPhone 14 Pro Max (6.7") or Galaxy S23 Ultra (6.8") provide a more immersive experience. Consider OLED displays for better contrast and HDR content.</p>`,
  },
  {
    question: "How does aspect ratio affect phone usability?",
    answer: `<p class="mb-3">Taller aspect ratios (20:9, 21:9) make phones narrower and easier to hold one-handed while showing more content when scrolling.</p><p>Wider ratios (16:9, 18:9) are better for gaming and video. Most modern phones use 19.5:9 to 20:9 for a balance of usability and media consumption.</p>`,
  },
  {
    question: "What is the best phone size for gaming?",
    answer: `<p class="mb-3">For mobile gaming, <strong>6.5-6.8 inch phones</strong> offer the best experience with more screen real estate for controls and visuals.</p><p>Look for high refresh rate displays (120Hz+) and high resolution (1440p). The iPhone 14 Pro Max, Galaxy S23 Ultra, and gaming phones like ROG Phone are popular choices.</p>`,
  },
  {
    question: "Does phone screen size affect battery life?",
    answer: `<p class="mb-3">Yes, larger screens consume more power. However, larger phones typically have bigger batteries to compensate.</p><p>OLED screens are more efficient than LCD for dark content. Screen brightness has the biggest impact on battery life - reducing brightness can significantly extend usage time.</p>`,
  },
];

// SoftwareApplication Schema for the calculator tool
const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Phone Screen Size Calculator",
  description: description,
  applicationCategory: "UtilityApplication",
  operatingSystem: "All",
  url: `${siteConfig.siteUrl}/phone-screen-size-calculator`,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
};

// Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: siteConfig.siteUrl,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Calculators",
      item: `${siteConfig.siteUrl}/calculators`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Phone Screen Size Calculator",
      item: `${siteConfig.siteUrl}/phone-screen-size-calculator`,
    },
  ],
};

---

<Layout title={title} description={description} keywords={keywords}>

  <main class="flex-1">
    <!-- Hero Section -->
    <section
      class="bg-gradient-to-b from-amber-50 to-white dark:from-amber-900/20 dark:to-gray-900 py-12 lg:py-16"
    >
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Breadcrumb Navigation -->
        <nav class="mb-6 overflow-x-auto" aria-label="Breadcrumb">
          <ol
            class="flex items-center gap-1 sm:gap-2 text-xs sm:text-sm text-gray-600 dark:text-gray-400 whitespace-nowrap"
          >
            <li>
              <a
                href="/"
                class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                >Home</a
              >
            </li>
            <li>
              <svg
                class="w-3 h-3 sm:w-4 sm:h-4 flex-shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path></svg
              >
            </li>
            <li>
              <a
                href="/calculators"
                class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                >Calculators</a
              >
            </li>
            <li>
              <svg
                class="w-3 h-3 sm:w-4 sm:h-4 flex-shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path></svg
              >
            </li>
            <li>
              <span class="text-gray-900 dark:text-gray-100 font-medium"
                >Phone Screen Size Calculator</span
              >
            </li>
          </ol>
        </nav>

        <div class="text-center">
          <h1
            class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-gray-100 mb-4"
          >
            Phone Screen Size Calculator & Screen Analysis Tool
          </h1>
          <p
            class="text-lg text-gray-600 dark:text-gray-300 max-w-3xl mx-auto mb-6"
          >
            Find the perfect phone display size for your needs with detailed resolution
            and PPI analysis. Calculate screen dimensions, pixel density, and
            compare different iPhone and Android models. Perfect for understanding
            how screen size affects usability.
          </p>
          <div
            class="flex flex-wrap justify-center gap-3 text-sm text-gray-600 dark:text-gray-400"
          >
          <span class="flex items-center gap-1">
            <svg
              class="w-5 h-5 text-amber-600 dark:text-amber-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"></path>
            </svg>
            PPI & Pixel Density
          </span>
          <span class="flex items-center gap-1">
            <svg
              class="w-5 h-5 text-amber-600 dark:text-amber-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"></path>
            </svg>
            Screen Dimension Analysis
          </span>
          <span class="flex items-center gap-1">
            <svg
              class="w-5 h-5 text-amber-600 dark:text-amber-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"></path>
            </svg>
            iPhone & Android Comparison
          </span>
        </div>
      </div>
      </div>
    </section>

    <!-- Calculator Section -->
    <section class="py-12 lg:py-16" id="calculator">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <ScreenSizeCalculator client:load initialDeviceMode="phone" showTabs={false} />
      </div>
    </section>

    <!-- How to Use Guide -->
    <section class="py-12 lg:py-16 bg-gray-50 dark:bg-gray-800/50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2
          class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100 mb-8 text-center"
