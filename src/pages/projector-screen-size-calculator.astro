                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </summary>
            <div class="px-6 pb-4 text-gray-700 dark:text-gray-300">
              <p class="mb-3">
                <strong>Ceiling mounting</strong> keeps the projector out of the way
                and provides a cleaner setup, but requires professional installation.
              </p>
              <p class="mb-3">
                <strong>Table or shelf placement</strong> is easier to set up and
                adjust but may obstruct viewing paths.
              </p>
              <p>
                Consider <strong>lens shift capability</strong> for flexibility in
                either setup without causing keystone distortion.
              </p>
            </div>
          </details>

          <details
            class="bg-white dark:bg-gray-800 rounded-lg shadow-sm overflow-hidden group border border-gray-100 dark:border-gray-700"
          >
            <summary
              class="px-6 py-4 cursor-pointer font-semibold text-gray-900 dark:text-gray-200 flex justify-between items-center hover:bg-gray-50 dark:hover:bg-gray-700/50"
