---
import Layout from "../layouts/Layout.astro";
import ScreenSizeCalculator from "../components/ScreenSizeCalculator";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import UseCaseScenarios from "../components/UseCaseScenarios.astro";
import FAQSection from "../components/FAQSection.astro";
import type { UseCase } from "../components/UseCaseScenarios.astro";
import { siteConfig } from "../site.config";

// Use case scenarios for Projector users
const projectorUseCases: UseCase[] = [
  {
    icon: 'home-theater',
    title: 'Home Theater Enthusiasts',
    audience: 'Movie buffs & cinema lovers',
    recommendations: [
      '100-150 inch screen for true cinema feel',
      '4K laser projector for best image quality',
      'Dedicated dark room for optimal contrast',
      'Acoustic transparent screen for center speaker'
    ],
    proTip: 'Invest in a motorized screen that retracts when not in use. ALR (Ambient Light Rejecting) screens help if your room isn\'t fully dark.'
  },
  {
    icon: 'presentation',
    title: 'Business Presentations',
    audience: 'Meeting rooms & conference spaces',
    recommendations: [
      '80-120 inch based on room size',
      '3000+ lumens for lit rooms',
      'Short throw for limited space',
      'Wireless connectivity for easy setup'
    ],
    proTip: 'Choose a projector with built-in apps and wireless casting. Interactive projectors work great for collaborative meetings and brainstorming.'
  },
  {
    icon: 'outdoor',
    title: 'Outdoor Movie Nights',
    audience: 'Backyard cinema & events',
    recommendations: [
      '100-150 inch inflatable or portable screen',
      '4000+ lumens for dusk viewing',
      'Portable design with carrying case',
      'Built-in speakers or Bluetooth audio'
    ],
    proTip: 'Wait until after sunset for best image quality. Battery-powered projectors offer cord-free flexibility for truly portable outdoor setups.'
  }
];
const title = "Projector Screen Size Calculator - Throw Distance & Dimensions";
const description =
  "Free projector throw distance calculator. Calculate screen size, throw ratio, and wall dimensions for any projector setup. Works with short throw & UST.";
const keywords =
  "projector screen size calculator, projector throw distance calculator, projector throw ratio, short throw projector calculator, UST projector distance, projector placement calculator, throw distance formula";
const updatedDate = '2026-03-30';

const roomSizeQuickPicks = [
  {
    room: '10-12 ft room',
    size: '100"',
    fit: 'Best starting point for mixed-use living rooms and first projector setups.',
    standardThrow: '10.9 ft',
  },
  {
    room: '12-15 ft room',
    size: '100" to 120"',
    fit: 'Best balance when movie nights matter and the room can get dark.',
    standardThrow: '10.9-13.1 ft',
  },
  {
    room: '15-18 ft room',
    size: '120"',
    fit: 'Stronger immersion without pushing the room as hard as 150".',
    standardThrow: '13.1 ft',
  },
  {
    room: '18+ ft room',
    size: '120" to 150"',
    fit: 'Large dark rooms can justify 150" if brightness is strong enough.',
    standardThrow: '13.1-16.4 ft',
  },
];

// FAQ data
const faqs = [
  {
    question: "How do I calculate projector throw distance?",
    answer: "Use the formula: Throw Distance = Screen Width × Throw Ratio. For example, a 100-inch diagonal 16:9 screen (87 inches wide) with a 1.5 throw ratio projector needs: 87 × 1.5 = 130.5 inches (10.9 feet) throw distance.",
  },
  {
    question: "What is a good throw ratio for a projector?",
    answer: "Standard throw ratio (1.5-1.8) is most versatile for home theaters. Ultra short throw (0.25-0.5) is best for small rooms. Short throw (0.8-1.2) balances flexibility and price. Long throw (2.0+) is for large venues.",
  },
  {
    question: "How far should a projector be from a 120 inch screen?",
    answer: "For a 120 inch screen (105 inches wide), placement distance depends on throw ratio: Ultra short throw (0.4): 3.5 feet, Short throw (0.8): 7.0 feet, Standard (1.5): 13.1 feet, Long throw (2.0): 17.5 feet.",
  },
  {
    question: "What's the difference between short throw and ultra short throw projectors?",
    answer: "Ultra short throw (UST) projectors have 0.25-0.5 throw ratio and sit 8-20 inches from screen, ideal for tight spaces. Short throw projectors have 0.8-1.2 ratio and need 3-8 feet distance, offering better value than UST with good flexibility.",
  },
  {
    question: "What screen size is best for home theater?",
    answer: "For home theaters, 100-120 inch screens are the most popular choice. A 100 inch screen works well for rooms 10-12 feet deep, while 120+ inches is ideal for dedicated home theater rooms with 12-15+ feet seating distance. Consider wall width and ceiling height when choosing.",
  },
  {
    question: "Can I project on a wall instead of a screen?",
    answer: "Yes, but image quality will be lower than a dedicated screen. White or light gray walls work best. For optimal results, use projector screen paint (gain 1.0-1.3) on a smooth wall. A proper screen provides better contrast, color accuracy, and viewing angles.",
  },
  {
    question: "How do I choose between ceiling mount and table placement?",
    answer: "Ceiling mounting keeps the projector out of the way and provides a cleaner setup, but requires professional installation. Table or shelf placement is easier to set up and adjust but may obstruct viewing paths. Consider lens shift capability for flexibility in either setup.",
  },
  {
    question: "What lumens do I need for my projector?",
    answer: "For dark home theaters: 1,500-2,500 lumens. For rooms with some ambient light: 2,500-3,500 lumens. For bright rooms or outdoor use: 3,500+ lumens. Larger screens require more lumens. A 100 inch screen in a dark room needs about 1,500 lumens; a 150 inch screen needs 3,000+ lumens.",
  },
  {
    question: "What is lens shift and why does it matter?",
    answer: "Lens shift allows you to move the projected image up, down, left, or right without moving the projector itself. This provides flexibility in projector placement without causing image distortion (keystone). Vertical lens shift is common; horizontal lens shift is found on higher-end models.",
  },
  {
    question: "What projector screen size fits a 12 foot room?",
    answer: "For many 12 foot rooms, 100 inches is the safest starting point. A 120 inch screen can still work with careful seating and the right throw ratio, but 100 inches is more forgiving for brightness, wall width, and multipurpose living-room use.",
  },
  {
    question: "Is 150 inch too big for a living room?",
    answer: "Often yes. A 150 inch screen usually needs a larger room, better light control, and a brighter projector. In many standard living rooms, 100 or 120 inches is a more practical choice.",
  },
];

// SoftwareApplication Schema for the calculator tool
const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Projector Screen Size Calculator",
  description: description,
  applicationCategory: "UtilityApplication",
  operatingSystem: "All",
  url: `${siteConfig.siteUrl}/projector-screen-size-calculator`,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
};

// Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: siteConfig.siteUrl,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Calculators",
      item: `${siteConfig.siteUrl}/calculators`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Projector Screen Size Calculator",
      item: `${siteConfig.siteUrl}/projector-screen-size-calculator`,
    },
  ],
};

// HowTo Schema for step-by-step guide
const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: "How to Calculate Projector Throw Distance",
  description:
    "Learn how to calculate the optimal projector placement distance based on screen size and throw ratio.",
  totalTime: "PT5M",
  step: [
    {
      "@type": "HowToStep",
      position: 1,
      name: "Enter Screen Size",
      text: "Input your desired projection screen size (diagonal measurement in inches or cm). The calculator will show the screen width.",
    },
    {
      "@type": "HowToStep",
      position: 2,
      name: "Select Throw Ratio",
      text: "Choose your projector's throw ratio from the dropdown (0.5 for ultra short throw, 1.5 for standard, 2.0+ for long throw).",
    },
    {
      "@type": "HowToStep",
      position: 3,
      name: "Get Throw Distance",
      text: "The calculator instantly shows the exact distance to place your projector from the screen or wall.",
    },
    {
      "@type": "HowToStep",
      position: 4,
      name: "Check Wall Width",
      text: "See minimum wall width required (includes 10% margin) to ensure the projection fits your space.",
    },
  ],
};
---

<Layout title={title} description={description} keywords={keywords} modifiedTime={updatedDate}>

  <main class="flex-1">
    <!-- Hero Section -->
    <section
      class="bg-gradient-to-b from-indigo-50 to-white dark:from-indigo-900/20 dark:to-gray-900 py-12 lg:py-16"
    >
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Breadcrumb Navigation -->
        <nav class="mb-6 overflow-x-auto" aria-label="Breadcrumb">
          <ol
            class="flex items-center gap-1 sm:gap-2 text-xs sm:text-sm text-gray-600 dark:text-gray-400 whitespace-nowrap"
          >
            <li>
              <a
                href="/"
                class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                >Home</a
              >
            </li>
            <li>
              <svg
                class="w-3 h-3 sm:w-4 sm:h-4 flex-shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path></svg
              >
            </li>
            <li>
              <a
                href="/calculators"
                class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                >Calculators</a
              >
            </li>
            <li>
              <svg
                class="w-3 h-3 sm:w-4 sm:h-4 flex-shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path></svg
              >
            </li>
            <li>
              <span class="text-gray-900 dark:text-gray-100 font-medium"
                >Projector Screen Size Calculator</span
              >
            </li>
          </ol>
        </nav>

        <div class="text-center">
          <h1
            class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-gray-100 mb-4"
          >
            Projector Screen Size Calculator
          </h1>
          <p
            class="text-lg text-gray-600 dark:text-gray-300 max-w-3xl mx-auto mb-6"
          >
            Calculate exact projector placement distance and throw ratio for your
            home theater. Get instant throw distance, minimum wall width, and
            screen size recommendations for any projector.
          </p>
          <div
            class="flex flex-wrap justify-center gap-3 text-sm text-gray-600 dark:text-gray-400"
          >
          <span class="flex items-center gap-1">
            <svg
              class="w-5 h-5 text-indigo-600 dark:text-indigo-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"></path>
            </svg>
            Throw Ratio Calculator
          </span>
          <span class="flex items-center gap-1">
            <svg
              class="w-5 h-5 text-indigo-600 dark:text-indigo-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"></path>
            </svg>
            Wall Width Requirements
          </span>
          <span class="flex items-center gap-1">
            <svg
              class="w-5 h-5 text-indigo-600 dark:text-indigo-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"></path>
            </svg>
            All Projector Types
          </span>
        </div>
      </div>
    </section>

    <!-- Calculator Section -->
    <section class="py-12 lg:py-16" id="calculator">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <ScreenSizeCalculator client:load initialDeviceMode="projector" showTabs={false} />
      </div>
    </section>

    <!-- How to Use Guide -->
    <section class="py-12 lg:py-16 bg-gray-50 dark:bg-gray-800/50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2
          class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100 mb-8 text-center"
        >
          How to Calculate Throw Distance
        </h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div
            class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm border border-gray-100 dark:border-gray-700"
          >
            <div class="flex items-start gap-4">
              <div
                class="bg-indigo-100 dark:bg-indigo-900/50 rounded-lg p-3 text-indigo-600 dark:text-indigo-400 font-bold text-xl"
              >
                1
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">
                  Enter Screen Size
                </h3>
                <p class="text-gray-600 dark:text-gray-400 text-sm">
                  Input your desired projection screen size (diagonal
                  measurement in inches or cm). The calculator will show the
                  screen width.
                </p>
              </div>
            </div>
          </div>
          <div
            class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm border border-gray-100 dark:border-gray-700"
          >
            <div class="flex items-start gap-4">
              <div
                class="bg-indigo-100 dark:bg-indigo-900/50 rounded-lg p-3 text-indigo-600 dark:text-indigo-400 font-bold text-xl"
              >
                2
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">
                  Select Throw Ratio
                </h3>
                <p class="text-gray-600 dark:text-gray-400 text-sm">
                  Choose your projector's throw ratio from the dropdown (0.5 for
                  ultra short throw, 1.5 for standard, 2.0+ for long throw).
                </p>
              </div>
            </div>
          </div>
          <div
            class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm border border-gray-100 dark:border-gray-700"
          >
            <div class="flex items-start gap-4">
              <div
                class="bg-indigo-100 dark:bg-indigo-900/50 rounded-lg p-3 text-indigo-600 dark:text-indigo-400 font-bold text-xl"
              >
                3
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">
                  Get Throw Distance
                </h3>
                <p class="text-gray-600 dark:text-gray-400 text-sm">
                  The calculator instantly shows the exact distance to place
                  your projector from the screen or wall.
                </p>
              </div>
            </div>
          </div>
          <div
            class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm border border-gray-100 dark:border-gray-700"
          >
            <div class="flex items-start gap-4">
              <div
                class="bg-indigo-100 dark:bg-indigo-900/50 rounded-lg p-3 text-indigo-600 dark:text-indigo-400 font-bold text-xl"
              >
                4
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">
                  Check Wall Width
                </h3>
                <p class="text-gray-600 dark:text-gray-400 text-sm">
                  See minimum wall width required (includes 10% margin) to
                  ensure the projection fits your space.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Best Projector Size by Room Depth -->
    <section class="py-12 lg:py-16 bg-gray-50 dark:bg-gray-800/50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100 mb-4 text-center">
          Best Projector Size by Room Depth
        </h2>
        <p class="text-gray-600 dark:text-gray-400 text-center max-w-3xl mx-auto mb-8">
          Use these fast picks before you fine-tune your setup. For a deeper breakdown, read
          <a href="/blog/100-vs-120-vs-150-inch-projector-screen" class="font-medium text-indigo-600 dark:text-indigo-400 hover:underline">100 vs 120 vs 150 Inch Projector Screen</a>
          and
          <a href="/blog/tv-vs-projector-for-living-room" class="font-medium text-indigo-600 dark:text-indigo-400 hover:underline">TV vs Projector for Living Room</a>.
        </p>
        <div class="grid md:grid-cols-2 xl:grid-cols-4 gap-6">
          {roomSizeQuickPicks.map((pick) => (
            <div class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm border border-gray-100 dark:border-gray-700">
              <div class="text-sm font-medium text-indigo-600 dark:text-indigo-400 mb-2">{pick.room}</div>
              <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-2">{pick.size}</h3>
              <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">{pick.fit}</p>
              <div class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-500">Standard throw reference</div>
              <div class="mt-1 font-semibold text-gray-900 dark:text-gray-200">{pick.standardThrow}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Throw Ratio Guide -->
    <section class="py-12 lg:py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2
          class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100 mb-8 text-center"
        >
          Projector Throw Ratio Guide
        </h2>
        <div class="overflow-x-auto">
          <table
            class="w-full bg-white dark:bg-gray-800 rounded-xl shadow-sm overflow-hidden border border-gray-100 dark:border-gray-700"
          >
            <thead
              class="bg-gradient-to-r from-indigo-600 to-indigo-700 text-white"
            >
              <tr>
                <th class="px-6 py-4 text-left font-semibold">Projector Type</th
                >
                <th class="px-6 py-4 text-left font-semibold">Throw Ratio</th>
                <th class="px-6 py-4 text-left font-semibold"
                  >100" Screen Distance</th
                >
                <th class="px-6 py-4 text-left font-semibold">Best For</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                <td
                  class="px-6 py-4 font-medium text-gray-900 dark:text-gray-200"
                  >Ultra Short Throw</td
                >
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300"
                  >0.25 - 0.5</td
                >
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400"
                  >8" - 20"</td
                >
                <td class="px-6 py-4 text-sm text-gray-600 dark:text-gray-400"
                  >Small rooms, living rooms</td
                >
              </tr>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                <td
                  class="px-6 py-4 font-medium text-gray-900 dark:text-gray-200"
                  >Short Throw</td
                >
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300"
                  >0.5 - 1.2</td
                >
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400"
                  >3' - 8'</td
                >
                <td class="px-6 py-4 text-sm text-gray-600 dark:text-gray-400"
                  >Apartments, medium rooms</td
                >
              </tr>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                <td
                  class="px-6 py-4 font-medium text-gray-900 dark:text-gray-200"
                  >Standard Throw</td
                >
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300"
                  >1.2 - 2.0</td
                >
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400"
                  >8' - 16'</td
                >
                <td class="px-6 py-4 text-sm text-gray-600 dark:text-gray-400"
                  >Home theaters, large rooms</td
                >
              </tr>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                <td
                  class="px-6 py-4 font-medium text-gray-900 dark:text-gray-200"
                  >Long Throw</td
                >
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300"
                  >2.0 - 5.0+</td
                >
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400"
                  >16' - 40'+</td
                >
                <td class="px-6 py-4 text-sm text-gray-600 dark:text-gray-400"
                  >Auditoriums, large venues</td
                >
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Use Case Scenarios -->
    <UseCaseScenarios
      title="Projector Recommendations by Use Case"
      subtitle="Different projection needs require different setups. Find the ideal configuration for your specific scenario."
      useCases={projectorUseCases}
      themeColor="indigo"
    />

    <!-- Quick Reference Table -->
    <section class="py-12 lg:py-16 bg-gray-50 dark:bg-gray-800/50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2
          class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100 mb-8 text-center"
        >
          Throw Distance Quick Reference
        </h2>
        <div class="overflow-x-auto">
          <table
            class="w-full bg-white dark:bg-gray-800 rounded-xl shadow-sm overflow-hidden border border-gray-100 dark:border-gray-700"
          >
            <thead class="bg-gray-100 dark:bg-gray-700">
              <tr>
                <th
                  class="px-6 py-4 text-left font-semibold text-gray-900 dark:text-gray-200"
                  >Screen Size</th
                >
                <th
                  class="px-6 py-4 text-left font-semibold text-gray-900 dark:text-gray-200"
                  >Ultra Short (0.4)</th
                >
                <th
                  class="px-6 py-4 text-left font-semibold text-gray-900 dark:text-gray-200"
                  >Short (0.8)</th
                >
                <th
                  class="px-6 py-4 text-left font-semibold text-gray-900 dark:text-gray-200"
                  >Standard (1.5)</th
                >
                <th
                  class="px-6 py-4 text-left font-semibold text-gray-900 dark:text-gray-200"
                  >Long (2.0)</th
                >
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                <td
                  class="px-6 py-4 font-medium text-gray-900 dark:text-gray-200"
                  >80" (70" wide)</td
                >
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300"
                  >2.3 ft</td
                >
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300"
                  >4.7 ft</td
                >
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300"
                  >8.8 ft</td
                >
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300"
                  >11.7 ft</td
                >
              </tr>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                <td
                  class="px-6 py-4 font-medium text-gray-900 dark:text-gray-200"
                  >100" (87" wide)</td
                >
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300"
                  >2.9 ft</td
                >
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300"
                  >5.8 ft</td
                >
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300"
