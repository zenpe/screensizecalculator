        </div>

        <!-- More Calculators -->
        <div class="mt-8">
          <RelatedCalculators
            exclude={["monitor-screen-size-calculator"]}
            highlight="tv-screen-size-calculator"
            title="More Screen Calculators"
            subtitle="Need more screen calculations? Try our other free tools:"
          />
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="bg-gradient-to-r from-blue-600 to-blue-700 py-12 lg:py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">
          Ready to Find Your Perfect Monitor?
        </h2>
        <p class="text-blue-100 dark:text-blue-200 mb-8 max-w-2xl mx-auto">
