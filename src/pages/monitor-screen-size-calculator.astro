---
import Layout from "../layouts/Layout.astro";
import ScreenSizeCalculator from "../components/ScreenSizeCalculator";
import RelatedCalculators from "../components/RelatedCalculators.astro";
import UseCaseScenarios from "../components/UseCaseScenarios.astro";
import FAQSection from "../components/FAQSection.astro";
import type { UseCase } from "../components/UseCaseScenarios.astro";
import { siteConfig } from "../site.config";

// Use case scenarios for Monitor users
const monitorUseCases: UseCase[] = [
  {
    icon: 'code',
    title: 'Software Developers',
    audience: 'Programmers & web developers',
    recommendations: [
      '27-32 inch for comfortable code viewing',
      '1440p or 4K for crisp text rendering',
      'Consider ultrawide for side-by-side windows',
      '100+ PPI for extended coding sessions'
    ],
    proTip: 'A 27" 1440p monitor offers the ideal balance of sharpness and real estate. Enable font smoothing and use dark themes to reduce eye strain.'
  },
  {
    icon: 'design',
    title: 'Graphic Designers',
    audience: 'UI/UX designers & digital artists',
    recommendations: [
      '27-32 inch 4K for detailed design work',
      'Color-accurate display (sRGB 100%, DCI-P3)',
      'Factory calibrated with Delta E < 2',
      'Consider curved for reduced edge distortion'
    ],
    proTip: 'Invest in a monitor with hardware calibration support. USB-C connectivity simplifies cable management with laptops.'
  },
  {
    icon: 'game',
    title: 'PC Gamers',
    audience: 'Competitive & casual gamers',
    recommendations: [
      '24-27 inch for competitive (fast reactions)',
      '27-32 inch for immersive single-player',
      '144Hz+ refresh rate for smooth gameplay',
      '1ms response time for fast-paced games'
    ],
    proTip: 'Match your GPU power to resolution: GTX 1660 for 1080p, RTX 3070 for 1440p, RTX 4080+ for 4K gaming at high refresh rates.'
  }
];
const title = "Monitor Screen Size Calculator - Display Dimensions & PPI";
const description =
  "Calculate monitor display size and screen dimensions with PPI analysis. Find the ideal monitor for your desk with optimal viewing distance for 1440p & 4K displays.";
const keywords =
  "monitor display size calculator, monitor display size, monitor size calculator, monitor viewing distance calculator, monitor screen size, optimal monitor size, best monitor size for desk, 1440p monitor size, 4k monitor size calculator";

// FAQ data
const faqs = [
  {
    question: "How far should I sit from a 27 inch monitor?",
    answer: `<p class="mb-3">For a <strong>27 inch 1440p monitor</strong>, the ideal viewing distance is <strong>2.5-3.5 feet</strong> based on your screen setup and preferences.</p><p>For 4K monitors, you can sit closer (2-2.5 feet) without seeing pixels. The 3-5 times diagonal rule is a good starting point: 27 inches × 3 ÷ 12 = 6.75 feet maximum distance.</p>`,
  },
  {
    question: "What size monitor for 1080p vs 1440p vs 4K?",
    answer: `<p class="mb-3">For <strong>1080p</strong>: Up to 24 inches is ideal to avoid seeing pixels.</p><p class="mb-3">For <strong>1440p</strong>: 24-32 inches recommended.</p><p>For <strong>4K</strong>: 27 inches and up, with larger sizes (32+ inches) offering better value. At 32 inches, 1440p is sharp but 4K provides more crispness and workspace.</p>`,
  },
  {
    question: "Is bigger monitor always better?",
    answer: `<p class="mb-3">Not always. A monitor that's too large for close desk work can cause <strong>neck strain</strong> as you turn your head to view content.</p><p>Consider your desk space, viewing distance, and intended use. For general productivity, 24-27 inches is ideal. For immersive gaming or design work, 32+ inches may be better.</p>`,
  },
  {
    question: "What's the difference between 1440p and 4K for monitor size?",
    answer: `<p class="mb-3">4K monitors can be viewed <strong>41% closer</strong> than 1080p without seeing pixels, allowing larger monitors in the same space.</p><p>For 27 inches: 1440p PPI ≈ 109, 4K PPI ≈ 163. For 32 inches: 1440p PPI ≈ 92, 4K PPI ≈ 138. Higher PPI means sharper text and images.</p>`,
  },
  {
    question: "What is the best monitor size for programming?",
    answer: `<p class="mb-3">For programming, <strong>27-32 inch monitors</strong> with 1440p or 4K resolution are ideal. The extra screen real estate allows for side-by-side code windows.</p><p>A 27 inch 1440p monitor offers the best balance of sharpness and workspace. Consider ultrawide monitors (34 inches) for even more horizontal space without neck strain.</p>`,
  },
  {
    question: "Is 32 inch monitor too big for desk?",
    answer: `<p class="mb-3">A 32 inch monitor works well if your desk is at least <strong>24-30 inches deep</strong>, allowing 2-3 feet viewing distance.</p><p>At closer distances, you may need to turn your head to see corners. For shallow desks (under 24 inches), consider 27 inches instead. 32 inch is excellent for multitasking and content creation.</p>`,
  },
  {
    question: "What monitor size is best for gaming?",
    answer: `<p class="mb-3">For <strong>competitive gaming</strong>, 24-27 inch monitors at 1080p-1440p offer fast response times and easy visibility.</p><p class="mb-3">For <strong>immersive gaming</strong>, 27-32 inch 1440p or 4K monitors are ideal.</p><p>Ultrawide 34 inch monitors provide a cinematic experience. Match your graphics card capability to the resolution for smooth gameplay.</p>`,
  },
  {
    question: "How do I calculate monitor PPI?",
    answer: `<p class="mb-3">Monitor PPI = <strong>√(width² + height²) ÷ diagonal size</strong>.</p><p class="mb-3">For example, a 27 inch 2560×1440 monitor: √(2560² + 1440²) ÷ 27 = <strong>109 PPI</strong>.</p><p>Higher PPI means sharper text and images. For comfortable viewing at arm's length, aim for 90-110 PPI minimum, or 140+ PPI for retina-quality sharpness.</p>`,
  },
  {
    question: "Should I get a curved or flat monitor?",
    answer: `<p class="mb-3">Curved monitors (1000R-1800R) reduce eye strain on larger screens (32+ inches) by keeping edges equidistant from your eyes.</p><p>For 27 inches and smaller, flat monitors are fine. Curved monitors are excellent for immersive gaming and ultrawide displays but may cause slight image distortion for precise design work.</p>`,
  },
  {
    question: "What is the ideal monitor height for ergonomics?",
    answer: `<p class="mb-3">The ideal monitor height positions the <strong>top of the screen at or slightly below eye level</strong> when sitting upright.</p><p>This typically means the center of the screen is about 15-20 degrees below your horizontal eye line. Use a monitor arm or stand to achieve proper height and reduce neck strain during long work sessions.</p>`,
  },
];

// SoftwareApplication Schema for the calculator tool
const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Monitor Size Calculator",
  description: description,
  applicationCategory: "UtilityApplication",
  operatingSystem: "All",
  url: `${siteConfig.siteUrl}/monitor-screen-size-calculator`,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
};

// Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: siteConfig.siteUrl,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Calculators",
      item: `${siteConfig.siteUrl}/calculators`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Monitor Screen Size Calculator",
      item: `${siteConfig.siteUrl}/monitor-screen-size-calculator`,
    },
  ],
};

// HowTo Schema for step-by-step guide
const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: "How to Find Your Perfect Monitor Size",
  description:
    "Learn how to choose the ideal monitor size for your desk based on resolution, PPI, and viewing distance.",
  totalTime: "PT5M",
  step: [
    {
      "@type": "HowToStep",
      position: 1,
      name: "Measure Your Desk Space",
      text: "Measure how much desk space you have available for your monitor. Consider bezels and any stand dimensions.",
    },
    {
      "@type": "HowToStep",
      position: 2,
      name: "Enter Monitor Size",
      text: "Input your desired monitor diagonal size in inches or cm. The calculator shows dimensions and resolution quality.",
    },
    {
      "@type": "HowToStep",
      position: 3,
      name: "Select Resolution",
      text: "Choose your monitor's resolution (1080p, 1440p, 4K) to see the optimal size range and PPI.",
    },
    {
      "@type": "HowToStep",
      position: 4,
      name: "Review Specifications",
      text: "Get exact width, height, area, PPI, and pixel density. Perfect for comparing different monitor sizes.",
    },
  ],
};
---

<Layout title={title} description={description} keywords={keywords}>

  <main class="flex-1">
    <!-- Hero Section -->
    <section
      class="bg-gradient-to-b from-blue-50 to-white dark:from-blue-900/20 dark:to-gray-900 py-12 lg:py-16"
    >
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Breadcrumb Navigation -->
        <nav class="mb-6 overflow-x-auto" aria-label="Breadcrumb">
          <ol
            class="flex items-center gap-1 sm:gap-2 text-xs sm:text-sm text-gray-600 dark:text-gray-400 whitespace-nowrap"
          >
            <li>
              <a
                href="/"
                class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                >Home</a
              >
            </li>
            <li>
              <svg
                class="w-3 h-3 sm:w-4 sm:h-4 flex-shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path></svg
              >
            </li>
            <li>
              <a
                href="/calculators"
                class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                >Calculators</a
              >
            </li>
            <li>
              <svg
                class="w-3 h-3 sm:w-4 sm:h-4 flex-shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path></svg
              >
            </li>
            <li>
              <span class="text-gray-900 dark:text-gray-100 font-medium"
                >Monitor Screen Size Calculator</span
              >
            </li>
          </ol>
        </nav>

        <div class="text-center">
          <h1
            class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-gray-100 mb-4"
          >
            Monitor Screen Size Calculator & Resolution Tool
          </h1>
          <p
            class="text-lg text-gray-600 dark:text-gray-300 max-w-3xl mx-auto mb-6"
          >
            Find the perfect monitor display size for your desk with optimal resolution
            recommendations. Calculate screen dimensions, PPI, and workspace area
            for any monitor size. Perfect for productivity, gaming, and creative
            work.
          </p>
          <div
            class="flex flex-wrap justify-center gap-3 text-sm text-gray-600 dark:text-gray-400"
          >
          <span class="flex items-center gap-1">
            <svg
              class="w-5 h-5 text-blue-600 dark:text-blue-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"></path>
            </svg>
            Resolution Comparison
          </span>
          <span class="flex items-center gap-1">
            <svg
              class="w-5 h-5 text-blue-600 dark:text-blue-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"></path>
            </svg>
            PPI & Workspace Area
          </span>
          <span class="flex items-center gap-1">
            <svg
              class="w-5 h-5 text-blue-600 dark:text-blue-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"></path>
            </svg>
            Desk Space Planning
          </span>
        </div>
      </div>
    </section>

    <!-- Calculator Section -->
    <section class="py-12 lg:py-16" id="calculator">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <ScreenSizeCalculator client:load initialDeviceMode="monitor" showTabs={false} />
      </div>
    </section>

    <!-- How to Use Guide -->
    <section class="py-12 lg:py-16 bg-gray-50 dark:bg-gray-800/50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2
          class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100 mb-8 text-center"
        >
          How to Find Your Perfect Monitor Size
        </h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div
            class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm border border-gray-100 dark:border-gray-700"
          >
            <div class="flex items-start gap-4">
              <div
                class="bg-blue-100 dark:bg-blue-900/50 rounded-lg p-3 text-blue-600 dark:text-blue-400 font-bold text-xl"
              >
                1
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">
                  Measure Your Desk Space
                </h3>
                <p class="text-gray-600 dark:text-gray-400 text-sm">
                  Measure how much desk space you have available for your
                  monitor. Consider bezels and any stand dimensions.
                </p>
              </div>
            </div>
          </div>
          <div
            class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm border border-gray-100 dark:border-gray-700"
          >
            <div class="flex items-start gap-4">
              <div
                class="bg-blue-100 dark:bg-blue-900/50 rounded-lg p-3 text-blue-600 dark:text-blue-400 font-bold text-xl"
              >
                2
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">
                  Enter Monitor Size
                </h3>
                <p class="text-gray-600 dark:text-gray-400 text-sm">
                  Input your desired monitor diagonal size in inches or cm. The
                  calculator shows dimensions and resolution quality.
                </p>
              </div>
            </div>
          </div>
          <div
            class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm border border-gray-100 dark:border-gray-700"
          >
            <div class="flex items-start gap-4">
              <div
                class="bg-blue-100 dark:bg-blue-900/50 rounded-lg p-3 text-blue-600 dark:text-blue-400 font-bold text-xl"
              >
                3
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">
                  Select Resolution
                </h3>
                <p class="text-gray-600 dark:text-gray-400 text-sm">
                  Choose your monitor's resolution (1080p, 1440p, 4K) to see the
                  optimal size range and PPI.
                </p>
              </div>
            </div>
          </div>
          <div
            class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm border border-gray-100 dark:border-gray-700"
          >
            <div class="flex items-start gap-4">
              <div
                class="bg-blue-100 dark:bg-blue-900/50 rounded-lg p-3 text-blue-600 dark:text-blue-400 font-bold text-xl"
              >
                4
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">
                  Review Specifications
                </h3>
                <p class="text-gray-600 dark:text-gray-400 text-sm">
                  Get exact width, height, area, PPI, and pixel density. Perfect
                  for comparing different monitor sizes.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Use Case Scenarios -->
    <UseCaseScenarios
      title="Monitor Recommendations by Use Case"
      subtitle="Different work styles demand different monitor setups. Find the perfect display configuration for your specific needs."
      useCases={monitorUseCases}
      themeColor="blue"
    />

    <!-- Quick Reference Guide -->
    <section class="py-12 lg:py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2
          class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100 mb-8 text-center"
        >
          Monitor Size Quick Reference Guide
        </h2>
        <div class="overflow-x-auto">
          <table
            class="w-full bg-white dark:bg-gray-800 rounded-xl shadow-sm overflow-hidden border border-gray-100 dark:border-gray-700"
          >
            <thead
              class="bg-gradient-to-r from-blue-600 to-blue-700 text-white"
            >
              <tr>
                <th class="px-6 py-4 text-left font-semibold">Monitor Size</th>
                <th class="px-6 py-4 text-left font-semibold"
                  >Best Resolution</th
                >
                <th class="px-6 py-4 text-left font-semibold"
                  >Screen Width × Height</th
                >
                <th class="px-6 py-4 text-left font-semibold"
                  >PPI (Sharpness)</th
                >
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                <td
                  class="px-6 py-4 font-medium text-gray-900 dark:text-gray-200"
                  >21-24 inches</td
                >
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300"
                  >1080p (Ideal for 21-22")</td
                >
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400 text-sm"
                  >18" × 10" - 21" × 12"</td
                >
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400 text-sm"
                  >81-92 PPI (Standard)</td
                >
              </tr>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                <td
                  class="px-6 py-4 font-medium text-gray-900 dark:text-gray-200"
                  >24-27 inches</td
                >
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300"
                  >1440p (Sweet Spot)</td
                >
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400 text-sm"
                  >21" × 12" - 24" × 13"</td
                >
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400 text-sm"
                  >109-124 PPI (Sharp)</td
                >
              </tr>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                <td
                  class="px-6 py-4 font-medium text-gray-900 dark:text-gray-200"
                  >27-32 inches</td
                >
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300"
                  >4K (Recommended)</td
                >
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400 text-sm"
                  >24" × 13" - 28" × 16"</td
                >
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400 text-sm"
                  >138-147 PPI (Very Sharp)</td
                >
              </tr>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                <td
                  class="px-6 py-4 font-medium text-gray-900 dark:text-gray-200"
                  >32+ inches</td
                >
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300"
                  >4K or 5K (Best)</td
                >
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400 text-sm"
                  >28" × 16" or larger</td
                >
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400 text-sm"
                  >138+ PPI (Crisp)</td
                >
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <FAQSection faqs={faqs} />

    <!-- Related Guides -->
    <section class="py-12 lg:py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2
          class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100 mb-8 text-center"
        >
          Related Guides
        </h2>
        <div class="grid md:grid-cols-3 gap-6">
          <a
            href="/blog/choosing-right-monitor-size"
            class="bg-white dark:bg-gray-800 rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-shadow group border border-gray-100 dark:border-gray-700"
          >
            <div class="p-6">
              <span
                class="inline-block px-3 py-1 bg-blue-100 dark:bg-blue-900/50 text-blue-700 dark:text-blue-300 rounded-full text-xs font-medium mb-3"
              >
                Monitor Buying Guide
              </span>
              <h3
                class="text-lg font-bold text-gray-900 dark:text-gray-200 mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400"
              >
                How to Choose the Right Monitor Size
              </h3>
              <p class="text-gray-600 dark:text-gray-400 text-sm mb-3">
                Complete guide to selecting the perfect monitor size based on
                desk space and usage scenarios.
              </p>
              <span class="text-blue-600 dark:text-blue-400 text-sm font-medium"
                >Read Guide →</span
              >
            </div>
          </a>

          <a
            href="/tv-screen-size-calculator"
            class="bg-white dark:bg-gray-800 rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-shadow group border border-gray-100 dark:border-gray-700"
          >
            <div class="p-6">
              <span
                class="inline-block px-3 py-1 bg-emerald-100 dark:bg-emerald-900/50 text-emerald-700 dark:text-emerald-300 rounded-full text-xs font-medium mb-3"
              >
                Calculator Tool
              </span>
              <h3
                class="text-lg font-bold text-gray-900 dark:text-gray-200 mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400"
              >
                TV Screen Size Calculator
              </h3>
              <p class="text-gray-600 dark:text-gray-400 text-sm mb-3">
                Calculate optimal TV size and viewing distance based on THX and
                SMPTE standards.
              </p>
              <span class="text-blue-600 dark:text-blue-400 text-sm font-medium"
                >Try Calculator →</span
              >
            </div>
          </a>

          <a
            href="/projector-screen-size-calculator"
            class="bg-white dark:bg-gray-800 rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-shadow group border border-gray-100 dark:border-gray-700"
          >
            <div class="p-6">
              <span
                class="inline-block px-3 py-1 bg-indigo-100 dark:bg-indigo-900/50 text-indigo-700 dark:text-indigo-300 rounded-full text-xs font-medium mb-3"
              >
                Calculator Tool
              </span>
              <h3
                class="text-lg font-bold text-gray-900 dark:text-gray-200 mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400"
              >
                Projector Screen Size Calculator
              </h3>
              <p class="text-gray-600 dark:text-gray-400 text-sm mb-3">
                Calculate exact projector placement distance and throw ratio for
                your setup.
              </p>
              <span class="text-blue-600 dark:text-blue-400 text-sm font-medium"
                >Try Calculator →</span
              >
            </div>
          </a>
        </div>

        <!-- More Calculators -->
        <div class="mt-8">
          <RelatedCalculators
            exclude={["monitor-screen-size-calculator"]}
            highlight="tv-screen-size-calculator"
            title="More Screen Calculators"
            subtitle="Need more screen calculations? Try our other free tools:"
          />
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="bg-gradient-to-r from-blue-600 to-blue-700 py-12 lg:py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">
          Ready to Find Your Perfect Monitor?
        </h2>
        <p class="text-blue-100 dark:text-blue-200 mb-8 max-w-2xl mx-auto">
          Use our calculator above to get instant resolution and PPI
          recommendations for your ideal monitor size.
        </p>
        <a
          href="#calculator"
          class="inline-flex items-center gap-2 bg-white text-blue-600 font-semibold px-6 py-3 rounded-lg hover:bg-blue-50 dark:hover:bg-blue-100 transition-colors"
        >
