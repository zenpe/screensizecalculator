                >
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400 text-sm"
                  >18" × 10" - 21" × 12"</td
                >
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400 text-sm"
                  >81-92 PPI (Standard)</td
                >
              </tr>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                <td
                  class="px-6 py-4 font-medium text-gray-900 dark:text-gray-200"
                  >24-27 inches</td
                >
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300"
                  >1440p (common sweet spot)</td
                >
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400 text-sm"
                  >21" × 12" - 24" × 13"</td
                >
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400 text-sm"
                  >109-124 PPI (Sharp)</td
                >
              </tr>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                <td
                  class="px-6 py-4 font-medium text-gray-900 dark:text-gray-200"
                  >27-32 inches</td
                >
                <td class="px-6 py-4 text-gray-700 dark:text-gray-300"
                  >4K (often best at the upper end)</td
                >
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400 text-sm"
                  >24" × 13" - 28" × 16"</td
                >
                <td class="px-6 py-4 text-gray-600 dark:text-gray-400 text-sm"
