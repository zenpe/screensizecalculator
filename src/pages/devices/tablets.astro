---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { devices, calculateDimensions, calculateDevicePPI } from '../../data/devices';

const tabletDevices = devices.filter(d => d.category === 'tablet').sort((a, b) => b.diagonal - a.diagonal);

const title = 'Tablet Screen Sizes - Complete List';
const description = `Browse ${tabletDevices.length} tablet screen sizes including iPad Pro, iPad Air, Samsung Galaxy Tab, and Surface Pro. Find detailed dimensions, resolutions, and PPI for all devices.`;
---

<Layout title={title} description={description}>
  <Header />

  <main class="max-w-6xl mx-auto px-4 py-8">
    <nav class="mb-6" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
        <li><a href="/" class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors">Home</a></li>
        <li><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg></li>
        <li><a href="/devices" class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors">Devices</a></li>
        <li><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg></li>
        <li class="font-semibold text-gray-900 dark:text-gray-100">Tablets</li>
      </ol>
    </nav>

    <div class="mb-8">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-4">
        Tablet Screen Sizes
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-400">
        {tabletDevices.length} tablets sorted by screen size
      </p>
    </div>

    <div class="grid gap-4 mb-8">
      {tabletDevices.map(device => {
        const dims = calculateDimensions(device.diagonal, device.ratio);
        const ppi = calculateDevicePPI(device);
        return (
          <a href={`/${device.id}-screen-size`} class="group bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-5 hover:shadow-lg hover:border-primary-300 dark:hover:border-primary-700 transition-all">
            <div class="flex items-center justify-between">
              <div class="flex-1">
                <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors mb-2">
                  {device.name}
                </h2>
                <div class="flex flex-wrap gap-4 text-sm text-gray-600 dark:text-gray-400">
                  <div class="flex items-center gap-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
                    </svg>
                    <span>{device.diagonal}" diagonal</span>
                  </div>
                  <div class="flex items-center gap-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5z"></path>
                    </svg>
                    <span>{dims.width.toFixed(2)}" × {dims.height.toFixed(2)}"</span>
                  </div>
                  {device.resolution && (
                    <div class="flex items-center gap-1">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2z"></path>
                      </svg>
                      <span>{device.resolution}</span>
                    </div>
                  )}
                  {ppi && (
                    <div class="flex items-center gap-1">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                      </svg>
                      <span>{Math.round(ppi)} PPI</span>
                    </div>
                  )}
                </div>
              </div>
              <svg class="w-6 h-6 text-gray-400 group-hover:text-primary-600 dark:group-hover:text-primary-400 group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </div>
          </a>
        );
      })}
    </div>

    <div class="text-center">
      <a href="/devices" class="inline-flex items-center gap-2 text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 font-medium transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to All Devices
      </a>
    </div>
  </main>
</Layout>
