---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { devices } from '../../data/devices';

// Group devices by category
const devicesByCategory = {
  phone: devices.filter(d => d.category === 'phone'),
  tablet: devices.filter(d => d.category === 'tablet'),
  tv: devices.filter(d => d.category === 'tv'),
  monitor: devices.filter(d => d.category === 'monitor'),
  projector: devices.filter(d => d.category === 'projector'),
};

// SEO metadata
const title = 'All Screen Sizes - Phones, Tablets, TVs, Monitors & Projectors';
const description = 'Complete database of screen sizes for phones, tablets, TVs, monitors, and projectors. Find detailed dimensions, resolutions, and specifications for all devices.';

// Get latest/popular devices
const latestPhones = devicesByCategory.phone.slice(0, 6);
const popularDevices = [
  ...latestPhones.slice(0, 3),
  devices.find(d => d.id === '65-inch-tv'),
  devices.find(d => d.id === '27-inch-monitor'),
  devices.find(d => d.id === '100-inch-projector-screen'),
].filter(Boolean);

// Category cards data
const categories = [
  {
    name: 'Phones',
    icon: '📱',
    href: '/devices/phones',
    count: devicesByCategory.phone.length,
    description: 'iPhone, Samsung, Google Pixel',
    color: 'from-blue-500 to-cyan-500',
  },
  {
    name: 'Tablets',
    icon: '📱',
    href: '/devices/tablets',
    count: devicesByCategory.tablet.length,
    description: 'iPad, Galaxy Tab, Surface Pro',
    color: 'from-indigo-500 to-purple-500',
  },
  {
    name: 'Monitors',
    icon: '🖥️',
    href: '/devices/monitors',
    count: devicesByCategory.monitor.length,
    description: '24", 27", 32" and ultrawide displays',
    color: 'from-purple-500 to-pink-500',
  },
  {
    name: 'TVs',
    icon: '📺',
    href: '/devices/tvs',
    count: devicesByCategory.tv.length,
    description: '43", 55", 65", 75", 85" televisions',
    color: 'from-green-500 to-emerald-500',
  },
  {
    name: 'Projectors',
    icon: '📽️',
    href: '/devices/projectors',
    count: devicesByCategory.projector.length,
    description: '100", 120", 150" screens',
    color: 'from-orange-500 to-amber-500',
  },
];

// CollectionPage Schema
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": title,
  "description": description,
  "url": "https://screensizecalculators.com/devices"
};
---

<Layout title={title} description={description}>
  <Header />

  <main class="max-w-6xl mx-auto px-4 py-8">
    <!-- Breadcrumb Navigation -->
    <nav class="mb-6" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
        <li>
          <a href="/" class="hover:text-primary-600 dark:hover:text-primary-400">Home</a>
        </li>
        <li class="text-gray-400">/</li>
        <li>
          <span class="text-gray-900 dark:text-gray-100 font-medium">All Devices</span>
        </li>
      </ol>
    </nav>

    <!-- Page Header -->
    <div class="text-center mb-8">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-4">
        Screen Size Database
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
        Browse detailed screen dimensions, resolutions, and specifications for phones, monitors, TVs, and projectors.
      </p>
      <p class="mt-2 text-sm text-gray-500 dark:text-gray-500">
        {devices.length} devices available
      </p>
    </div>

    <!-- Category Cards -->
    <section class="mb-12">
      <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-6">
        Browse by Category
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {categories.map(cat => (
          <a
            href={cat.href}
            class="group relative bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 hover:shadow-lg hover:border-primary-400 dark:hover:border-primary-600 transition-all overflow-hidden"
          >
            <div class={`absolute inset-0 bg-gradient-to-br ${cat.color} opacity-0 group-hover:opacity-5 transition-opacity`}></div>
            <div class="relative">
              <span class="text-3xl mb-3 block">{cat.icon}</span>
              <h3 class="font-bold text-gray-900 dark:text-gray-100 text-lg mb-1 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                {cat.name}
              </h3>
              <p class="text-sm text-gray-500 dark:text-gray-400 mb-3">
                {cat.description}
              </p>
              <span class="text-xs font-medium text-primary-600 dark:text-primary-400">
                {cat.count} devices →
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Popular Devices -->
    <section class="mb-12">
      <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-6 flex items-center gap-2">
        <span class="text-amber-500">★</span> Popular Devices
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {popularDevices.map(device => (
          <a
            href={`/${device.id}-screen-size`}
            class="group bg-gradient-to-br from-primary-50 to-accent-50 dark:from-primary-900/20 dark:to-accent-900/20 border border-primary-200 dark:border-primary-800 rounded-xl p-4 hover:shadow-lg hover:border-primary-400 dark:hover:border-primary-600 transition-all"
          >
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-medium text-primary-600 dark:text-primary-400 uppercase tracking-wide">
                {device.category}
              </span>
              <span class="text-xs text-gray-500 dark:text-gray-400">
                {device.diagonal}"
              </span>
            </div>
            <h3 class="font-semibold text-gray-900 dark:text-gray-100 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
              {device.name}
            </h3>
          </a>
        ))}
      </div>
    </section>

    <!-- Quick Links by Category -->
    <section class="mb-12">
      <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-6">
        Quick Links
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Phone Quick Links -->
        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5">
          <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-3 flex items-center gap-2">
            <span>📱</span> Phones
          </h3>
          <div class="space-y-2">
            {devicesByCategory.phone.slice(0, 5).map(device => (
              <a href={`/${device.id}-screen-size`} class="block text-sm text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400">
                {device.name} ({device.diagonal}")
              </a>
            ))}
          </div>
          <a href="/devices/phones" class="inline-block mt-3 text-sm font-medium text-primary-600 dark:text-primary-400 hover:text-primary-700">
            View all phones →
          </a>
        </div>

        <!-- Tablet Quick Links -->
        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5">
          <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-3 flex items-center gap-2">
            <span>📱</span> Tablets
          </h3>
          <div class="space-y-2">
            {devicesByCategory.tablet.slice(0, 5).map(device => (
              <a href={`/${device.id}-screen-size`} class="block text-sm text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400">
                {device.name}
              </a>
            ))}
          </div>
          <a href="/devices/tablets" class="inline-block mt-3 text-sm font-medium text-primary-600 dark:text-primary-400 hover:text-primary-700">
            View all tablets →
          </a>
        </div>

        <!-- TV Quick Links -->
        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5">
          <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-3 flex items-center gap-2">
            <span>📺</span> TVs
          </h3>
          <div class="space-y-2">
            {devicesByCategory.tv.map(device => (
              <a href={`/${device.id}-screen-size`} class="block text-sm text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400">
                {device.name}
              </a>
            ))}
          </div>
          <a href="/devices/tvs" class="inline-block mt-3 text-sm font-medium text-primary-600 dark:text-primary-400 hover:text-primary-700">
            View all TVs →
          </a>
        </div>

        <!-- Monitor Quick Links -->
        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5">
          <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-3 flex items-center gap-2">
            <span>🖥️</span> Monitors
          </h3>
          <div class="space-y-2">
            {devicesByCategory.monitor.map(device => (
              <a href={`/${device.id}-screen-size`} class="block text-sm text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400">
                {device.name}
              </a>
            ))}
          </div>
          <a href="/devices/monitors" class="inline-block mt-3 text-sm font-medium text-primary-600 dark:text-primary-400 hover:text-primary-700">
            View all monitors →
          </a>
        </div>

        <!-- Projector Quick Links -->
        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5">
          <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-3 flex items-center gap-2">
            <span>📽️</span> Projectors
          </h3>
          <div class="space-y-2">
            {devicesByCategory.projector.map(device => (
              <a href={`/${device.id}-screen-size`} class="block text-sm text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400">
                {device.name}
              </a>
            ))}
          </div>
          <a href="/devices/projectors" class="inline-block mt-3 text-sm font-medium text-primary-600 dark:text-primary-400 hover:text-primary-700">
            View all projectors →
          </a>
        </div>
      </div>
    </section>

    <!-- Back to Home -->
    <div class="text-center">
      <a href="/" class="inline-flex items-center gap-2 text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 font-medium transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to Home
      </a>
    </div>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
</Layout>
