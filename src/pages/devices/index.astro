---
import Layout from '../../layouts/Layout.astro';
import CategoryIcon from '../../components/icons/CategoryIcon.astro';
import DeviceSearch from '../../components/DeviceSearch';
import { devices, parseResolution } from '../../data/devices';
import { getComparisonBrowseUrl, siteConfig } from '../../site.config';
import { getDevicePageUrl } from '../../utils/url';

// Group devices by category
const devicesByCategory = {
  phone: devices.filter(d => d.category === 'phone'),
  tablet: devices.filter(d => d.category === 'tablet'),
  tv: devices.filter(d => d.category === 'tv'),
  monitor: devices.filter(d => d.category === 'monitor'),
  projector: devices.filter(d => d.category === 'projector'),
};

// SEO metadata
const title = 'All Screen Sizes - Phones, Tablets, TVs, Monitors & Projectors';
const description = 'Complete database of screen sizes for phones, tablets, TVs, monitors, and projectors. Find detailed dimensions, resolutions, and specifications for all devices.';
const keywords = 'screen sizes, phone screen size, tablet screen size, tv screen size, monitor screen size, projector screen size, display dimensions, screen database, device specifications';

// Get latest/popular devices - dynamically select from each category
const popularDevices = [
  devicesByCategory.phone[0],  // Latest phone
  devicesByCategory.phone[1],  // Second latest phone
  devicesByCategory.tablet[0], // Latest tablet
  devicesByCategory.tv.find(d => d.id === '65-inch-tv') || devicesByCategory.tv[0],
  devicesByCategory.monitor.find(d => d.id === '27-inch-monitor') || devicesByCategory.monitor[0],
  devicesByCategory.projector[0],
].filter(Boolean);

// Category cards data
const categories = [
  { name: 'Phones', category: 'phone' as const, href: '/phones', count: devicesByCategory.phone.length, description: 'iPhone, Samsung, Google Pixel', color: 'green' },
  { name: 'Tablets', category: 'tablet' as const, href: '/devices/tablets', count: devicesByCategory.tablet.length, description: 'iPad, Galaxy Tab, Surface Pro', color: 'indigo' },
  { name: 'TVs', category: 'tv' as const, href: '/devices/tvs', count: devicesByCategory.tv.length, description: '43", 55", 65", 75", 85" televisions', color: 'blue' },
  { name: 'Monitors', category: 'monitor' as const, href: '/devices/monitors', count: devicesByCategory.monitor.length, description: '24", 27", 32" and ultrawide displays', color: 'purple' },
  { name: 'Projectors', category: 'projector' as const, href: '/devices/projectors', count: devicesByCategory.projector.length, description: '100", 120", 150" screens', color: 'amber' },
];

// Color classes for category cards
const colorClasses: Record<string, { bg: string; text: string; border: string }> = {
  green: { bg: 'bg-green-100 dark:bg-green-900/30', text: 'text-green-600 dark:text-green-400', border: 'hover:border-green-400 dark:hover:border-green-600' },
  indigo: { bg: 'bg-indigo-100 dark:bg-indigo-900/30', text: 'text-indigo-600 dark:text-indigo-400', border: 'hover:border-indigo-400 dark:hover:border-indigo-600' },
  blue: { bg: 'bg-blue-100 dark:bg-blue-900/30', text: 'text-blue-600 dark:text-blue-400', border: 'hover:border-blue-400 dark:hover:border-blue-600' },
  purple: { bg: 'bg-purple-100 dark:bg-purple-900/30', text: 'text-purple-600 dark:text-purple-400', border: 'hover:border-purple-400 dark:hover:border-purple-600' },
  amber: { bg: 'bg-amber-100 dark:bg-amber-900/30', text: 'text-amber-600 dark:text-amber-400', border: 'hover:border-amber-400 dark:hover:border-amber-600' },
};

const faqs = [
  {
    question: "How do I find my device's screen size?",
    answer: "Use our search feature or browse by category (Phones, Tablets, TVs, Monitors, Projectors). Each device page shows diagonal size, width, height, resolution, and PPI.",
  },
  {
    question: "What information is available for each device?",
    answer: "Each device listing includes diagonal screen size, width and height dimensions (in inches and cm), resolution, aspect ratio, PPI (pixels per inch), and total megapixels.",
  },
  {
    question: "Can I compare multiple devices?",
    answer: "Yes! Visit our compare tool to select multiple devices and see them side by side. You can compare phones, tablets, TVs, monitors, and projectors.",
  },
  {
    question: "How often is the device database updated?",
    answer: "We regularly update our database with new device releases. Latest phones like iPhone and Samsung Galaxy are added shortly after their official announcements.",
  },
];

// CollectionPage Schema
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": title,
  "description": description,
  "url": `${siteConfig.siteUrl}/devices`
};

// BreadcrumbList Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteConfig.siteUrl
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "All Devices",
      "item": `${siteConfig.siteUrl}/devices`
    }
  ]
};

// ItemList Schema for categories
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Device Categories",
  "numberOfItems": categories.length,
  "itemListElement": categories.map((cat, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": cat.name,
    "url": `${siteConfig.siteUrl}${cat.href}`
  }))
};
---

<Layout title={title} description={description} keywords={keywords}>

  <main class="flex-1">
    <!-- Hero Section -->
    <section class="bg-gradient-to-b from-primary-50 to-white dark:from-gray-800 dark:to-gray-900 pt-6 pb-12 lg:pb-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Breadcrumb -->
        <nav class="mb-8" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400" itemscope itemtype="https://schema.org/BreadcrumbList">
            <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <a href="/" class="hover:text-primary-600 dark:hover:text-primary-400" itemprop="item">
                <span itemprop="name">Home</span>
              </a>
              <meta itemprop="position" content="1" />
            </li>
            <li class="text-gray-400">/</li>
            <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <span class="text-gray-900 dark:text-gray-100 font-medium" itemprop="name">All Devices</span>
              <meta itemprop="position" content="2" />
            </li>
          </ol>
        </nav>

        <div class="text-center">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-gray-100 mb-4">
            Screen Size Database
          </h1>
          <p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto mb-8">
            Browse detailed screen dimensions, resolutions, and specifications for phones, tablets, monitors, TVs, and projectors.
          </p>
          <!-- Stats -->
          <div class="flex flex-wrap justify-center gap-4 text-sm mb-8">
            <div class="flex items-center gap-2 px-4 py-2 bg-white dark:bg-gray-800 rounded-full shadow-sm border border-gray-200 dark:border-gray-700">
              <span class="font-bold text-primary-600 dark:text-primary-400">{devices.length}</span>
              <span class="text-gray-600 dark:text-gray-400">Devices</span>
            </div>
            <div class="flex items-center gap-2 px-4 py-2 bg-white dark:bg-gray-800 rounded-full shadow-sm border border-gray-200 dark:border-gray-700">
              <span class="font-bold text-green-600 dark:text-green-400">{devicesByCategory.phone.length}</span>
              <span class="text-gray-600 dark:text-gray-400">Phones</span>
            </div>
            <div class="flex items-center gap-2 px-4 py-2 bg-white dark:bg-gray-800 rounded-full shadow-sm border border-gray-200 dark:border-gray-700">
              <span class="font-bold text-indigo-600 dark:text-indigo-400">{devicesByCategory.tablet.length}</span>
              <span class="text-gray-600 dark:text-gray-400">Tablets</span>
            </div>
            <div class="flex items-center gap-2 px-4 py-2 bg-white dark:bg-gray-800 rounded-full shadow-sm border border-gray-200 dark:border-gray-700">
              <span class="font-bold text-blue-600 dark:text-blue-400">{devicesByCategory.tv.length}</span>
              <span class="text-gray-600 dark:text-gray-400">TVs</span>
            </div>
            <div class="flex items-center gap-2 px-4 py-2 bg-white dark:bg-gray-800 rounded-full shadow-sm border border-gray-200 dark:border-gray-700">
              <span class="font-bold text-purple-600 dark:text-purple-400">{devicesByCategory.monitor.length}</span>
              <span class="text-gray-600 dark:text-gray-400">Monitors</span>
            </div>
            <div class="flex items-center gap-2 px-4 py-2 bg-white dark:bg-gray-800 rounded-full shadow-sm border border-gray-200 dark:border-gray-700">
              <span class="font-bold text-amber-600 dark:text-amber-400">{devicesByCategory.projector.length}</span>
              <span class="text-gray-600 dark:text-gray-400">Projectors</span>
            </div>
          </div>
          <!-- Search -->
          <DeviceSearch
            client:load
            devices={devices}
            placeholder="Search devices (e.g. iPhone 16, Samsung Galaxy, 65 inch TV)..."
            searchHint="Try searching for iPhone, Samsung, TV, or Monitor"
          />
        </div>
      </div>
    </section>

    <!-- Category Cards -->
    <section class="py-12 lg:py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6">
          Browse by Category
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
          {categories.map(cat => (
            <a
              href={cat.href}
              class={`group bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 hover:shadow-lg transition-all ${colorClasses[cat.color].border}`}
            >
              <div class={`w-12 h-12 rounded-xl ${colorClasses[cat.color].bg} flex items-center justify-center mb-3`}>
                <CategoryIcon icon={cat.category} size="lg" color={colorClasses[cat.color].text} useSvg />
              </div>
              <h3 class="font-bold text-gray-900 dark:text-gray-100 text-lg mb-1 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                {cat.name}
              </h3>
              <p class="text-xs text-gray-500 dark:text-gray-400 mb-2 line-clamp-2">
                {cat.description}
              </p>
              <span class={`text-xs font-medium ${colorClasses[cat.color].text}`}>
                {cat.count} devices
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Popular Devices -->
    <section class="py-12 lg:py-16 bg-gray-50 dark:bg-gray-900">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6 flex items-center gap-2">
          <span class="text-amber-500">★</span> Popular Devices
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {popularDevices.map(device => {
            const resolution = parseResolution(device.resolution);

            return (
              <a
                href={getDevicePageUrl(device.id)}
                class="group bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4 hover:shadow-lg hover:border-primary-400 dark:hover:border-primary-600 transition-all"
              >
                <div class="flex items-center justify-between mb-2">
                  <span class="inline-flex items-center gap-1.5 text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wide">
                    <CategoryIcon icon={device.category} size="xs" />
                    {device.category}
                  </span>
                  <span class="text-sm font-semibold text-primary-600 dark:text-primary-400">
                    {device.diagonal}"
                  </span>
                </div>
                <h3 class="font-semibold text-gray-900 dark:text-gray-100 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                  {device.name}
                </h3>
                {resolution && (
                  <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                    {resolution.w} × {resolution.h}
                  </p>
                )}
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Quick Links by Category -->
    <section class="py-12 lg:py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6">
          Quick Links
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {categories.map(cat => (
            <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5">
              <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-3 flex items-center gap-2">
                <div class={`w-6 h-6 rounded ${colorClasses[cat.color].bg} flex items-center justify-center`}>
                  <CategoryIcon icon={cat.category} size="xs" color={colorClasses[cat.color].text} useSvg />
                </div>
                {cat.name}
              </h3>
              <div class="space-y-2">
                {devicesByCategory[cat.category].slice(0, 5).map(device => (
                  <a href={getDevicePageUrl(device.id)} class="block text-sm text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 truncate">
                    {device.name} {device.category !== 'phone' && device.category !== 'tablet' ? '' : `(${device.diagonal}")`}
                  </a>
                ))}
              </div>
              <a href={cat.href} class={`inline-block mt-3 text-sm font-medium ${colorClasses[cat.color].text}`}>
                View all {cat.name.toLowerCase()} →
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-12 lg:py-16 bg-gray-50 dark:bg-gray-900">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-8">
          Frequently Asked Questions
        </h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <details class="bg-white dark:bg-gray-800 rounded-lg p-6 shadow-sm">
              <summary class="font-semibold text-gray-900 dark:text-gray-100 cursor-pointer">
                {faq.question}
              </summary>
              <p class="mt-3 text-gray-600 dark:text-gray-300">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="bg-gradient-to-br from-primary-700 to-primary-900 py-12 lg:py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">
          Compare Screen Sizes Side by Side
        </h2>
        <p class="text-gray-300 mb-8 max-w-2xl mx-auto">
          Select multiple devices to compare their dimensions, resolutions, and pixel densities visually.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href={getComparisonBrowseUrl()}
            class="inline-flex items-center gap-2 bg-white hover:bg-gray-100 text-primary-700 font-semibold px-6 py-3 rounded-lg transition-colors"
          >
            Compare Devices
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
          <a
            href="/#calculator"
            class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white font-semibold px-6 py-3 rounded-lg transition-colors"
          >
            Use Calculator
          </a>
        </div>
      </div>
    </section>
  </main>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
</Layout>
