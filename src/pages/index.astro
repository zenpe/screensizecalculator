---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScreenSizeCalculator from '../components/ScreenSizeCalculator';

const title = 'Screen Size Calculator - Calculate Display Dimensions, PPI & Aspect Ratio';
const description = 'Free online screen size calculator. Calculate your TV, monitor, or laptop display dimensions, PPI (pixels per inch), and aspect ratio instantly. Enter diagonal size and get accurate measurements.';

// Structured data for SEO
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Screen Size Calculator",
  "description": description,
  "url": "https://screensizecalculator.net",
  "applicationCategory": "UtilityApplication",
  "operatingSystem": "Any",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "Calculate screen width and height from diagonal",
    "PPI (Pixels Per Inch) calculation",
    "Support for multiple aspect ratios",
    "Custom resolution input",
    "Metric and imperial units"
  ]
};

const faqData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I calculate screen size from diagonal?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To calculate screen size from diagonal, you need the aspect ratio. Our calculator uses the Pythagorean theorem automatically - just enter your diagonal size and aspect ratio."
      }
    },
    {
      "@type": "Question",
      "name": "What is PPI and why does it matter?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "PPI (Pixels Per Inch) measures pixel density. Higher PPI means sharper images. Desktop monitors typically have 90-110 PPI, while smartphones have 300-500 PPI."
      }
    },
    {
      "@type": "Question",
      "name": "What is the most common aspect ratio?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "16:9 is the most common aspect ratio for monitors and TVs, used for HD, Full HD, and 4K content."
      }
    }
  ]
};
---

<Layout title={title} description={description}>
  <Header />

  <main class="flex-1">
    <!-- Hero Section -->
    <section class="bg-gradient-to-b from-primary-50 to-white py-12 lg:py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
          Screen Size Calculator
        </h1>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Calculate your display's exact dimensions, pixel density (PPI), and more.
          Perfect for choosing TVs, monitors, laptops, and phones.
        </p>
      </div>
    </section>

    <!-- Calculator Section -->
    <section id="calculator" class="py-12 lg:py-16 scroll-mt-20">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <ScreenSizeCalculator client:load />
      </div>
    </section>

    <!-- How It Works Section -->
    <section id="how-it-works" class="bg-white py-12 lg:py-16 scroll-mt-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 text-center mb-12">
          How Screen Size Calculation Works
        </h2>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="w-14 h-14 bg-primary-100 rounded-xl flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl font-bold text-primary-600">1</span>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Enter Diagonal Size</h3>
            <p class="text-gray-600 text-sm">
              Input your screen's diagonal measurement in inches or centimeters.
            </p>
          </div>

          <div class="text-center">
            <div class="w-14 h-14 bg-primary-100 rounded-xl flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl font-bold text-primary-600">2</span>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Select Aspect Ratio</h3>
            <p class="text-gray-600 text-sm">
              Choose your display's aspect ratio (16:9, 16:10, 4:3, etc.).
            </p>
          </div>

          <div class="text-center">
            <div class="w-14 h-14 bg-primary-100 rounded-xl flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl font-bold text-primary-600">3</span>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Get Instant Results</h3>
            <p class="text-gray-600 text-sm">
              See width, height, area, PPI, and total megapixels instantly.
            </p>
          </div>
        </div>

        <div class="mt-12 bg-gray-50 rounded-xl p-6 lg:p-8">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">The Math Behind It</h3>
          <p class="text-gray-600 mb-4">
            Screen dimensions are calculated using the Pythagorean theorem:
          </p>
          <div class="bg-white rounded-lg p-4 font-mono text-sm text-gray-700 overflow-x-auto">
            <p>Height = diagonal / sqrt(1 + (w/h)^2)</p>
            <p>Width = Height * (w/h)</p>
            <p class="mt-2">PPI = sqrt(px_width^2 + px_height^2) / diagonal</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Common Screen Sizes Section -->
    <section class="py-12 lg:py-16 bg-gray-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 text-center mb-8">
          Common Screen Sizes Reference
        </h2>

        <div class="overflow-x-auto">
          <table class="w-full bg-white rounded-xl shadow-sm overflow-hidden">
            <thead class="bg-primary-600 text-white">
              <tr>
                <th class="px-4 py-3 text-left text-sm font-semibold">Device Type</th>
                <th class="px-4 py-3 text-left text-sm font-semibold">Diagonal</th>
                <th class="px-4 py-3 text-left text-sm font-semibold">Resolution</th>
                <th class="px-4 py-3 text-left text-sm font-semibold">Typical PPI</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3 text-sm text-gray-700">Smartphone</td>
                <td class="px-4 py-3 text-sm text-gray-600">5.5" - 6.7"</td>
                <td class="px-4 py-3 text-sm text-gray-600">1080 x 2400</td>
                <td class="px-4 py-3 text-sm text-gray-600">380 - 450</td>
              </tr>
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3 text-sm text-gray-700">Tablet</td>
                <td class="px-4 py-3 text-sm text-gray-600">10" - 12.9"</td>
                <td class="px-4 py-3 text-sm text-gray-600">2560 x 1600</td>
                <td class="px-4 py-3 text-sm text-gray-600">220 - 280</td>
              </tr>
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3 text-sm text-gray-700">Laptop</td>
                <td class="px-4 py-3 text-sm text-gray-600">13" - 17"</td>
                <td class="px-4 py-3 text-sm text-gray-600">1920 x 1080</td>
                <td class="px-4 py-3 text-sm text-gray-600">120 - 170</td>
              </tr>
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3 text-sm text-gray-700">Desktop Monitor</td>
                <td class="px-4 py-3 text-sm text-gray-600">24" - 32"</td>
                <td class="px-4 py-3 text-sm text-gray-600">2560 x 1440</td>
                <td class="px-4 py-3 text-sm text-gray-600">90 - 120</td>
              </tr>
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3 text-sm text-gray-700">4K TV</td>
                <td class="px-4 py-3 text-sm text-gray-600">50" - 75"</td>
                <td class="px-4 py-3 text-sm text-gray-600">3840 x 2160</td>
                <td class="px-4 py-3 text-sm text-gray-600">55 - 90</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="py-12 lg:py-16 bg-white scroll-mt-20">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 text-center mb-8">
          Frequently Asked Questions
        </h2>

        <div class="space-y-4">
          <details class="group bg-gray-50 rounded-xl">
            <summary class="flex justify-between items-center cursor-pointer p-6">
              <span class="font-medium text-gray-900">How do I calculate screen size from diagonal?</span>
              <svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-6 text-gray-600">
              <p>To calculate screen size from diagonal, you need the aspect ratio (e.g., 16:9). The formula uses the Pythagorean theorem. Our calculator does this automatically - just enter your diagonal size and aspect ratio.</p>
            </div>
          </details>

          <details class="group bg-gray-50 rounded-xl">
            <summary class="flex justify-between items-center cursor-pointer p-6">
              <span class="font-medium text-gray-900">What is PPI and why does it matter?</span>
              <svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-6 text-gray-600">
              <p>PPI (Pixels Per Inch) measures pixel density. Higher PPI means sharper images and text. Desktop monitors typically have 90-110 PPI, while smartphones need 300-500 PPI because they're viewed up close.</p>
            </div>
          </details>

          <details class="group bg-gray-50 rounded-xl">
            <summary class="flex justify-between items-center cursor-pointer p-6">
              <span class="font-medium text-gray-900">What is the most common aspect ratio?</span>
              <svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-6 text-gray-600">
              <p><strong>16:9</strong> is the most common for monitors and TVs. Other popular ratios: 16:10 (productivity), 21:9 (ultrawide), 4:3 (legacy), and 32:9 (super ultrawide).</p>
            </div>
          </details>

          <details class="group bg-gray-50 rounded-xl">
            <summary class="flex justify-between items-center cursor-pointer p-6">
              <span class="font-medium text-gray-900">How do I measure my screen size?</span>
              <svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-6 text-gray-600">
              <p>Measure <strong>diagonally</strong> from one corner to the opposite corner of the visible display area (not the bezel). Use a tape measure from bottom-left to top-right.</p>
            </div>
          </details>

          <details class="group bg-gray-50 rounded-xl">
            <summary class="flex justify-between items-center cursor-pointer p-6">
              <span class="font-medium text-gray-900">What screen size should I buy for my desk?</span>
              <svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-6 text-gray-600">
              <ul class="list-disc list-inside space-y-1">
                <li><strong>24" (1080p)</strong> - Limited space, ~2ft distance</li>
                <li><strong>27" (1440p)</strong> - Sweet spot, 2-3ft distance</li>
                <li><strong>32" (4K)</strong> - Productivity, 2.5-4ft distance</li>
                <li><strong>34" Ultrawide</strong> - Multitasking</li>
              </ul>
            </div>
          </details>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="bg-primary-600 py-12 lg:py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">
          Find Your Perfect Screen Size
        </h2>
        <p class="text-primary-100 mb-8 max-w-2xl mx-auto">
          Whether you're shopping for a new TV, upgrading your monitor, or comparing phone displays - use our calculator to make an informed decision.
        </p>
        <a
          href="#calculator"
          class="inline-flex items-center gap-2 bg-white text-primary-600 font-semibold px-6 py-3 rounded-lg hover:bg-primary-50 transition-colors"
        >
          Try the Calculator
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
          </svg>
        </a>
      </div>
    </section>
  </main>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqData)} />
</Layout>
