---
/**
 * UseCaseScenarios - Displays targeted use case scenarios for different user groups
 *
 * This component helps:
 * - Increase long-tail keyword coverage
 * - Improve user engagement and time on page
 * - Provide personalized recommendations for different user types
 */

export interface UseCase {
  /** Icon name for the use case (rendered as SVG) */
  icon: 'movie' | 'game' | 'sports' | 'code' | 'design' | 'photo' | 'business' | 'read' | 'draw' | 'media' | 'presentation' | 'outdoor' | 'home-theater';
  /** Title of the use case (e.g., "Movie Enthusiasts") */
  title: string;
  /** Target user description */
  audience: string;
  /** Key recommendations as bullet points */
  recommendations: string[];
  /** Pro tip for this use case */
  proTip?: string;
}

interface Props {
  /** Section title */
  title?: string;
  /** Section subtitle */
  subtitle?: string;
  /** Array of use cases to display */
  useCases: UseCase[];
  /** Theme color for the section (matches device type) */
  themeColor?: 'emerald' | 'blue' | 'indigo' | 'purple' | 'rose' | 'amber';
}

const {
  title = "Choose the Right Screen for Your Needs",
  subtitle = "Different activities require different screen considerations. Find the perfect setup for your specific use case.",
  useCases,
  themeColor = 'emerald'
} = Astro.props;

// Color mappings for different themes
const colorMap = {
  emerald: {
    iconBg: 'bg-emerald-100 dark:bg-emerald-900/50',
    iconText: 'text-emerald-600 dark:text-emerald-400',
    tipBg: 'bg-emerald-50 dark:bg-emerald-900/30',
    tipBorder: 'border-emerald-200 dark:border-emerald-800',
    tipText: 'text-emerald-800 dark:text-emerald-200',
    tipLabel: 'text-emerald-600 dark:text-emerald-400'
  },
  blue: {
    iconBg: 'bg-blue-100 dark:bg-blue-900/50',
    iconText: 'text-blue-600 dark:text-blue-400',
    tipBg: 'bg-blue-50 dark:bg-blue-900/30',
    tipBorder: 'border-blue-200 dark:border-blue-800',
    tipText: 'text-blue-800 dark:text-blue-200',
    tipLabel: 'text-blue-600 dark:text-blue-400'
  },
  indigo: {
    iconBg: 'bg-indigo-100 dark:bg-indigo-900/50',
    iconText: 'text-indigo-600 dark:text-indigo-400',
    tipBg: 'bg-indigo-50 dark:bg-indigo-900/30',
    tipBorder: 'border-indigo-200 dark:border-indigo-800',
    tipText: 'text-indigo-800 dark:text-indigo-200',
    tipLabel: 'text-indigo-600 dark:text-indigo-400'
  },
  purple: {
    iconBg: 'bg-purple-100 dark:bg-purple-900/50',
    iconText: 'text-purple-600 dark:text-purple-400',
    tipBg: 'bg-purple-50 dark:bg-purple-900/30',
    tipBorder: 'border-purple-200 dark:border-purple-800',
    tipText: 'text-purple-800 dark:text-purple-200',
    tipLabel: 'text-purple-600 dark:text-purple-400'
  },
  rose: {
    iconBg: 'bg-rose-100 dark:bg-rose-900/50',
    iconText: 'text-rose-600 dark:text-rose-400',
    tipBg: 'bg-rose-50 dark:bg-rose-900/30',
    tipBorder: 'border-rose-200 dark:border-rose-800',
    tipText: 'text-rose-800 dark:text-rose-200',
    tipLabel: 'text-rose-600 dark:text-rose-400'
  },
  amber: {
    iconBg: 'bg-amber-100 dark:bg-amber-900/50',
    iconText: 'text-amber-600 dark:text-amber-400',
    tipBg: 'bg-amber-50 dark:bg-amber-900/30',
    tipBorder: 'border-amber-200 dark:border-amber-800',
    tipText: 'text-amber-800 dark:text-amber-200',
    tipLabel: 'text-amber-600 dark:text-amber-400'
  }
};

const colors = colorMap[themeColor];

// Icon SVG paths
const iconPaths: Record<UseCase['icon'], string> = {
  'movie': 'M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z',
  'game': 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z',
  'sports': 'M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  'code': 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  'design': 'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z',
  'photo': 'M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z M15 13a3 3 0 11-6 0 3 3 0 016 0z',
  'business': 'M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  'read': 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
  'draw': 'M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z',
  'media': 'M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z',
  'presentation': 'M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z',
  'outdoor': 'M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z',
  'home-theater': 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10'
};
---

<section class="py-12 lg:py-16 bg-gray-50 dark:bg-gray-800/50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100 mb-3">
        {title}
      </h2>
      <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
        {subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {useCases.map((useCase) => (
        <article class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-md transition-shadow">
          <div class="flex items-start gap-4 mb-4">
            <div class={`flex-shrink-0 w-12 h-12 ${colors.iconBg} rounded-xl flex items-center justify-center`}>
              <svg
                class={`w-6 h-6 ${colors.iconText}`}
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d={iconPaths[useCase.icon]}
                />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-gray-900 dark:text-gray-100 text-lg">
                {useCase.title}
              </h3>
              <p class="text-sm text-gray-500 dark:text-gray-400">
                {useCase.audience}
              </p>
            </div>
          </div>

          <ul class="space-y-2 mb-4">
            {useCase.recommendations.map((rec) => (
              <li class="flex items-start gap-2 text-sm text-gray-700 dark:text-gray-300">
                <svg class={`w-4 h-4 ${colors.iconText} flex-shrink-0 mt-0.5`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>{rec}</span>
              </li>
            ))}
          </ul>

          {useCase.proTip && (
            <div class={`${colors.tipBg} ${colors.tipBorder} border rounded-lg p-3 mt-4`}>
              <p class={`text-xs ${colors.tipText}`}>
                <span class={`font-semibold ${colors.tipLabel}`}>Pro Tip:</span> {useCase.proTip}
              </p>
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
