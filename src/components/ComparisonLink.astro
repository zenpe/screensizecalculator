---
/**
 * ComparisonLink - canonical internal comparison link component
 *
 * All internal comparison links should point to /comparison/{slug}.
 */
import { getComparisonLink } from '../utils/url';

interface Props {
  idA: string;
  idB: string;
  class?: string;
}

const { idA, idB, class: className } = Astro.props;
const { href } = getComparisonLink(idA, idB);
---

<a href={href} class={className}>
  <slot />
</a>
