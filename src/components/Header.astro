---
// Header component
import { calculatorLinks, comparisonLinks, deviceLinks, resourceLinks, quickLinks, quickLinkIconMap, siteInfo } from '../config/navigation';
import CategoryIcon from './icons/CategoryIcon.astro';
import QuickLinkIcon from './icons/QuickLinkIcon.astro';
import ChevronIcon from './icons/ChevronIcon.astro';
import ScreenDetector from './ScreenDetector';

const currentPath = Astro.url.pathname;

// Helper to check if a link is active
const isActive = (href: string) => currentPath === href || currentPath.startsWith(href + '/');

const screenCalculators = calculatorLinks.filter(link =>
  ['tv', 'monitor', 'phone', 'tablet', 'projector'].includes(link.icon || '')
);
const utilityTools = calculatorLinks.filter(link =>
  ['ppi', 'aspect-ratio', 'resolution'].includes(link.icon || '')
);
const comparisonCategories = comparisonLinks.filter(link => link.icon !== 'all');
const deviceCategories = deviceLinks.filter(link => link.icon !== 'all');
const guideLinks = resourceLinks.filter(link => link.href !== '/blog');

// Icon color mapping for quick links
const iconColors: Record<string, string> = {
  primary: 'text-primary-500',
  violet: 'text-violet-500',
  amber: 'text-amber-500',
  rose: 'text-rose-500',
};

// Common styles - Desktop
const desktopLinkClass = "flex items-center gap-2 px-2 py-1.5 rounded text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800";
const desktopActiveLinkClass = "flex items-center gap-2 px-2 py-1.5 rounded text-sm text-primary-600 dark:text-primary-400 bg-primary-50 dark:bg-primary-900/20";

// Common styles - Mobile
const mobileCardClass = "flex items-center gap-2 px-3 py-2 bg-gray-50 dark:bg-gray-800 rounded-lg hover:bg-primary-50 dark:hover:bg-primary-900/20 transition-colors border border-gray-200 dark:border-gray-700";
const mobileCardActiveClass = "flex items-center gap-2 px-3 py-2 bg-primary-50 dark:bg-primary-900/30 rounded-lg border border-primary-200 dark:border-primary-700";
const mobileCardTextClass = "text-xs font-medium text-gray-700 dark:text-gray-300";
const mobileCardActiveTextClass = "text-xs font-medium text-primary-700 dark:text-primary-300";
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5" aria-label="Homepage">
        <div class="w-9 h-9 bg-gradient-to-br from-primary-500 to-primary-700 rounded-xl flex items-center justify-center">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24">
            <rect x="3" y="4" width="14" height="9" rx="1.5" fill="#99F6E4"/>
            <rect x="7" y="11" width="14" height="9" rx="1.5" fill="white"/>
            <path d="M1 7V2h5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M23 17v5h-5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="12" cy="12" r="2" fill="white"/>
          </svg>
        </div>
        <span class="hidden sm:block font-bold text-gray-900 dark:text-white">ScreenCalc</span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-1">
        <!-- Calculators -->
        <div class="relative group">
          <button class="px-3 py-2 text-sm font-medium text-gray-700 dark:text-gray-200 hover:text-primary-600 dark:hover:text-primary-400 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 inline-flex items-center gap-1">
            Calculators
            <ChevronIcon direction="down" class="opacity-50" />
          </button>
          <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50">
            <div class="bg-white dark:bg-gray-900 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 p-4 w-[450px]">
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <div class="text-xs font-semibold text-gray-400 uppercase mb-2">Screen Size Calculators</div>
                  {screenCalculators.map(link => (
                    <a href={link.href} class={isActive(link.href) ? desktopActiveLinkClass : desktopLinkClass}>
                      <CategoryIcon icon={link.icon || 'tv'} size="sm" />
                      {link.label}
                    </a>
                  ))}
                </div>
                <div>
                  <div class="text-xs font-semibold text-gray-400 uppercase mb-2">Utility Tools</div>
                  {utilityTools.map(link => (
                    <a href={link.href} class={isActive(link.href) ? desktopActiveLinkClass : desktopLinkClass}>
                      <CategoryIcon icon={link.icon || 'ppi'} size="sm" />
                      {link.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Compare -->
        <div class="relative group">
          <button class="px-3 py-2 text-sm font-medium text-gray-700 dark:text-gray-200 hover:text-primary-600 dark:hover:text-primary-400 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 inline-flex items-center gap-1">
            Compare
            <ChevronIcon direction="down" class="opacity-50" />
          </button>
          <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50">
            <div class="bg-white dark:bg-gray-900 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 p-4 w-64">
              {comparisonCategories.map(link => (
                <a href={link.href} class={isActive(link.href) ? desktopActiveLinkClass : desktopLinkClass}>
                  <CategoryIcon icon={link.icon || 'phone'} size="sm" />
                  {link.label}
                </a>
              ))}
              <div class="border-t border-gray-100 dark:border-gray-800 mt-2 pt-2">
                <a href="/compare" class="flex items-center gap-2 px-2 py-1.5 text-sm text-primary-600 dark:text-primary-400 font-medium">
                  <CategoryIcon icon="compare" size="sm" />
                  Compare Tool
                </a>
                <a href="/comparison" class="flex items-center gap-2 px-2 py-1.5 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400">
                  <CategoryIcon icon="search" size="sm" />
                  Browse All
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Devices -->
        <div class="relative group">
          <button class="px-3 py-2 text-sm font-medium text-gray-700 dark:text-gray-200 hover:text-primary-600 dark:hover:text-primary-400 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 inline-flex items-center gap-1">
            Devices
            <ChevronIcon direction="down" class="opacity-50" />
          </button>
          <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50">
            <div class="bg-white dark:bg-gray-900 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 p-4 w-56">
              {deviceCategories.map(link => (
                <a href={link.href} class={isActive(link.href) ? desktopActiveLinkClass : desktopLinkClass}>
                  <CategoryIcon icon={link.icon || 'phone'} size="sm" />
                  {link.label}
                </a>
              ))}
              <div class="border-t border-gray-100 dark:border-gray-800 mt-2 pt-2">
                <a href="/devices" class="flex items-center gap-2 px-2 py-1.5 text-sm text-primary-600 dark:text-primary-400 font-medium">
                  <CategoryIcon icon="all" size="sm" />
                  All devices
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Resources -->
        <div class="relative group">
          <button class="px-3 py-2 text-sm font-medium text-gray-700 dark:text-gray-200 hover:text-primary-600 dark:hover:text-primary-400 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 inline-flex items-center gap-1">
            Resources
            <ChevronIcon direction="down" class="opacity-50" />
          </button>
          <div class="absolute right-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50">
            <div class="bg-white dark:bg-gray-900 rounded-xl shadow-lg border border-gray-200 dark:border-gray-700 p-4 w-56">
              {guideLinks.map(link => (
                <a href={link.href} class={isActive(link.href) ? desktopActiveLinkClass : desktopLinkClass}>
                  {link.label}
                </a>
              ))}
              <div class="border-t border-gray-100 dark:border-gray-800 mt-2 pt-2">
                <a href="/blog" class="flex items-center gap-2 px-2 py-1.5 text-sm text-primary-600 dark:text-primary-400 font-medium">
                  <CategoryIcon icon="blog" size="sm" />
                  Blog
                </a>
              </div>
            </div>
          </div>
        </div>
      </nav>

      <!-- Right -->
      <div class="flex items-center gap-2">
        <ScreenDetector client:load />
        <button id="theme-toggle" type="button" class="p-2 rounded-lg text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-800" aria-label="Toggle theme">
          <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          <svg class="w-5 h-5 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
        </button>
        <button id="mobile-menu-btn" type="button" class="lg:hidden p-2 rounded-lg text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-800" aria-label="Menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Menu -->
<div id="mobile-menu" class="fixed inset-0 z-50 lg:hidden" style="display: none;">
  <!-- Backdrop -->
  <div id="mobile-backdrop" class="absolute inset-0 bg-gray-900/50"></div>

  <!-- Panel -->
  <div class="absolute inset-y-0 right-0 w-full max-w-sm bg-white dark:bg-gray-900 shadow-xl">
    <!-- Header -->
    <div class="flex items-center justify-between px-4 h-16 border-b border-gray-200 dark:border-gray-800">
      <span class="font-semibold text-gray-900 dark:text-white">Menu</span>
      <button id="mobile-close" type="button" class="p-2 rounded-lg text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-800">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Content -->
    <nav class="p-4 overflow-y-auto" style="max-height: calc(100vh - 64px);">
      <!-- Screen Size Calculators Grid -->
      <div class="mb-4">
        <div class="text-xs font-semibold text-gray-400 uppercase px-1 mb-2">Screen Size Calculators</div>
        <div class="grid grid-cols-2 gap-2">
          {screenCalculators.map((link, index) => (
            <a
              href={link.href}
              class:list={[
                isActive(link.href) ? mobileCardActiveClass : mobileCardClass,
                index === screenCalculators.length - 1 && screenCalculators.length % 2 === 1 ? 'col-span-2 justify-center' : ''
              ]}
            >
              <CategoryIcon icon={link.icon || 'tv'} size="sm" />
              <span class={isActive(link.href) ? mobileCardActiveTextClass : mobileCardTextClass}>{link.shortLabel}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Utility Tools -->
      <div class="mb-4">
        <div class="text-xs font-semibold text-gray-400 uppercase px-1 mb-2">Tools</div>
        <div class="grid grid-cols-2 gap-2">
          {utilityTools.map(link => (
            <a href={link.href} class={isActive(link.href) ? mobileCardActiveClass : mobileCardClass}>
              <CategoryIcon icon={link.icon || 'ppi'} size="sm" />
              <span class={isActive(link.href) ? mobileCardActiveTextClass : mobileCardTextClass}>{link.shortLabel || link.label}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Quick Links -->
      <div class="border-t border-gray-200 dark:border-gray-800 pt-4">
        <div class="space-y-1">
          {quickLinks.map((link, index) => {
            const isFirst = index === 0;
            const iconType = quickLinkIconMap[link.href] || 'chevron';
            const colorClass = iconColors[link.color || 'primary'] || 'text-gray-500';

            return (
              <a
                href={link.href}
                class:list={[
                  'flex items-center justify-between px-3 py-2.5 rounded-lg text-sm transition-colors',
                  isFirst
                    ? 'font-medium bg-primary-50 dark:bg-primary-900/20 text-primary-700 dark:text-primary-300 hover:bg-primary-100 dark:hover:bg-primary-900/30'
                    : 'text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800'
                ]}
              >
                <div class="flex items-center gap-3">
                  <QuickLinkIcon type={iconType} class={colorClass} />
                  <span>{link.label}</span>
                </div>
                <ChevronIcon direction="right" class={isFirst ? 'text-primary-400' : 'text-gray-400'} />
              </a>
            );
          })}
        </div>
      </div>
    </nav>
  </div>
</div>

<script is:inline>
(function() {
  // Theme
  var toggle = document.getElementById('theme-toggle');
  var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  var stored = localStorage.getItem('theme');

  if (stored === 'dark' || (!stored && prefersDark)) {
    document.documentElement.classList.add('dark');
  }

  if (toggle) {
    toggle.onclick = function() {
      document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');
    };
  }

  // Mobile Menu
  var menuBtn = document.getElementById('mobile-menu-btn');
  var closeBtn = document.getElementById('mobile-close');
  var backdrop = document.getElementById('mobile-backdrop');
  var menu = document.getElementById('mobile-menu');

  function openMenu() {
    if (menu) {
      menu.style.display = 'block';
      document.body.style.overflow = 'hidden';
    }
  }

  function closeMenu() {
    if (menu) {
      menu.style.display = 'none';
      document.body.style.overflow = '';
    }
  }

  if (menuBtn) menuBtn.onclick = openMenu;
  if (closeBtn) closeBtn.onclick = closeMenu;
  if (backdrop) backdrop.onclick = closeMenu;

  // Close on link click
  if (menu) {
    var links = menu.querySelectorAll('a');
    for (var i = 0; i < links.length; i++) {
      links[i].onclick = closeMenu;
    }
  }

  // Close on Escape
  document.onkeydown = function(e) {
    if (e.key === 'Escape') closeMenu();
  };
})();
</script>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SiteNavigationElement",
  "name": "Main Navigation",
  "url": `https://${siteInfo.domain}`
})} />
