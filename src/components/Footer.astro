---
// Footer component with comprehensive navigation
import { getComparisonSlug } from '../utils/url';
import { devices } from '../data/devices';
import CategoryIcon from './icons/CategoryIcon.astro';
import {
  calculatorLinks,
  comparisonLinks,
  resourceLinks,
  legalLinks,
  siteInfo
} from '../config/navigation';

const currentYear = new Date().getFullYear();

// --- Dynamic Popular Comparisons ---
const phoneComparisons: Array<{id1: string; id2: string; text: string}> = [];

// 1. Latest iPhone Pro Max vs Previous iPhone Pro Max
const allIphoneProMax = devices.filter(d => d.category === 'phone' && d.id.includes('iphone-') && d.id.includes('-pro-max'));
if (allIphoneProMax.length >= 2) {
  phoneComparisons.push({
    id1: allIphoneProMax[0].id,
    id2: allIphoneProMax[1].id,
    text: `${allIphoneProMax[0].name} vs ${allIphoneProMax[1].name}`
  });
}

// 2. Latest standard iPhone vs Latest Samsung Galaxy S Ultra
const latestIphone = devices.find(d => d.category === 'phone' && d.id.includes('iphone-') && !d.id.includes('-pro') && !d.id.includes('-plus') && !d.id.includes('-mini') && !d.id.includes('-air'));
const latestSamsungUltra = devices.find(d => d.category === 'phone' && d.id.includes('samsung-galaxy-s') && d.id.includes('-ultra'));

if (latestIphone && latestSamsungUltra) {
  phoneComparisons.push({
    id1: latestIphone.id,
    id2: latestSamsungUltra.id,
    text: `${latestIphone.name} vs ${latestSamsungUltra.name}`
  });
}

// Combine and map to final structure
const popularComparisons = [
  phoneComparisons[0],
  { id1: '65-inch-tv', id2: '55-inch-tv', text: '65" vs 55" TV' },
  { id1: '27-inch-monitor', id2: '24-inch-monitor', text: '27" vs 24" Monitor' },
  phoneComparisons[1],
  { id1: '120-inch-projector-screen', id2: '85-inch-tv', text: '120" Projector vs 85" TV' },
  { id1: '75-inch-tv', id2: '65-inch-tv', text: '75" vs 65" TV' },
].filter(Boolean)
.map(({ id1, id2, text }) => ({
  url: `/comparison/${getComparisonSlug(id1, id2)}`,
  text
}));

// Organization Schema for SEO
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": siteInfo.name,
  "url": `https://${siteInfo.domain}`,
  "logo": `https://${siteInfo.domain}/logo.png`,
  "description": siteInfo.description,
  "sameAs": []
};
---

<footer class="bg-gray-900 text-gray-300 mt-auto" role="contentinfo">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Main Footer Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 lg:gap-12">
      <!-- Brand Column -->
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-4 group">
          <div class="w-9 h-9 bg-gradient-to-br from-primary-500 to-primary-700 rounded-xl flex items-center justify-center shadow-lg group-hover:shadow-primary-500/25 transition-shadow">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <span class="font-bold text-white text-lg">{siteInfo.name}</span>
        </a>
        <p class="text-sm text-gray-400 mb-5 leading-relaxed">
          {siteInfo.description}
        </p>
        <!-- Trust badges -->
        <div class="flex flex-wrap gap-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1.5 bg-gray-800/80 rounded-lg text-xs text-gray-300 border border-gray-700/50">
            <svg class="w-3.5 h-3.5 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            Free Forever
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1.5 bg-gray-800/80 rounded-lg text-xs text-gray-300 border border-gray-700/50">
            <svg class="w-3.5 h-3.5 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            No Sign-up
          </span>
        </div>
      </div>

      <!-- Calculators Column -->
      <nav aria-label="Calculator tools">
        <h3 class="font-semibold text-white mb-4 text-sm uppercase tracking-wider">Calculators</h3>
        <ul class="space-y-3">
          {calculatorLinks.slice(0, 6).map(link => (
            <li>
              <a
                href={link.href}
                class="text-sm text-gray-400 hover:text-white transition-colors flex items-center gap-2.5 py-0.5"
              >
                {link.icon && <CategoryIcon icon={link.icon} size="sm" />}
                <span>{link.label}</span>
              </a>
            </li>
          ))}
        </ul>
        <a href="/calculators" class="inline-flex items-center gap-1 mt-4 text-sm text-primary-400 hover:text-primary-300 transition-colors font-medium">
          All Calculators
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </nav>

      <!-- Compare Column -->
      <nav aria-label="Size comparisons">
        <h3 class="font-semibold text-white mb-4 text-sm uppercase tracking-wider">Compare Sizes</h3>
        <ul class="space-y-3">
          {comparisonLinks.slice(1).map(link => (
            <li>
              <a
                href={link.href}
                class="text-sm text-gray-400 hover:text-white transition-colors flex items-center gap-2.5 py-0.5"
              >
                {link.icon && <CategoryIcon icon={link.icon} size="sm" />}
                <span>{link.label}</span>
              </a>
            </li>
          ))}
        </ul>
        <a href="/comparison" class="inline-flex items-center gap-1 mt-4 text-sm text-primary-400 hover:text-primary-300 transition-colors font-medium">
          All Comparisons
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </nav>

      <!-- Resources & Legal Column -->
      <nav aria-label="Resources and legal">
        <h3 class="font-semibold text-white mb-4 text-sm uppercase tracking-wider">Resources</h3>
        <ul class="space-y-3">
          {resourceLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm text-gray-400 hover:text-white transition-colors py-0.5 block">
                {link.label}
              </a>
            </li>
          ))}
        </ul>

        <h3 class="font-semibold text-white mt-6 mb-3 text-sm uppercase tracking-wider">Legal</h3>
        <ul class="space-y-3">
          {legalLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm text-gray-400 hover:text-white transition-colors py-0.5 block">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <!-- Popular Comparisons - SEO Internal Links -->
    <div class="mt-10 pt-8 border-t border-gray-800">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-amber-400">★</span>
        <h3 class="text-sm font-semibold text-white">Popular Comparisons</h3>
      </div>
      <div class="flex flex-wrap gap-2">
        {popularComparisons.map(({ url, text }) => (
          <a
            href={url}
            class="px-3 py-2 bg-gray-800/60 hover:bg-gray-700 border border-gray-700/50 hover:border-gray-600 rounded-lg text-xs text-gray-300 hover:text-white transition-all"
          >
            {text}
          </a>
        ))}
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-gray-800 mt-8 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-sm text-gray-400">
        &copy; {currentYear} {siteInfo.domain}
      </p>

      <!-- Back to Top Button -->
      <button
        id="back-to-top"
        type="button"
        class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 text-xs text-gray-400 hover:text-white bg-gray-800 hover:bg-gray-700 rounded-lg transition-colors"
        aria-label="Back to top"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
        </svg>
        Back to Top
      </button>
    </div>
  </div>

  <!-- Organization Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

  <!-- Back to Top Script -->
  <script>
    const backToTopBtn = document.getElementById('back-to-top');
    backToTopBtn?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  </script>
</footer>
