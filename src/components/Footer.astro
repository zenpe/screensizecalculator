---
// Footer component with comprehensive navigation
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 text-gray-300 mt-auto">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Main Footer Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 lg:gap-12">
      <!-- Brand Column -->
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-4">
          <div class="w-8 h-8 bg-primary-600 rounded-lg flex items-center justify-center shadow-sm">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <span class="font-semibold text-white">ScreenSizeCalculator</span>
        </a>
        <p class="text-sm text-gray-400 mb-4 leading-relaxed">
          Free online tools to calculate screen dimensions, viewing distances, PPI, and compare display sizes for TVs, monitors, phones, and projectors.
        </p>
        <!-- Trust badges / highlights -->
        <div class="flex flex-wrap gap-2">
          <span class="inline-flex items-center gap-1 px-2 py-1 bg-gray-800 rounded text-xs text-gray-400">
            <svg class="w-3 h-3 text-green-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            Free Forever
          </span>
          <span class="inline-flex items-center gap-1 px-2 py-1 bg-gray-800 rounded text-xs text-gray-400">
            <svg class="w-3 h-3 text-green-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            No Sign-up
          </span>
        </div>
      </div>

      <!-- Calculators Column -->
      <div>
        <h3 class="font-semibold text-white mb-4 text-sm uppercase tracking-wider">Calculators</h3>
        <ul class="space-y-2.5">
          <li>
            <a href="/tv-screen-size-calculator" class="text-sm text-gray-400 hover:text-primary-400 transition-colors flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
              TV Screen Size
            </a>
          </li>
          <li>
            <a href="/monitor-screen-size-calculator" class="text-sm text-gray-400 hover:text-primary-400 transition-colors flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-purple-500"></span>
              Monitor Size
            </a>
          </li>
          <li>
            <a href="/phone-screen-size-calculator" class="text-sm text-gray-400 hover:text-primary-400 transition-colors flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
              Phone Screen Size
            </a>
          </li>
          <li>
            <a href="/projector-screen-size-calculator" class="text-sm text-gray-400 hover:text-primary-400 transition-colors flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
              Projector Size
            </a>
          </li>
        </ul>
      </div>

      <!-- Compare Column -->
      <div>
        <h3 class="font-semibold text-white mb-4 text-sm uppercase tracking-wider">Compare Sizes</h3>
        <ul class="space-y-2.5">
          <li>
            <a href="/comparison" class="text-sm text-gray-400 hover:text-primary-400 transition-colors">
              All Comparisons
            </a>
          </li>
          <li>
            <a href="/comparison/phones" class="text-sm text-gray-400 hover:text-primary-400 transition-colors">
              Phone Comparisons
            </a>
          </li>
          <li>
            <a href="/comparison/tvs" class="text-sm text-gray-400 hover:text-primary-400 transition-colors">
              TV Comparisons
            </a>
          </li>
          <li>
            <a href="/comparison/monitors" class="text-sm text-gray-400 hover:text-primary-400 transition-colors">
              Monitor Comparisons
            </a>
          </li>
          <li>
            <a href="/comparison/projectors" class="text-sm text-gray-400 hover:text-primary-400 transition-colors">
              Projector Comparisons
            </a>
          </li>
        </ul>
      </div>

      <!-- Resources & Company Column -->
      <div>
        <h3 class="font-semibold text-white mb-4 text-sm uppercase tracking-wider">Resources</h3>
        <ul class="space-y-2.5">
          <li>
            <a href="/resources/common-screen-sizes" class="text-sm text-gray-400 hover:text-primary-400 transition-colors">
              Common Screen Sizes
            </a>
          </li>
          <li>
            <a href="/resources/aspect-ratio-guide" class="text-sm text-gray-400 hover:text-primary-400 transition-colors">
              Aspect Ratio Guide
            </a>
          </li>
          <li>
            <a href="/resources/ppi-explained" class="text-sm text-gray-400 hover:text-primary-400 transition-colors">
              PPI Explained
            </a>
          </li>
          <li>
            <a href="/blog" class="text-sm text-gray-400 hover:text-primary-400 transition-colors">
              Blog
            </a>
          </li>
        </ul>

        <!-- Legal links -->
        <h3 class="font-semibold text-white mt-6 mb-3 text-sm uppercase tracking-wider">Legal</h3>
        <ul class="space-y-2.5">
          <li>
            <a href="/privacy" class="text-sm text-gray-400 hover:text-primary-400 transition-colors">
              Privacy Policy
            </a>
          </li>
          <li>
            <a href="/terms" class="text-sm text-gray-400 hover:text-primary-400 transition-colors">
              Terms of Use
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Popular Comparisons - SEO Internal Links -->
    <div class="mt-10 pt-8 border-t border-gray-800">
      <h3 class="text-sm font-semibold text-white mb-4">Popular Comparisons</h3>
      <div class="flex flex-wrap gap-2">
        <a href="/comparison/iphone-16-pro-max-vs-iphone-15-pro-max" class="px-3 py-1.5 bg-gray-800 hover:bg-gray-700 rounded-lg text-xs text-gray-400 hover:text-white transition-colors">
          iPhone 16 Pro Max vs 15 Pro Max
        </a>
        <a href="/comparison/65-inch-tv-vs-55-inch-tv" class="px-3 py-1.5 bg-gray-800 hover:bg-gray-700 rounded-lg text-xs text-gray-400 hover:text-white transition-colors">
          65" vs 55" TV
        </a>
        <a href="/comparison/27-inch-monitor-vs-24-inch-monitor" class="px-3 py-1.5 bg-gray-800 hover:bg-gray-700 rounded-lg text-xs text-gray-400 hover:text-white transition-colors">
          27" vs 24" Monitor
        </a>
        <a href="/comparison/iphone-16-vs-samsung-galaxy-s24" class="px-3 py-1.5 bg-gray-800 hover:bg-gray-700 rounded-lg text-xs text-gray-400 hover:text-white transition-colors">
          iPhone 16 vs Galaxy S24
        </a>
        <a href="/comparison/120-inch-projector-screen-vs-85-inch-tv" class="px-3 py-1.5 bg-gray-800 hover:bg-gray-700 rounded-lg text-xs text-gray-400 hover:text-white transition-colors">
          120" Projector vs 85" TV
        </a>
        <a href="/comparison/75-inch-tv-vs-65-inch-tv" class="px-3 py-1.5 bg-gray-800 hover:bg-gray-700 rounded-lg text-xs text-gray-400 hover:text-white transition-colors">
          75" vs 65" TV
        </a>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-gray-800 mt-8 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-sm text-gray-500">
        &copy; {currentYear} ScreenSizeCalculators.com. All rights reserved.
      </p>
      <p class="text-xs text-gray-600">
        Made with precision for screen enthusiasts worldwide.
      </p>
    </div>
  </div>
</footer>
